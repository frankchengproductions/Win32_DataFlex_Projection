	Define DSPROPERTY_DIRECTSOUNDDEVICE_ENUMERATE_1			For 3
	Define DSPROPERTY_DIRECTSOUNDDEVICE_WAVEDEVICEMAPPING_W	For 4
	Define DSPROPERTY_DIRECTSOUNDDEVICE_DESCRIPTION_A		For 5
	Define DSPROPERTY_DIRECTSOUNDDEVICE_DESCRIPTION_W		For 6
	Define DSPROPERTY_DIRECTSOUNDDEVICE_ENUMERATE_A			For 7
	Define DSPROPERTY_DIRECTSOUNDDEVICE_ENUMERATE_W			For 8
End_Enum_List

// Define DIRECTSOUNDDEVICE_TYPE For Integer
Enum_List
	Define DIRECTSOUNDDEVICE_TYPE_EMULATED					For 0
	Define DIRECTSOUNDDEVICE_TYPE_VXD						For 1
	Define DIRECTSOUNDDEVICE_TYPE_WDM						For 2
End_Enum_List

// Define DIRECTSOUNDDEVICE_DATAFLOW For Integer
