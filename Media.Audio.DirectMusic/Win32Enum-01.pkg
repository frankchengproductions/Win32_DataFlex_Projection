Use UI

// Define DMUS_CLOCKTYPE For Integer
Enum_List
	Define DMUS_CLOCK_SYSTEM								For |CI$00000000
	Define DMUS_CLOCK_WAVE									For |CI$00000001
End_Enum_List

// Define DSPROPERTY_DIRECTSOUNDDEVICE For Integer
Enum_List
	Define DSPROPERTY_DIRECTSOUNDDEVICE_WAVEDEVICEMAPPING_A	For |CI$00000001
	Define DSPROPERTY_DIRECTSOUNDDEVICE_DESCRIPTION_1		For |CI$00000002
	Define DSPROPERTY_DIRECTSOUNDDEVICE_ENUMERATE_1			For |CI$00000003
	Define DSPROPERTY_DIRECTSOUNDDEVICE_WAVEDEVICEMAPPING_W	For |CI$00000004
	Define DSPROPERTY_DIRECTSOUNDDEVICE_DESCRIPTION_A		For |CI$00000005
	Define DSPROPERTY_DIRECTSOUNDDEVICE_DESCRIPTION_W		For |CI$00000006
	Define DSPROPERTY_DIRECTSOUNDDEVICE_ENUMERATE_A			For |CI$00000007
	Define DSPROPERTY_DIRECTSOUNDDEVICE_ENUMERATE_W			For |CI$00000008
End_Enum_List

// Define DIRECTSOUNDDEVICE_TYPE For Integer
Enum_List
	Define DIRECTSOUNDDEVICE_TYPE_EMULATED					For |CI$00000000
	Define DIRECTSOUNDDEVICE_TYPE_VXD						For |CI$00000001
	Define DIRECTSOUNDDEVICE_TYPE_WDM						For |CI$00000002
End_Enum_List

// Define DIRECTSOUNDDEVICE_DATAFLOW For Integer
Enum_List
