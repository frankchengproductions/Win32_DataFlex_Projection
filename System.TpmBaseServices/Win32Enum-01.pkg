Use UI

// Define TBS_COMMAND_PRIORITY For UInteger
Enum_List
	Define TBS_COMMAND_PRIORITY_LOW							For |CI$00000064
	Define TBS_COMMAND_PRIORITY_NORMAL						For |CI$000000C8
	Define TBS_COMMAND_PRIORITY_HIGH						For |CI$0000012C
	Define TBS_COMMAND_PRIORITY_SYSTEM						For |CI$00000190
	Define TBS_COMMAND_PRIORITY_MAX							For |CV$80000000
End_Enum_List

// Define TBS_COMMAND_LOCALITY For UInteger
Enum_List
	Define TBS_COMMAND_LOCALITY_ZERO						For |CI$00000000
	Define TBS_COMMAND_LOCALITY_ONE							For |CI$00000001
	Define TBS_COMMAND_LOCALITY_TWO							For |CI$00000002
	Define TBS_COMMAND_LOCALITY_THREE						For |CI$00000003
	Define TBS_COMMAND_LOCALITY_FOUR						For |CI$00000004
End_Enum_List


Procedure DataFlex_Init
End_Procedure

