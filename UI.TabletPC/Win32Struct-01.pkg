	UInteger ulPropertyCount
	Integer iMissingAlignment2
	Pointer pGuidProperties									// Guid*
	UInteger ulBestResultColumnCount
	Integer iMissingAlignment3
	Pointer pulBestResultColumns							// UInteger*
	Pointer pulBestResultIndexes							// UInteger*
End_Struct

// https://learn.microsoft.com/windows/win32/api/rectypes/ns-rectypes-reco_lattice_column
Struct RECO_LATTICE_COLUMN
	UInteger key
