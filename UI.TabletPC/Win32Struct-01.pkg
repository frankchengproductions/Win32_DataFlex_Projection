	UInteger cStrokes
	Integer iMissingAlignment2
	Pointer pStrokes										// UInteger*
	UInteger cLatticeElements
	Integer iMissingAlignment3
	Pointer pLatticeElements								// RECO_LATTICE_ELEMENT*
End_Struct

// https://learn.microsoft.com/windows/win32/api/rectypes/ns-rectypes-reco_lattice_element
