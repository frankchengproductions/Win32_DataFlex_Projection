Struct PACKET_DESCRIPTION
	UInteger cbPacketSize
	UInteger cPacketProperties
	Pointer pPacketProperties								// PACKET_PROPERTY*
	UInteger cButtons
	Integer iMissingAlignment1
	Pointer pguidButtons									// Guid*
End_Struct

// https://learn.microsoft.com/windows/win32/api/tpcshrd/ns-tpcshrd-packet_property
Struct PACKET_PROPERTY
	Guid guid
	PROPERTY_METRICS PropertyMetrics
End_Struct

