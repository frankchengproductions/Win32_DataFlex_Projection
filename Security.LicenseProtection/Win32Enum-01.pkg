Use UI

// Define LicenseProtectionStatus For Integer
Enum_List
	Define Success											For |CI$00000000
	Define LicenseKeyNotFound								For |CI$00000001
	Define LicenseKeyUnprotected							For |CI$00000002
	Define LicenseKeyCorrupted								For |CI$00000003
	Define LicenseKeyAlreadyExists							For |CI$00000004
End_Enum_List


Procedure DataFlex_Init
End_Procedure

