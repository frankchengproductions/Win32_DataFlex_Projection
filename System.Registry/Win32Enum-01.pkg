Use UI

// Define REG_VALUE_TYPE For UInteger
Enum_List
	Define REG_NONE											For |CI$00000000
	Define REG_SZ											For |CI$00000001
	Define REG_EXPAND_SZ									For |CI$00000002
	Define REG_BINARY										For |CI$00000003
	Define REG_DWORD										For |CI$00000004
	Define REG_DWORD_LITTLE_ENDIAN							For |CI$00000004
	Define REG_DWORD_BIG_ENDIAN								For |CI$00000005
	Define REG_LINK											For |CI$00000006
	Define REG_MULTI_SZ										For |CI$00000007
	Define REG_RESOURCE_LIST								For |CI$00000008
	Define REG_FULL_RESOURCE_DESCRIPTOR						For |CI$00000009
	Define REG_RESOURCE_REQUIREMENTS_LIST					For |CI$0000000A
	Define REG_QWORD										For |CI$0000000B
	Define REG_QWORD_LITTLE_ENDIAN							For |CI$0000000B
End_Enum_List

// Define REG_OPEN_CREATE_OPTIONS For UInteger
Enum_List
	Define REG_OPTION_RESERVED								For |CI$00000000
	Define REG_OPTION_NON_VOLATILE							For |CI$00000000
	Define REG_OPTION_VOLATILE								For |CI$00000001
	Define REG_OPTION_CREATE_LINK							For |CI$00000002
	Define REG_OPTION_BACKUP_RESTORE						For |CI$00000004
	Define REG_OPTION_OPEN_LINK								For |CI$00000008
	Define REG_OPTION_DONT_VIRTUALIZE						For |CI$00000010
End_Enum_List

// Define REG_SAM_FLAGS For UInteger
Enum_List
	Define KEY_QUERY_VALUE									For |CI$00000001
	Define KEY_SET_VALUE									For |CI$00000002
	Define KEY_CREATE_SUB_KEY								For |CI$00000004
	Define KEY_ENUMERATE_SUB_KEYS							For |CI$00000008
	Define KEY_NOTIFY										For |CI$00000010
	Define KEY_CREATE_LINK									For |CI$00000020
	Define KEY_WOW64_64KEY									For |CI$00000100
	Define KEY_WOW64_32KEY									For |CI$00000200
	Define KEY_WOW64_RES									For |CI$00000300
	Define KEY_WRITE										For |CI$00020006
	Define KEY_READ											For |CI$00020019
	Define KEY_EXECUTE										For |CI$00020019
	Define KEY_ALL_ACCESS									For |CI$000F003F
End_Enum_List

// Define REG_CREATE_KEY_DISPOSITION For UInteger
Enum_List
	Define REG_CREATED_NEW_KEY								For |CI$00000001
	Define REG_OPENED_EXISTING_KEY							For |CI$00000002
End_Enum_List

// Define REG_NOTIFY_FILTER For UInteger
Enum_List
	Define REG_NOTIFY_CHANGE_NAME							For |CI$00000001
	Define REG_NOTIFY_CHANGE_ATTRIBUTES						For |CI$00000002
	Define REG_NOTIFY_CHANGE_LAST_SET						For |CI$00000004
	Define REG_NOTIFY_CHANGE_SECURITY						For |CI$00000008
	Define REG_NOTIFY_THREAD_AGNOSTIC						For |CI$10000000
End_Enum_List

// Define REG_ROUTINE_FLAGS For UInteger
Enum_List
	Define RRF_RT_REG_NONE									For |CI$00000001
	Define RRF_RT_REG_SZ									For |CI$00000002
	Define RRF_RT_REG_EXPAND_SZ								For |CI$00000004
	Define RRF_RT_REG_BINARY								For |CI$00000008
	Define RRF_RT_REG_DWORD									For |CI$00000010
	Define RRF_RT_DWORD										For |CI$00000018
	Define RRF_RT_REG_MULTI_SZ								For |CI$00000020
	Define RRF_RT_REG_QWORD									For |CI$00000040
	Define RRF_RT_QWORD										For |CI$00000048
	Define RRF_RT_ANY										For |CI$0000FFFF
	Define RRF_SUBKEY_WOW6464KEY							For |CI$00010000
	Define RRF_SUBKEY_WOW6432KEY							For |CI$00020000
	Define RRF_WOW64_MASK									For |CI$00030000
	Define RRF_NOEXPAND										For |CI$10000000
	Define RRF_ZEROONFAILURE								For |CI$20000000
End_Enum_List

// Define REG_SAVE_FORMAT For UInteger
Enum_List
	Define REG_STANDARD_FORMAT								For |CI$00000001
	Define REG_LATEST_FORMAT								For |CI$00000002
