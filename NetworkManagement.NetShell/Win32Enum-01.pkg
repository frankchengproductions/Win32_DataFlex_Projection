Use UI

// Define NS_CMD_FLAGS For Integer
Enum_List
	Define CMD_FLAG_PRIVATE									For 1
	Define CMD_FLAG_INTERACTIVE								For 2
	Define CMD_FLAG_LOCAL									For 8
	Define CMD_FLAG_ONLINE									For 16
	Define CMD_FLAG_HIDDEN									For 32
	Define CMD_FLAG_LIMIT_MASK								For 65535
	Define CMD_FLAG_PRIORITY								For -2147483648
End_Enum_List

// Define NS_REQS For Integer
Enum_List
	Define NS_REQ_ZERO										For 0
	Define NS_REQ_PRESENT									For 1
	Define NS_REQ_ALLOW_MULTIPLE							For 2
	Define NS_REQ_ONE_OR_MORE								For 3
End_Enum_List

// Define NS_EVENTS For Integer
Enum_List
	Define NS_EVENT_LOOP									For 65536
	Define NS_EVENT_LAST_N									For 1
	Define NS_EVENT_LAST_SECS								For 2
	Define NS_EVENT_FROM_N									For 4
	Define NS_EVENT_FROM_START								For 8
End_Enum_List

// Define NS_MODE_CHANGE For Integer
Enum_List
	Define NETSH_COMMIT										For 0
	Define NETSH_UNCOMMIT									For 1
	Define NETSH_FLUSH										For 2
	Define NETSH_COMMIT_STATE								For 3
	Define NETSH_SAVE										For 4
End_Enum_List


Procedure DataFlex_Init
End_Procedure

