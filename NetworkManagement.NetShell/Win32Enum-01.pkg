Use UI

// Define NS_CMD_FLAGS For Integer
Enum_List
	Define CMD_FLAG_PRIORITY								For -2147483648
	Define CMD_FLAG_PRIVATE									For |CI$00000001
	Define CMD_FLAG_INTERACTIVE								For |CI$00000002
	Define CMD_FLAG_LOCAL									For |CI$00000008
	Define CMD_FLAG_ONLINE									For |CI$00000010
	Define CMD_FLAG_HIDDEN									For |CI$00000020
	Define CMD_FLAG_LIMIT_MASK								For |CI$0000FFFF
End_Enum_List

// Define NS_REQS For Integer
Enum_List
	Define NS_REQ_ZERO										For |CI$00000000
	Define NS_REQ_PRESENT									For |CI$00000001
	Define NS_REQ_ALLOW_MULTIPLE							For |CI$00000002
	Define NS_REQ_ONE_OR_MORE								For |CI$00000003
End_Enum_List

// Define NS_EVENTS For Integer
Enum_List
	Define NS_EVENT_LAST_N									For |CI$00000001
	Define NS_EVENT_LAST_SECS								For |CI$00000002
	Define NS_EVENT_FROM_N									For |CI$00000004
	Define NS_EVENT_FROM_START								For |CI$00000008
	Define NS_EVENT_LOOP									For |CI$00010000
End_Enum_List

// Define NS_MODE_CHANGE For Integer
Enum_List
	Define NETSH_COMMIT										For |CI$00000000
	Define NETSH_UNCOMMIT									For |CI$00000001
	Define NETSH_FLUSH										For |CI$00000002
	Define NETSH_COMMIT_STATE								For |CI$00000003
	Define NETSH_SAVE										For |CI$00000004
End_Enum_List


Procedure DataFlex_Init
End_Procedure

