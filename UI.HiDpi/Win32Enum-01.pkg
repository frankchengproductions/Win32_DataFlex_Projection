	Define DCDC_DISABLE_RELAYOUT							For |CI$00000002
End_Enum_List

// Define DIALOG_DPI_CHANGE_BEHAVIORS For Integer
Enum_List
	Define DDC_DEFAULT										For |CI$00000000
	Define DDC_DISABLE_ALL									For |CI$00000001
	Define DDC_DISABLE_RESIZE								For |CI$00000002
	Define DDC_DISABLE_CONTROL_RELAYOUT						For |CI$00000004
End_Enum_List

// Define DPI_AWARENESS For Integer
Enum_List
	Define DPI_AWARENESS_INVALID							For -1
