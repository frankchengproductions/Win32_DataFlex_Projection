	Define DCDC_DISABLE_FONT_UPDATE							For 1
	Define DCDC_DISABLE_RELAYOUT							For 2
End_Enum_List

// Define DIALOG_DPI_CHANGE_BEHAVIORS For Integer
Enum_List
	Define DDC_DEFAULT										For 0
	Define DDC_DISABLE_ALL									For 1
	Define DDC_DISABLE_RESIZE								For 2
	Define DDC_DISABLE_CONTROL_RELAYOUT						For 4
End_Enum_List

// Define DPI_AWARENESS For Integer
Enum_List
	Define DPI_AWARENESS_INVALID							For -1
	Define DPI_AWARENESS_UNAWARE							For 0
	Define DPI_AWARENESS_SYSTEM_AWARE						For 1
	Define DPI_AWARENESS_PER_MONITOR_AWARE					For 2
End_Enum_List

// Define DPI_HOSTING_BEHAVIOR For Integer
Enum_List
	Define DPI_HOSTING_BEHAVIOR_INVALID						For -1
	Define DPI_HOSTING_BEHAVIOR_DEFAULT						For 0
	Define DPI_HOSTING_BEHAVIOR_MIXED						For 1
End_Enum_List

// Define PROCESS_DPI_AWARENESS For Integer
Enum_List
	Define PROCESS_DPI_UNAWARE								For 0
	Define PROCESS_SYSTEM_DPI_AWARE							For 1
	Define PROCESS_PER_MONITOR_DPI_AWARE					For 2
End_Enum_List

// Define MONITOR_DPI_TYPE For Integer
Enum_List
	Define MDT_EFFECTIVE_DPI								For 0
	Define MDT_ANGULAR_DPI									For 1
	Define MDT_RAW_DPI										For 2
