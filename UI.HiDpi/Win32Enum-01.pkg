	Define DPI_HOSTING_BEHAVIOR_MIXED						For |CI$00000001
End_Enum_List

// Define PROCESS_DPI_AWARENESS For Integer
Enum_List
	Define PROCESS_DPI_UNAWARE								For |CI$00000000
	Define PROCESS_SYSTEM_DPI_AWARE							For |CI$00000001
	Define PROCESS_PER_MONITOR_DPI_AWARE					For |CI$00000002
End_Enum_List

// Define MONITOR_DPI_TYPE For Integer
Enum_List
	Define MDT_EFFECTIVE_DPI								For |CI$00000000
