Use UI

// Define HCN_NOTIFICATIONS For Integer
Enum_List
	Define HcnNotificationFlagsReserved						For -268435456
	Define HcnNotificationInvalid							For |CI$00000000
	Define HcnNotificationNetworkPreCreate					For |CI$00000001
	Define HcnNotificationNetworkCreate						For |CI$00000002
	Define HcnNotificationNetworkPreDelete					For |CI$00000003
	Define HcnNotificationNetworkDelete						For |CI$00000004
	Define HcnNotificationNamespaceCreate					For |CI$00000005
	Define HcnNotificationNamespaceDelete					For |CI$00000006
	Define HcnNotificationGuestNetworkServiceCreate			For |CI$00000007
	Define HcnNotificationGuestNetworkServiceDelete			For |CI$00000008
	Define HcnNotificationNetworkEndpointAttached			For |CI$00000009
	Define HcnNotificationNetworkEndpointDetached			For |CI$00000010
	Define HcnNotificationGuestNetworkServiceStateChanged	For |CI$00000011
	Define HcnNotificationGuestNetworkServiceInterfaceStateChanged	For |CI$00000012
	Define HcnNotificationServiceDisconnect					For |CI$01000000
End_Enum_List

// Define HCN_PORT_PROTOCOL For Integer
Enum_List
	Define HCN_PORT_PROTOCOL_TCP							For |CI$00000001
	Define HCN_PORT_PROTOCOL_UDP							For |CI$00000002
	Define HCN_PORT_PROTOCOL_BOTH							For |CI$00000003
End_Enum_List

// Define HCN_PORT_ACCESS For Integer
Enum_List
	Define HCN_PORT_ACCESS_EXCLUSIVE						For |CI$00000001
	Define HCN_PORT_ACCESS_SHARED							For |CI$00000002
End_Enum_List


Procedure DataFlex_Init
End_Procedure

