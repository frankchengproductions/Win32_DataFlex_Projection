Use UI

// Define HCN_NOTIFICATIONS For Integer
Enum_List
	Define HcnNotificationInvalid							For 0
	Define HcnNotificationNetworkPreCreate					For 1
	Define HcnNotificationNetworkCreate						For 2
	Define HcnNotificationNetworkPreDelete					For 3
	Define HcnNotificationNetworkDelete						For 4
	Define HcnNotificationNamespaceCreate					For 5
	Define HcnNotificationNamespaceDelete					For 6
	Define HcnNotificationGuestNetworkServiceCreate			For 7
	Define HcnNotificationGuestNetworkServiceDelete			For 8
	Define HcnNotificationNetworkEndpointAttached			For 9
	Define HcnNotificationNetworkEndpointDetached			For 16
	Define HcnNotificationGuestNetworkServiceStateChanged	For 17
	Define HcnNotificationGuestNetworkServiceInterfaceStateChanged	For 18
	Define HcnNotificationServiceDisconnect					For 16777216
	Define HcnNotificationFlagsReserved						For -268435456
End_Enum_List

// Define HCN_PORT_PROTOCOL For Integer
Enum_List
	Define HCN_PORT_PROTOCOL_TCP							For 1
	Define HCN_PORT_PROTOCOL_UDP							For 2
	Define HCN_PORT_PROTOCOL_BOTH							For 3
End_Enum_List

// Define HCN_PORT_ACCESS For Integer
Enum_List
	Define HCN_PORT_ACCESS_EXCLUSIVE						For 1
	Define HCN_PORT_ACCESS_SHARED							For 2
End_Enum_List


Procedure DataFlex_Init
End_Procedure

