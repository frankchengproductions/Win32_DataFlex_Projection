Use UI

// Define QOS_TRAFFIC_TYPE For Integer
Enum_List
	Define QOSTrafficTypeBestEffort							For 0
	Define QOSTrafficTypeBackground							For 1
	Define QOSTrafficTypeExcellentEffort					For 2
	Define QOSTrafficTypeAudioVideo							For 3
	Define QOSTrafficTypeVoice								For 4
	Define QOSTrafficTypeControl							For 5
End_Enum_List

// Define QOS_SET_FLOW For Integer
Enum_List
	Define QOSSetTrafficType								For 0
	Define QOSSetOutgoingRate								For 1
	Define QOSSetOutgoingDSCPValue							For 2
End_Enum_List

// Define QOS_QUERY_FLOW For Integer
Enum_List
	Define QOSQueryFlowFundamentals							For 0
	Define QOSQueryPacketPriority							For 1
	Define QOSQueryOutgoingRate								For 2
End_Enum_List

// Define QOS_NOTIFY_FLOW For Integer
Enum_List
	Define QOSNotifyCongested								For 0
	Define QOSNotifyUncongested								For 1
	Define QOSNotifyAvailable								For 2
End_Enum_List

// Define QOS_FLOWRATE_REASON For Integer
Enum_List
	Define QOSFlowRateNotApplicable							For 0
	Define QOSFlowRateContentChange							For 1
	Define QOSFlowRateCongestion							For 2
	Define QOSFlowRateHigherContentEncoding					For 3
	Define QOSFlowRateUserCaused							For 4
End_Enum_List

// Define QOS_SHAPING For Integer
Enum_List
	Define QOSShapeOnly										For 0
	Define QOSShapeAndMark									For 1
	Define QOSUseNonConformantMarkings						For 2
End_Enum_List

// Define FilterType For Integer
Enum_List
	Define FILTERSPECV4										For 1
	Define FILTERSPECV6										For 2
	Define FILTERSPECV6_FLOW								For 3
	Define FILTERSPECV4_GPI									For 4
	Define FILTERSPECV6_GPI									For 5
	Define FILTERSPEC_END									For 6
End_Enum_List


Procedure DataFlex_Init
End_Procedure

