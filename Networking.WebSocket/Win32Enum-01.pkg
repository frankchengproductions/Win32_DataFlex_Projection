	Define WEB_SOCKET_RECEIVE_ACTION_QUEUE					For 2
	Define WEB_SOCKET_ALL_ACTION_QUEUE						For 3
End_Enum_List

// Define WEB_SOCKET_ACTION For Integer
Enum_List
	Define WEB_SOCKET_NO_ACTION								For 0
