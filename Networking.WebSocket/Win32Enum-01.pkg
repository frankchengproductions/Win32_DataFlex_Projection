	Define WEB_SOCKET_INDICATE_SEND_COMPLETE_ACTION			For 2
	Define WEB_SOCKET_RECEIVE_FROM_NETWORK_ACTION			For 3
	Define WEB_SOCKET_INDICATE_RECEIVE_COMPLETE_ACTION		For 4
End_Enum_List

// Define WEB_SOCKET_CLOSE_STATUS For Integer
