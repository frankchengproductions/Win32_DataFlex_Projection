	Define WEB_SOCKET_SEND_BUFFER_SIZE_PROPERTY_TYPE		For 1
	Define WEB_SOCKET_DISABLE_MASKING_PROPERTY_TYPE			For 2
	Define WEB_SOCKET_ALLOCATED_BUFFER_PROPERTY_TYPE		For 3
	Define WEB_SOCKET_DISABLE_UTF8_VERIFICATION_PROPERTY_TYPE	For 4
	Define WEB_SOCKET_KEEPALIVE_INTERVAL_PROPERTY_TYPE		For 5
	Define WEB_SOCKET_SUPPORTED_VERSIONS_PROPERTY_TYPE		For 6
End_Enum_List

// Define WEB_SOCKET_BUFFER_TYPE For Integer
Enum_List
	Define WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE				For -2147483648
	Define WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE				For -2147483647
	Define WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE			For -2147483646
	Define WEB_SOCKET_BINARY_FRAGMENT_BUFFER_TYPE			For -2147483645
