	Define WEB_SOCKET_INVALID_PAYLOAD_CLOSE_STATUS			For 1007
	Define WEB_SOCKET_POLICY_VIOLATION_CLOSE_STATUS			For 1008
	Define WEB_SOCKET_MESSAGE_TOO_BIG_CLOSE_STATUS			For 1009
	Define WEB_SOCKET_UNSUPPORTED_EXTENSIONS_CLOSE_STATUS	For 1010
	Define WEB_SOCKET_SERVER_ERROR_CLOSE_STATUS				For 1011
	Define WEB_SOCKET_SECURE_HANDSHAKE_ERROR_CLOSE_STATUS	For 1015
