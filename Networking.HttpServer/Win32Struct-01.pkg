	UShort ConnectionKeySize
	UInteger ServerCertIssuerSize
	UInteger ServerCertSubjectSize
	Integer iMissingAlignment1
	Pointer pServerCertIssuer								// PSTR
	Pointer pServerCertSubject								// PSTR
	Pointer pClientCertInfo									// HTTP_SSL_CLIENT_CERT_INFO*
	UInteger SslClientCertNegotiated
	Integer iMissingAlignment2
End_Struct

Struct HTTP_SSL_PROTOCOL_INFO
	UInteger Protocol
	UInteger CipherType
	UInteger CipherStrength
	UInteger HashType
	UInteger HashStrength
	UInteger KeyExchangeType
	UInteger KeyExchangeStrength
End_Struct

// https://learn.microsoft.com/windows/win32/api/http/ns-http-http_state_info
Struct HTTP_STATE_INFO
	HTTP_PROPERTY_FLAGS Flags
	Integer State											// HTTP_ENABLED_STATE
End_Struct

// https://learn.microsoft.com/windows/win32/api/http/ns-http-http_timeout_limit_info
Struct HTTP_TIMEOUT_LIMIT_INFO
	HTTP_PROPERTY_FLAGS Flags
	UShort EntityBody
	UShort DrainEntityBody
	UShort RequestQueue
	UShort IdleConnection
	UShort HeaderWait
	Short iMissingAlignment1
	UInteger MinSendRate
End_Struct

Struct HTTP_TLS_RESTRICTIONS_PARAM
	UInteger RestrictionCount
	Integer iMissingAlignment1
	Pointer TlsRestrictions									// Pointer*
End_Struct

Struct HTTP_TLS_SESSION_TICKET_KEYS_PARAM
	UInteger SessionTicketKeyCount
	Integer iMissingAlignment1
	Pointer SessionTicketKeys								// Pointer*
End_Struct

// https://learn.microsoft.com/windows/win32/api/http/ns-http-http_transport_address
Struct HTTP_TRANSPORT_ADDRESS
	Pointer pRemoteAddress									// SOCKADDR*
	Pointer pLocalAddress									// SOCKADDR*
End_Struct

// https://learn.microsoft.com/windows/win32/api/http/ns-http-http_unknown_header
Struct HTTP_UNKNOWN_HEADER
	UShort NameLength
	UShort RawValueLength
	Integer iMissingAlignment1
	Pointer pName											// PSTR
	Pointer pRawValue										// PSTR
End_Struct

// https://learn.microsoft.com/windows/win32/api/http/ns-http-http_version
Struct HTTP_VERSION
	UShort MajorVersion
	UShort MinorVersion
End_Struct

Struct HTTP_WINHTTP_FAST_FORWARDING_DATA
	UChar[16] Reserved
End_Struct

Struct HTTP_WSK_API_TIMINGS
	UBigint ConnectCount
	UBigint ConnectSum
	UBigint DisconnectCount
	UBigint DisconnectSum
	UBigint SendCount
	UBigint SendSum
	UBigint ReceiveCount
	UBigint ReceiveSum
	UBigint ReleaseCount
	UBigint ReleaseSum
	UBigint ControlSocketCount
	UBigint ControlSocketSum
End_Struct


