	Pointer EndDirectoryEnumerationCallback					// PRJ_END_DIRECTORY_ENUMERATION_CB
	Pointer GetDirectoryEnumerationCallback					// PRJ_GET_DIRECTORY_ENUMERATION_CB
	Pointer GetPlaceholderInfoCallback						// PRJ_GET_PLACEHOLDER_INFO_CB
	Pointer GetFileDataCallback								// PRJ_GET_FILE_DATA_CB
	Pointer QueryFileNameCallback							// PRJ_QUERY_FILE_NAME_CB
	Pointer NotificationCallback							// PRJ_NOTIFICATION_CB
	Pointer CancelCommandCallback							// PRJ_CANCEL_COMMAND_CB
End_Struct

