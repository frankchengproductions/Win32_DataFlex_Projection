	Define JET_relopLessThan								For |CI$00000004
	Define JET_relopGreaterThanOrEqual						For |CI$00000005
	Define JET_relopGreaterThan								For |CI$00000006
	Define JET_relopBitmaskEqualsZero						For |CI$00000007
	Define JET_relopBitmaskNotEqualsZero					For |CI$00000008
End_Enum_List

// Define JET_ERRCAT For Integer
