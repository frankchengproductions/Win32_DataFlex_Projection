Use UI

// Define IsolationState For Integer
Enum_List
	Define isolationStateNotRestricted						For |CI$00000001
	Define isolationStateInProbation						For |CI$00000002
	Define isolationStateRestrictedAccess					For |CI$00000003
End_Enum_List

// Define ExtendedIsolationState For Integer
Enum_List
	Define extendedIsolationStateNoData						For |CI$00000000
	Define extendedIsolationStateTransition					For |CI$00000001
	Define extendedIsolationStateInfected					For |CI$00000002
	Define extendedIsolationStateUnknown					For |CI$00000003
End_Enum_List

// Define NapTracingLevel For Integer
Enum_List
	Define tracingLevelUndefined							For |CI$00000000
	Define tracingLevelBasic								For |CI$00000001
	Define tracingLevelAdvanced								For |CI$00000002
	Define tracingLevelDebug								For |CI$00000003
End_Enum_List

// Define FailureCategory For Integer
Enum_List
	Define failureCategoryNone								For |CI$00000000
	Define failureCategoryOther								For |CI$00000001
	Define failureCategoryClientComponent					For |CI$00000002
	Define failureCategoryClientCommunication				For |CI$00000003
	Define failureCategoryServerComponent					For |CI$00000004
	Define failureCategoryServerCommunication				For |CI$00000005
End_Enum_List

// Define FixupState For Integer
Enum_List
	Define fixupStateSuccess								For |CI$00000000
	Define fixupStateInProgress								For |CI$00000001
	Define fixupStateCouldNotUpdate							For |CI$00000002
End_Enum_List

// Define NapNotifyType For Integer
Enum_List
	Define napNotifyTypeUnknown								For |CI$00000000
	Define napNotifyTypeServiceState						For |CI$00000001
	Define napNotifyTypeQuarState							For |CI$00000002
End_Enum_List

// Define RemoteConfigurationType For Integer
Enum_List
	Define remoteConfigTypeMachine							For |CI$00000001
	Define remoteConfigTypeConfigBlob						For |CI$00000002
End_Enum_List


Procedure DataFlex_Init
End_Procedure

