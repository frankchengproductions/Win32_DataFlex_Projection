Use UI

// Define IsolationState For Integer
Enum_List
	Define isolationStateNotRestricted						For 1
	Define isolationStateInProbation						For 2
	Define isolationStateRestrictedAccess					For 3
End_Enum_List

// Define ExtendedIsolationState For Integer
Enum_List
	Define extendedIsolationStateNoData						For 0
	Define extendedIsolationStateTransition					For 1
	Define extendedIsolationStateInfected					For 2
	Define extendedIsolationStateUnknown					For 3
End_Enum_List

// Define NapTracingLevel For Integer
Enum_List
	Define tracingLevelUndefined							For 0
	Define tracingLevelBasic								For 1
	Define tracingLevelAdvanced								For 2
	Define tracingLevelDebug								For 3
End_Enum_List

// Define FailureCategory For Integer
Enum_List
	Define failureCategoryNone								For 0
	Define failureCategoryOther								For 1
	Define failureCategoryClientComponent					For 2
	Define failureCategoryClientCommunication				For 3
	Define failureCategoryServerComponent					For 4
	Define failureCategoryServerCommunication				For 5
End_Enum_List

// Define FixupState For Integer
Enum_List
	Define fixupStateSuccess								For 0
	Define fixupStateInProgress								For 1
	Define fixupStateCouldNotUpdate							For 2
End_Enum_List

// Define NapNotifyType For Integer
Enum_List
	Define napNotifyTypeUnknown								For 0
	Define napNotifyTypeServiceState						For 1
	Define napNotifyTypeQuarState							For 2
End_Enum_List

// Define RemoteConfigurationType For Integer
Enum_List
	Define remoteConfigTypeMachine							For 1
	Define remoteConfigTypeConfigBlob						For 2
End_Enum_List


Procedure DataFlex_Init
End_Procedure

