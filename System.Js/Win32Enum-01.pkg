Use UI

// Define JsRuntimeVersion For Integer
Enum_List
	Define JsRuntimeVersionEdge								For -1
	Define JsRuntimeVersion10								For |CI$00000000
	Define JsRuntimeVersion11								For |CI$00000001
End_Enum_List

// Define JsErrorCode For UInteger
Enum_List
	Define JsNoError										For |CI$00000000
	Define JsErrorCategoryUsage								For |CI$00010000
	Define JsErrorInvalidArgument							For |CI$00010001
	Define JsErrorNullArgument								For |CI$00010002
	Define JsErrorNoCurrentContext							For |CI$00010003
	Define JsErrorInExceptionState							For |CI$00010004
	Define JsErrorNotImplemented							For |CI$00010005
	Define JsErrorWrongThread								For |CI$00010006
	Define JsErrorRuntimeInUse								For |CI$00010007
	Define JsErrorBadSerializedScript						For |CI$00010008
	Define JsErrorInDisabledState							For |CI$00010009
	Define JsErrorCannotDisableExecution					For |CI$0001000A
	Define JsErrorHeapEnumInProgress						For |CI$0001000B
	Define JsErrorArgumentNotObject							For |CI$0001000C
	Define JsErrorInProfileCallback							For |CI$0001000D
	Define JsErrorInThreadServiceCallback					For |CI$0001000E
	Define JsErrorCannotSerializeDebugScript				For |CI$0001000F
	Define JsErrorAlreadyDebuggingContext					For |CI$00010010
	Define JsErrorAlreadyProfilingContext					For |CI$00010011
	Define JsErrorIdleNotEnabled							For |CI$00010012
	Define JsErrorCategoryEngine							For |CI$00020000
	Define JsErrorOutOfMemory								For |CI$00020001
	Define JsErrorCategoryScript							For |CI$00030000
	Define JsErrorScriptException							For |CI$00030001
	Define JsErrorScriptCompile								For |CI$00030002
	Define JsErrorScriptTerminated							For |CI$00030003
	Define JsErrorScriptEvalDisabled						For |CI$00030004
	Define JsErrorCategoryFatal								For |CI$00040000
	Define JsErrorFatal										For |CI$00040001
End_Enum_List

// Define JsRuntimeAttributes For Integer
Enum_List
	Define JsRuntimeAttributeNone							For |CI$00000000
	Define JsRuntimeAttributeDisableBackgroundWork			For |CI$00000001
	Define JsRuntimeAttributeAllowScriptInterrupt			For |CI$00000002
	Define JsRuntimeAttributeEnableIdleProcessing			For |CI$00000004
	Define JsRuntimeAttributeDisableNativeCodeGeneration	For |CI$00000008
	Define JsRuntimeAttributeDisableEval					For |CI$00000010
End_Enum_List

// Define JsValueType For Integer
Enum_List
	Define JsUndefined										For |CI$00000000
	Define JsNull											For |CI$00000001
	Define JsNumber											For |CI$00000002
	Define JsString											For |CI$00000003
	Define JsBoolean										For |CI$00000004
	Define JsObject											For |CI$00000005
	Define JsFunction										For |CI$00000006
	Define JsError											For |CI$00000007
	Define JsArray											For |CI$00000008
End_Enum_List

// Define JsMemoryEventType For Integer
Enum_List
	Define JsMemoryAllocate									For |CI$00000000
	Define JsMemoryFree										For |CI$00000001
	Define JsMemoryFailure									For |CI$00000002
End_Enum_List


Procedure DataFlex_Init
End_Procedure

