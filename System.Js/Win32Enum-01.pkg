Use UI

// Define JsRuntimeVersion For Integer
Enum_List
	Define JsRuntimeVersion10								For 0
	Define JsRuntimeVersion11								For 1
	Define JsRuntimeVersionEdge								For -1
End_Enum_List

// Define JsErrorCode For UInteger
Enum_List
	Define JsNoError										For 0
	Define JsErrorCategoryUsage								For 65536
	Define JsErrorInvalidArgument							For 65537
	Define JsErrorNullArgument								For 65538
	Define JsErrorNoCurrentContext							For 65539
	Define JsErrorInExceptionState							For 65540
	Define JsErrorNotImplemented							For 65541
	Define JsErrorWrongThread								For 65542
	Define JsErrorRuntimeInUse								For 65543
	Define JsErrorBadSerializedScript						For 65544
	Define JsErrorInDisabledState							For 65545
	Define JsErrorCannotDisableExecution					For 65546
	Define JsErrorHeapEnumInProgress						For 65547
	Define JsErrorArgumentNotObject							For 65548
	Define JsErrorInProfileCallback							For 65549
	Define JsErrorInThreadServiceCallback					For 65550
	Define JsErrorCannotSerializeDebugScript				For 65551
	Define JsErrorAlreadyDebuggingContext					For 65552
	Define JsErrorAlreadyProfilingContext					For 65553
	Define JsErrorIdleNotEnabled							For 65554
	Define JsErrorCategoryEngine							For 131072
	Define JsErrorOutOfMemory								For 131073
	Define JsErrorCategoryScript							For 196608
	Define JsErrorScriptException							For 196609
	Define JsErrorScriptCompile								For 196610
	Define JsErrorScriptTerminated							For 196611
	Define JsErrorScriptEvalDisabled						For 196612
	Define JsErrorCategoryFatal								For 262144
	Define JsErrorFatal										For 262145
End_Enum_List

// Define JsRuntimeAttributes For Integer
Enum_List
	Define JsRuntimeAttributeNone							For 0
	Define JsRuntimeAttributeDisableBackgroundWork			For 1
	Define JsRuntimeAttributeAllowScriptInterrupt			For 2
	Define JsRuntimeAttributeEnableIdleProcessing			For 4
	Define JsRuntimeAttributeDisableNativeCodeGeneration	For 8
	Define JsRuntimeAttributeDisableEval					For 16
End_Enum_List

// Define JsValueType For Integer
Enum_List
	Define JsUndefined										For 0
	Define JsNull											For 1
	Define JsNumber											For 2
	Define JsString											For 3
	Define JsBoolean										For 4
	Define JsObject											For 5
	Define JsFunction										For 6
	Define JsError											For 7
	Define JsArray											For 8
End_Enum_List

// Define JsMemoryEventType For Integer
Enum_List
	Define JsMemoryAllocate									For 0
	Define JsMemoryFree										For 1
	Define JsMemoryFailure									For 2
End_Enum_List


Procedure DataFlex_Init
End_Procedure

