Struct HARDWARE_COUNTER_DATA
	Integer Type											// HARDWARE_COUNTER_TYPE
	UInteger Reserved
	UBigint Value
End_Struct

// https://learn.microsoft.com/windows/win32/api/winnt/ns-winnt-performance_data
Struct PERFORMANCE_DATA
	UShort Size
	UChar Version
	UChar HwCountersCount
	UInteger ContextSwitchCount
	UBigint WaitReasonBitMap
	UBigint CycleTime
	UInteger RetryCount
	UInteger Reserved
	HARDWARE_COUNTER_DATA[16] HwCounters
End_Struct


