Use UI

// Define RDC_ErrorCode For Integer
Enum_List
	Define RDC_NoError										For |CI$00000000
	Define RDC_HeaderVersionNewer							For |CI$00000001
	Define RDC_HeaderVersionOlder							For |CI$00000002
	Define RDC_HeaderMissingOrCorrupt						For |CI$00000003
	Define RDC_HeaderWrongType								For |CI$00000004
	Define RDC_DataMissingOrCorrupt							For |CI$00000005
	Define RDC_DataTooManyRecords							For |CI$00000006
	Define RDC_FileChecksumMismatch							For |CI$00000007
	Define RDC_ApplicationError								For |CI$00000008
	Define RDC_Aborted										For |CI$00000009
	Define RDC_Win32Error									For |CI$0000000A
End_Enum_List

// Define GeneratorParametersType For Integer
Enum_List
	Define RDCGENTYPE_Unused								For |CI$00000000
	Define RDCGENTYPE_FilterMax								For |CI$00000001
End_Enum_List

// Define RdcNeedType For Integer
Enum_List
	Define RDCNEED_SOURCE									For |CI$00000000
	Define RDCNEED_TARGET									For |CI$00000001
	Define RDCNEED_SEED										For |CI$00000002
	Define RDCNEED_SEED_MAX									For |CI$000000FF
End_Enum_List

// Define RdcCreatedTables For Integer
Enum_List
	Define RDCTABLE_InvalidOrUnknown						For |CI$00000000
	Define RDCTABLE_Existing								For |CI$00000001
	Define RDCTABLE_New										For |CI$00000002
End_Enum_List

// Define RdcMappingAccessMode For Integer
Enum_List
	Define RDCMAPPING_Undefined								For |CI$00000000
	Define RDCMAPPING_ReadOnly								For |CI$00000001
	Define RDCMAPPING_ReadWrite								For |CI$00000002
End_Enum_List


Procedure DataFlex_Init
End_Procedure

