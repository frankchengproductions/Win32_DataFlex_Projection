Use UI

// Define RDC_ErrorCode For Integer
Enum_List
	Define RDC_NoError										For 0
	Define RDC_HeaderVersionNewer							For 1
	Define RDC_HeaderVersionOlder							For 2
	Define RDC_HeaderMissingOrCorrupt						For 3
	Define RDC_HeaderWrongType								For 4
	Define RDC_DataMissingOrCorrupt							For 5
	Define RDC_DataTooManyRecords							For 6
	Define RDC_FileChecksumMismatch							For 7
	Define RDC_ApplicationError								For 8
	Define RDC_Aborted										For 9
	Define RDC_Win32Error									For 10
End_Enum_List

// Define GeneratorParametersType For Integer
Enum_List
	Define RDCGENTYPE_Unused								For 0
	Define RDCGENTYPE_FilterMax								For 1
End_Enum_List

// Define RdcNeedType For Integer
Enum_List
	Define RDCNEED_SOURCE									For 0
	Define RDCNEED_TARGET									For 1
	Define RDCNEED_SEED										For 2
	Define RDCNEED_SEED_MAX									For 255
End_Enum_List

// Define RdcCreatedTables For Integer
Enum_List
	Define RDCTABLE_InvalidOrUnknown						For 0
	Define RDCTABLE_Existing								For 1
	Define RDCTABLE_New										For 2
End_Enum_List

// Define RdcMappingAccessMode For Integer
Enum_List
	Define RDCMAPPING_Undefined								For 0
	Define RDCMAPPING_ReadOnly								For 1
	Define RDCMAPPING_ReadWrite								For 2
End_Enum_List


Procedure DataFlex_Init
End_Procedure

