	Define QC_LESSTHAN										For |CI$00000002
	Define QC_LESSTHANOREQUAL								For |CI$00000003
	Define QC_GREATERTHAN									For |CI$00000004
	Define QC_GREATERTHANOREQUAL							For |CI$00000005
	Define QC_STARTSWITH									For |CI$00000006
	Define QC_EXISTS										For |CI$00000007
	Define QC_DOESNOTEXIST									For |CI$00000008
	Define QC_CONTAINS										For |CI$00000009
End_Enum_List

// Define SystemVisibilityFlags For Integer
Enum_List
	Define SVF_SYSTEM										For |CI$00000000
	Define SVF_USER											For |CI$00000001
End_Enum_List

// Define QueryUpdateAction For Integer
Enum_List
	Define QUA_ADD											For |CI$00000000
	Define QUA_REMOVE										For |CI$00000001
	Define QUA_CHANGE										For |CI$00000002
End_Enum_List

// Define QueryCategoryType For Integer
