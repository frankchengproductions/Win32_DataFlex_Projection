Use UI

// Define ATTRIBUTE_TYPE For Integer
Enum_List
	Define AT_INVALID										For |CI$00000000
	Define AT_BOOLEAN										For |CI$00000001
	Define AT_INT8											For |CI$00000002
	Define AT_UINT8											For |CI$00000003
	Define AT_INT16											For |CI$00000004
	Define AT_UINT16										For |CI$00000005
	Define AT_INT32											For |CI$00000006
	Define AT_UINT32										For |CI$00000007
	Define AT_INT64											For |CI$00000008
	Define AT_UINT64										For |CI$00000009
	Define AT_STRING										For |CI$0000000A
	Define AT_GUID											For |CI$0000000B
	Define AT_LIFE_TIME										For |CI$0000000C
	Define AT_SOCKADDR										For |CI$0000000D
	Define AT_OCTET_STRING									For |CI$0000000E
End_Enum_List

// Define REPAIR_SCOPE For Integer
Enum_List
	Define RS_SYSTEM										For |CI$00000000
	Define RS_USER											For |CI$00000001
	Define RS_APPLICATION									For |CI$00000002
	Define RS_PROCESS										For |CI$00000003
End_Enum_List

// Define REPAIR_RISK For Integer
Enum_List
	Define RR_NOROLLBACK									For |CI$00000000
	Define RR_ROLLBACK										For |CI$00000001
	Define RR_NORISK										For |CI$00000002
End_Enum_List

// Define UI_INFO_TYPE For Integer
Enum_List
	Define UIT_INVALID										For |CI$00000000
	Define UIT_NONE											For |CI$00000001
	Define UIT_SHELL_COMMAND								For |CI$00000002
	Define UIT_HELP_PANE									For |CI$00000003
	Define UIT_DUI											For |CI$00000004
End_Enum_List

// Define DIAGNOSIS_STATUS For Integer
Enum_List
	Define DS_NOT_IMPLEMENTED								For |CI$00000000
	Define DS_CONFIRMED										For |CI$00000001
	Define DS_REJECTED										For |CI$00000002
	Define DS_INDETERMINATE									For |CI$00000003
	Define DS_DEFERRED										For |CI$00000004
	Define DS_PASSTHROUGH									For |CI$00000005
End_Enum_List

// Define REPAIR_STATUS For Integer
Enum_List
	Define RS_NOT_IMPLEMENTED								For |CI$00000000
	Define RS_REPAIRED										For |CI$00000001
	Define RS_UNREPAIRED									For |CI$00000002
	Define RS_DEFERRED										For |CI$00000003
	Define RS_USER_ACTION									For |CI$00000004
End_Enum_List

// Define PROBLEM_TYPE For Integer
Enum_List
	Define PT_INVALID										For |CI$00000000
	Define PT_LOW_HEALTH									For |CI$00000001
	Define PT_LOWER_HEALTH									For |CI$00000002
	Define PT_DOWN_STREAM_HEALTH							For |CI$00000004
	Define PT_HIGH_UTILIZATION								For |CI$00000008
	Define PT_HIGHER_UTILIZATION							For |CI$00000010
	Define PT_UP_STREAM_UTILIZATION							For |CI$00000020
End_Enum_List


Procedure DataFlex_Init
End_Procedure

