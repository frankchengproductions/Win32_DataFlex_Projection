Use UI

// Define ATTRIBUTE_TYPE For Integer
Enum_List
	Define AT_INVALID										For 0
	Define AT_BOOLEAN										For 1
	Define AT_INT8											For 2
	Define AT_UINT8											For 3
	Define AT_INT16											For 4
	Define AT_UINT16										For 5
	Define AT_INT32											For 6
	Define AT_UINT32										For 7
	Define AT_INT64											For 8
	Define AT_UINT64										For 9
	Define AT_STRING										For 10
	Define AT_GUID											For 11
	Define AT_LIFE_TIME										For 12
	Define AT_SOCKADDR										For 13
	Define AT_OCTET_STRING									For 14
End_Enum_List

// Define REPAIR_SCOPE For Integer
Enum_List
	Define RS_SYSTEM										For 0
	Define RS_USER											For 1
	Define RS_APPLICATION									For 2
	Define RS_PROCESS										For 3
End_Enum_List

// Define REPAIR_RISK For Integer
Enum_List
	Define RR_NOROLLBACK									For 0
	Define RR_ROLLBACK										For 1
	Define RR_NORISK										For 2
End_Enum_List

// Define UI_INFO_TYPE For Integer
Enum_List
	Define UIT_INVALID										For 0
	Define UIT_NONE											For 1
	Define UIT_SHELL_COMMAND								For 2
	Define UIT_HELP_PANE									For 3
	Define UIT_DUI											For 4
End_Enum_List

// Define DIAGNOSIS_STATUS For Integer
Enum_List
	Define DS_NOT_IMPLEMENTED								For 0
	Define DS_CONFIRMED										For 1
	Define DS_REJECTED										For 2
	Define DS_INDETERMINATE									For 3
	Define DS_DEFERRED										For 4
	Define DS_PASSTHROUGH									For 5
End_Enum_List

// Define REPAIR_STATUS For Integer
Enum_List
	Define RS_NOT_IMPLEMENTED								For 0
	Define RS_REPAIRED										For 1
	Define RS_UNREPAIRED									For 2
	Define RS_DEFERRED										For 3
	Define RS_USER_ACTION									For 4
End_Enum_List

// Define PROBLEM_TYPE For Integer
Enum_List
	Define PT_INVALID										For 0
	Define PT_LOW_HEALTH									For 1
	Define PT_LOWER_HEALTH									For 2
	Define PT_DOWN_STREAM_HEALTH							For 4
	Define PT_HIGH_UTILIZATION								For 8
	Define PT_HIGHER_UTILIZATION							For 16
	Define PT_UP_STREAM_UTILIZATION							For 32
End_Enum_List


Procedure DataFlex_Init
