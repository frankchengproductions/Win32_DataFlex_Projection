Use UI

// Define WINSAT_OEM_CUSTOMIZATION_STATE For Integer
Enum_List
	Define WINSAT_OEM_DATA_VALID							For |CI$00000000
	Define WINSAT_OEM_DATA_NON_SYS_CONFIG_MATCH				For |CI$00000001
	Define WINSAT_OEM_DATA_INVALID							For |CI$00000002
	Define WINSAT_OEM_NO_DATA_SUPPLIED						For |CI$00000003
End_Enum_List

// Define WINSAT_ASSESSMENT_STATE For Integer
Enum_List
	Define WINSAT_ASSESSMENT_STATE_MIN						For |CI$00000000
	Define WINSAT_ASSESSMENT_STATE_UNKNOWN					For |CI$00000000
	Define WINSAT_ASSESSMENT_STATE_VALID					For |CI$00000001
	Define WINSAT_ASSESSMENT_STATE_INCOHERENT_WITH_HARDWARE	For |CI$00000002
	Define WINSAT_ASSESSMENT_STATE_NOT_AVAILABLE			For |CI$00000003
	Define WINSAT_ASSESSMENT_STATE_INVALID					For |CI$00000004
	Define WINSAT_ASSESSMENT_STATE_MAX						For |CI$00000004
End_Enum_List

// Define WINSAT_ASSESSMENT_TYPE For Integer
Enum_List
	Define WINSAT_ASSESSMENT_MEMORY							For |CI$00000000
	Define WINSAT_ASSESSMENT_CPU							For |CI$00000001
	Define WINSAT_ASSESSMENT_DISK							For |CI$00000002
	Define WINSAT_ASSESSMENT_D3D							For |CI$00000003
	Define WINSAT_ASSESSMENT_GRAPHICS						For |CI$00000004
End_Enum_List

// Define WINSAT_BITMAP_SIZE For Integer
Enum_List
