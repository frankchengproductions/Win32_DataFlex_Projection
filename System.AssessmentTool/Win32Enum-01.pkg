Use UI

// Define WINSAT_OEM_CUSTOMIZATION_STATE For Integer
Enum_List
	Define WINSAT_OEM_DATA_VALID							For 0
	Define WINSAT_OEM_DATA_NON_SYS_CONFIG_MATCH				For 1
	Define WINSAT_OEM_DATA_INVALID							For 2
	Define WINSAT_OEM_NO_DATA_SUPPLIED						For 3
End_Enum_List

// Define WINSAT_ASSESSMENT_STATE For Integer
Enum_List
	Define WINSAT_ASSESSMENT_STATE_MIN						For 0
	Define WINSAT_ASSESSMENT_STATE_UNKNOWN					For 0
	Define WINSAT_ASSESSMENT_STATE_VALID					For 1
	Define WINSAT_ASSESSMENT_STATE_INCOHERENT_WITH_HARDWARE	For 2
	Define WINSAT_ASSESSMENT_STATE_NOT_AVAILABLE			For 3
	Define WINSAT_ASSESSMENT_STATE_INVALID					For 4
	Define WINSAT_ASSESSMENT_STATE_MAX						For 4
End_Enum_List

// Define WINSAT_ASSESSMENT_TYPE For Integer
Enum_List
	Define WINSAT_ASSESSMENT_MEMORY							For 0
	Define WINSAT_ASSESSMENT_CPU							For 1
	Define WINSAT_ASSESSMENT_DISK							For 2
	Define WINSAT_ASSESSMENT_D3D							For 3
	Define WINSAT_ASSESSMENT_GRAPHICS						For 4
End_Enum_List

// Define WINSAT_BITMAP_SIZE For Integer
Enum_List
	Define WINSAT_BITMAP_SIZE_SMALL							For 0
	Define WINSAT_BITMAP_SIZE_NORMAL						For 1
End_Enum_List


Procedure DataFlex_Init
End_Procedure

