	Define DCOMPOSITION_BITMAP_INTERPOLATION_MODE_LINEAR	For 1
	Define DCOMPOSITION_BITMAP_INTERPOLATION_MODE_INHERIT	For -1
End_Enum_List

// Define DCOMPOSITION_BORDER_MODE For Integer
