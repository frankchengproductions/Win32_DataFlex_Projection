	Define DCOMPOSITION_OPACITY_MODE_INHERIT				For -1
End_Enum_List

// Define DCOMPOSITION_DEPTH_MODE For Integer
Enum_List
	Define DCOMPOSITION_DEPTH_MODE_TREE						For 0
