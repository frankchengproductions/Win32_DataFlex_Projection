	Define DCOMPOSITION_BORDER_MODE_SOFT					For 0
	Define DCOMPOSITION_BORDER_MODE_HARD					For 1
	Define DCOMPOSITION_BORDER_MODE_INHERIT					For -1
End_Enum_List

// Define DCOMPOSITION_COMPOSITE_MODE For Integer
