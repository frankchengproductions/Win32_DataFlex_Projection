Use UI

// Define DFS_NAMESPACE_VERSION_ORIGIN For Integer
Enum_List
	Define DFS_NAMESPACE_VERSION_ORIGIN_COMBINED			For 0
	Define DFS_NAMESPACE_VERSION_ORIGIN_SERVER				For 1
	Define DFS_NAMESPACE_VERSION_ORIGIN_DOMAIN				For 2
End_Enum_List

// Define DFS_TARGET_PRIORITY_CLASS For Integer
Enum_List
	Define DfsInvalidPriorityClass							For -1
	Define DfsSiteCostNormalPriorityClass					For 0
	Define DfsGlobalHighPriorityClass						For 1
	Define DfsSiteCostHighPriorityClass						For 2
	Define DfsSiteCostLowPriorityClass						For 3
	Define DfsGlobalLowPriorityClass						For 4
End_Enum_List


Procedure DataFlex_Init
End_Procedure

