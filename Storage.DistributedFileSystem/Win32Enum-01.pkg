Use UI

// Define DFS_NAMESPACE_VERSION_ORIGIN For Integer
Enum_List
	Define DFS_NAMESPACE_VERSION_ORIGIN_COMBINED			For |CI$00000000
	Define DFS_NAMESPACE_VERSION_ORIGIN_SERVER				For |CI$00000001
	Define DFS_NAMESPACE_VERSION_ORIGIN_DOMAIN				For |CI$00000002
End_Enum_List

// Define DFS_TARGET_PRIORITY_CLASS For Integer
Enum_List
	Define DfsInvalidPriorityClass							For -1
	Define DfsSiteCostNormalPriorityClass					For |CI$00000000
	Define DfsGlobalHighPriorityClass						For |CI$00000001
	Define DfsSiteCostHighPriorityClass						For |CI$00000002
	Define DfsSiteCostLowPriorityClass						For |CI$00000003
	Define DfsGlobalLowPriorityClass						For |CI$00000004
End_Enum_List


Procedure DataFlex_Init
End_Procedure

