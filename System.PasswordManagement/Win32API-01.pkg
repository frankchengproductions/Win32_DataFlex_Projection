External_Function MSChapSrvChangePassword "MSChapSrvChangePassword" ADVAPI32.dll ;
	WString ServerName ;	// PWSTR
	WString UserName ;	// PWSTR
	UChar LmOldPresent ;	// BOOLEAN
	Pointer LmOldOwfPassword ;	// LM_OWF_PASSWORD*
	Pointer LmNewOwfPassword ;	// LM_OWF_PASSWORD*
	Pointer NtOldOwfPassword ;	// LM_OWF_PASSWORD*
	Pointer NtNewOwfPassword ;	// LM_OWF_PASSWORD*
	Returns UInteger

