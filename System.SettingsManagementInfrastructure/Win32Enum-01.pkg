Use UI

// Define WcmTargetMode For Integer
Enum_List
	Define OfflineMode										For 1
	Define OnlineMode										For 2
End_Enum_List

// Define WcmNamespaceEnumerationFlags For Integer
Enum_List
	Define SharedEnumeration								For 1
	Define UserEnumeration									For 2
	Define AllEnumeration									For 3
End_Enum_List

// Define WcmDataType For Integer
Enum_List
	Define dataTypeByte										For 1
	Define dataTypeSByte									For 2
	Define dataTypeUInt16									For 3
	Define dataTypeInt16									For 4
	Define dataTypeUInt32									For 5
	Define dataTypeInt32									For 6
	Define dataTypeUInt64									For 7
	Define dataTypeInt64									For 8
	Define dataTypeBoolean									For 11
	Define dataTypeString									For 12
	Define dataTypeFlagArray								For 32768
End_Enum_List

// Define WcmSettingType For Integer
Enum_List
	Define settingTypeScalar								For 1
	Define settingTypeComplex								For 2
	Define settingTypeList									For 3
End_Enum_List

// Define WcmRestrictionFacets For Integer
Enum_List
	Define restrictionFacetMaxLength						For 1
	Define restrictionFacetEnumeration						For 2
	Define restrictionFacetMaxInclusive						For 4
	Define restrictionFacetMinInclusive						For 8
End_Enum_List

// Define WcmUserStatus For Integer
Enum_List
	Define UnknownStatus									For 0
	Define UserRegistered									For 1
	Define UserUnregistered									For 2
	Define UserLoaded										For 3
	Define UserUnloaded										For 4
End_Enum_List

// Define WcmNamespaceAccess For Integer
Enum_List
	Define ReadOnlyAccess									For 1
	Define ReadWriteAccess									For 2
End_Enum_List


Procedure DataFlex_Init
End_Procedure

