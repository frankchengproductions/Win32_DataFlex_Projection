Use UI

// Define WcmTargetMode For Integer
Enum_List
	Define OfflineMode										For |CI$00000001
	Define OnlineMode										For |CI$00000002
End_Enum_List

// Define WcmNamespaceEnumerationFlags For Integer
Enum_List
	Define SharedEnumeration								For |CI$00000001
	Define UserEnumeration									For |CI$00000002
	Define AllEnumeration									For |CI$00000003
End_Enum_List

// Define WcmDataType For Integer
Enum_List
	Define dataTypeByte										For |CI$00000001
	Define dataTypeSByte									For |CI$00000002
	Define dataTypeUInt16									For |CI$00000003
	Define dataTypeInt16									For |CI$00000004
	Define dataTypeUInt32									For |CI$00000005
	Define dataTypeInt32									For |CI$00000006
	Define dataTypeUInt64									For |CI$00000007
	Define dataTypeInt64									For |CI$00000008
	Define dataTypeBoolean									For |CI$0000000B
	Define dataTypeString									For |CI$0000000C
	Define dataTypeFlagArray								For |CI$00008000
End_Enum_List

// Define WcmSettingType For Integer
Enum_List
	Define settingTypeScalar								For |CI$00000001
	Define settingTypeComplex								For |CI$00000002
	Define settingTypeList									For |CI$00000003
End_Enum_List

// Define WcmRestrictionFacets For Integer
Enum_List
	Define restrictionFacetMaxLength						For |CI$00000001
	Define restrictionFacetEnumeration						For |CI$00000002
	Define restrictionFacetMaxInclusive						For |CI$00000004
	Define restrictionFacetMinInclusive						For |CI$00000008
End_Enum_List

// Define WcmUserStatus For Integer
Enum_List
	Define UnknownStatus									For |CI$00000000
	Define UserRegistered									For |CI$00000001
	Define UserUnregistered									For |CI$00000002
	Define UserLoaded										For |CI$00000003
	Define UserUnloaded										For |CI$00000004
End_Enum_List

// Define WcmNamespaceAccess For Integer
Enum_List
	Define ReadOnlyAccess									For |CI$00000001
	Define ReadWriteAccess									For |CI$00000002
End_Enum_List


Procedure DataFlex_Init
End_Procedure

