	Define SCE_LOG_LEVEL_ERROR								For |CI$00000001
	Define SCE_LOG_LEVEL_DETAIL								For |CI$00000002
	Define SCE_LOG_LEVEL_DEBUG								For |CI$00000003
End_Enum_List

// Define SCESVC_INFO_TYPE For Integer
Enum_List
	Define SceSvcConfigurationInfo							For |CI$00000000
	Define SceSvcMergedPolicyInfo							For |CI$00000001
	Define SceSvcAnalysisInfo								For |CI$00000002
	Define SceSvcInternalUse								For |CI$00000003
End_Enum_List


Procedure DataFlex_Init
End_Procedure

