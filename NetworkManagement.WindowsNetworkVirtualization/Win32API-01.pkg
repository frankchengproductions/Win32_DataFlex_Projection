	Pointer WnvHandle ;	// HANDLE
	Pointer NotificationParam ;	// WNV_NOTIFICATION_PARAM*
	Pointer Overlapped ;	// OVERLAPPED*
	Pointer BytesTransferred ;	// UInteger*
	Returns UInteger


Procedure DataFlex_Init
