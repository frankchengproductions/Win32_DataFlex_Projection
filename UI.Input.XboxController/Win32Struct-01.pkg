Use UI

// https://learn.microsoft.com/windows/win32/api/xinput/ns-xinput-xinput_battery_information
Struct XINPUT_BATTERY_INFORMATION
	UChar BatteryType										// BATTERY_TYPE
	UChar BatteryLevel										// BATTERY_LEVEL
End_Struct

// https://learn.microsoft.com/windows/win32/api/xinput/ns-xinput-xinput_capabilities
Struct XINPUT_CAPABILITIES
	UChar Type												// XINPUT_DEVTYPE
	UChar SubType											// XINPUT_DEVSUBTYPE
	UShort Flags											// XINPUT_CAPABILITIES_FLAGS
	XINPUT_GAMEPAD Gamepad
	XINPUT_VIBRATION Vibration
End_Struct

// https://learn.microsoft.com/windows/win32/api/xinput/ns-xinput-xinput_gamepad
Struct XINPUT_GAMEPAD
	UShort wButtons											// XINPUT_GAMEPAD_BUTTON_FLAGS
	UChar bLeftTrigger
	UChar bRightTrigger
	Short sThumbLX
	Short sThumbLY
	Short sThumbRX
	Short sThumbRY
End_Struct

// https://learn.microsoft.com/windows/win32/api/xinput/ns-xinput-xinput_keystroke
Struct XINPUT_KEYSTROKE
	UShort VirtualKey										// XINPUT_VIRTUAL_KEY
	UShort Unicode
	UShort Flags											// XINPUT_KEYSTROKE_FLAGS
	UChar UserIndex
	UChar HidCode
End_Struct

// https://learn.microsoft.com/windows/win32/api/xinput/ns-xinput-xinput_state
Struct XINPUT_STATE
	UInteger dwPacketNumber
	XINPUT_GAMEPAD Gamepad
End_Struct

// https://learn.microsoft.com/windows/win32/api/xinput/ns-xinput-xinput_vibration
Struct XINPUT_VIBRATION
	UShort wLeftMotorSpeed
	UShort wRightMotorSpeed
End_Struct


Procedure DataFlex_Init
End_Procedure

