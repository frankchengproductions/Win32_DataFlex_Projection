Use UI

// https://learn.microsoft.com/windows/win32/api/dxgi/ns-dxgi-dxgi_swap_chain_desc
Struct DXGI_SWAP_CHAIN_DESC
	DXGI_MODE_DESC BufferDesc
	DXGI_SAMPLE_DESC SampleDesc
	UInteger BufferUsage									// DXGI_USAGE
	UInteger BufferCount
	Integer iMissingAlignment1
	Pointer OutputWindow									// HWND
	Integer Windowed										// BOOL
	Integer SwapEffect										// DXGI_SWAP_EFFECT
	UInteger Flags
	Integer iMissingAlignment2
End_Struct


Procedure DataFlex_Init
End_Procedure

