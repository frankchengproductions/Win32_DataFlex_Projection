Use UI

// https://learn.microsoft.com/windows/win32/api/winuser/ns-winuser-gestureconfig
Struct GESTURECONFIG
	UInteger dwID											// GESTURECONFIG_ID
	UInteger dwWant
	UInteger dwBlock
End_Struct

// https://learn.microsoft.com/windows/win32/api/winuser/ns-winuser-gestureinfo
Struct GESTUREINFO
	UInteger cbSize
	UInteger dwFlags
	UInteger dwID
	Integer iMissingAlignment1
	Pointer hwndTarget										// HWND
	POINTS ptsLocation
	UInteger dwInstanceID
	UInteger dwSequenceID
	Integer iMissingAlignment2
	UBigint ullArguments
	UInteger cbExtraArgs
	Integer iMissingAlignment3
End_Struct

// https://learn.microsoft.com/windows/win32/api/winuser/ns-winuser-touchinput
Struct TOUCHINPUT
	Integer x
	Integer y
	Pointer hSource											// HANDLE
	UInteger dwID
	UInteger dwFlags										// TOUCHEVENTF_FLAGS
	UInteger dwMask											// TOUCHINPUTMASKF_MASK
	UInteger dwTime
	ULongPtr dwExtraInfo
	UInteger cxContact
	UInteger cyContact
End_Struct


Procedure DataFlex_Init
End_Procedure

