	Define GID_PAN											For |CI$00000004
	Define GID_ROTATE										For |CI$00000005
	Define GID_TWOFINGERTAP									For |CI$00000006
	Define GID_PRESSANDTAP									For |CI$00000007
	Define GID_ROLLOVER										For |CI$00000007
End_Enum_List

// Define TOUCHEVENTF_FLAGS For UInteger
Enum_List
	Define TOUCHEVENTF_MOVE									For |CI$00000001
	Define TOUCHEVENTF_DOWN									For |CI$00000002
	Define TOUCHEVENTF_UP									For |CI$00000004
