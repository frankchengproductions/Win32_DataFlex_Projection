Use UI

// Define AgileReferenceOptions For Integer
Enum_List
	Define AGILEREFERENCE_DEFAULT							For 0
	Define AGILEREFERENCE_DELAYEDMARSHAL					For 1
End_Enum_List

// Define DISPATCHERQUEUE_THREAD_TYPE For Integer
Enum_List
	Define DQTYPE_THREAD_DEDICATED							For 1
	Define DQTYPE_THREAD_CURRENT							For 2
End_Enum_List

// Define DISPATCHERQUEUE_THREAD_APARTMENTTYPE For Integer
Enum_List
	Define DQTAT_COM_NONE									For 0
	Define DQTAT_COM_ASTA									For 1
	Define DQTAT_COM_STA									For 2
End_Enum_List

// Define RO_INIT_TYPE For Integer
Enum_List
	Define RO_INIT_SINGLETHREADED							For 0
	Define RO_INIT_MULTITHREADED							For 1
End_Enum_List

// Define BSOS_OPTIONS For Integer
Enum_List
	Define BSOS_DEFAULT										For 0
	Define BSOS_PREFERDESTINATIONSTREAM						For 1
End_Enum_List

// Define ACTIVATIONTYPE For Integer
Enum_List
	Define ACTIVATIONTYPE_UNCATEGORIZED						For 0
	Define ACTIVATIONTYPE_FROM_MONIKER						For 1
	Define ACTIVATIONTYPE_FROM_DATA							For 2
	Define ACTIVATIONTYPE_FROM_STORAGE						For 4
	Define ACTIVATIONTYPE_FROM_STREAM						For 8
	Define ACTIVATIONTYPE_FROM_FILE							For 16
End_Enum_List

// Define TrustLevel For Integer
Enum_List
	Define BaseTrust										For 0
	Define PartialTrust										For 1
	Define FullTrust										For 2
End_Enum_List

// Define CASTING_CONNECTION_ERROR_STATUS For Integer
Enum_List
	Define CASTING_CONNECTION_ERROR_STATUS_SUCCEEDED		For 0
	Define CASTING_CONNECTION_ERROR_STATUS_DEVICE_DID_NOT_RESPOND	For 1
	Define CASTING_CONNECTION_ERROR_STATUS_DEVICE_ERROR		For 2
	Define CASTING_CONNECTION_ERROR_STATUS_DEVICE_LOCKED	For 3
	Define CASTING_CONNECTION_ERROR_STATUS_PROTECTED_PLAYBACK_FAILED	For 4
	Define CASTING_CONNECTION_ERROR_STATUS_INVALID_CASTING_SOURCE	For 5
	Define CASTING_CONNECTION_ERROR_STATUS_UNKNOWN			For 6
End_Enum_List

// Define CASTING_CONNECTION_STATE For Integer
Enum_List
	Define CASTING_CONNECTION_STATE_DISCONNECTED			For 0
	Define CASTING_CONNECTION_STATE_CONNECTED				For 1
	Define CASTING_CONNECTION_STATE_RENDERING				For 2
	Define CASTING_CONNECTION_STATE_DISCONNECTING			For 3
	Define CASTING_CONNECTION_STATE_CONNECTING				For 4
End_Enum_List

// Define RO_ERROR_REPORTING_FLAGS For Integer
Enum_List
	Define RO_ERROR_REPORTING_NONE							For 0
	Define RO_ERROR_REPORTING_SUPPRESSEXCEPTIONS			For 1
	Define RO_ERROR_REPORTING_FORCEEXCEPTIONS				For 2
	Define RO_ERROR_REPORTING_USESETERRORINFO				For 4
	Define RO_ERROR_REPORTING_SUPPRESSSETERRORINFO			For 8
End_Enum_List


Procedure DataFlex_Init
End_Procedure

