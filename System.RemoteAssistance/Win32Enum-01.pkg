Use UI

// Define RENDEZVOUS_SESSION_STATE For Integer
Enum_List
	Define RSS_UNKNOWN										For |CI$00000000
	Define RSS_READY										For |CI$00000001
	Define RSS_INVITATION									For |CI$00000002
	Define RSS_ACCEPTED										For |CI$00000003
	Define RSS_CONNECTED									For |CI$00000004
	Define RSS_CANCELLED									For |CI$00000005
	Define RSS_DECLINED										For |CI$00000006
	Define RSS_TERMINATED									For |CI$00000007
End_Enum_List

// Define RENDEZVOUS_SESSION_FLAGS For Integer
Enum_List
	Define RSF_NONE											For |CI$00000000
	Define RSF_INVITER										For |CI$00000001
	Define RSF_INVITEE										For |CI$00000002
	Define RSF_ORIGINAL_INVITER								For |CI$00000004
	Define RSF_REMOTE_LEGACYSESSION							For |CI$00000008
	Define RSF_REMOTE_WIN7SESSION							For |CI$00000010
End_Enum_List


Procedure DataFlex_Init
End_Procedure

