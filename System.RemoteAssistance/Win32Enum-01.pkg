	Define RSS_UNKNOWN										For 0
	Define RSS_READY										For 1
	Define RSS_INVITATION									For 2
	Define RSS_ACCEPTED										For 3
	Define RSS_CONNECTED									For 4
	Define RSS_CANCELLED									For 5
	Define RSS_DECLINED										For 6
	Define RSS_TERMINATED									For 7
End_Enum_List

// Define RENDEZVOUS_SESSION_FLAGS For Integer
Enum_List
	Define RSF_NONE											For 0
	Define RSF_INVITER										For 1
	Define RSF_INVITEE										For 2
	Define RSF_ORIGINAL_INVITER								For 4
	Define RSF_REMOTE_LEGACYSESSION							For 8
	Define RSF_REMOTE_WIN7SESSION							For 16
