	WString RemoteOptions ;	// PWSTR
	Pointer InterfaceId ;	// Guid*
	Pointer Interface ;	// Pointer**
	Returns Integer	// HRESULT

External_Function DebugCreate "DebugCreate" dbgeng.dll ;
	Pointer InterfaceId ;	// Guid*
	Pointer Interface ;	// Pointer**
	Returns Integer	// HRESULT

External_Function DebugCreateEx "DebugCreateEx" dbgeng.dll ;
	Pointer InterfaceId ;	// Guid*
	UInteger DbgEngOptions ;
	Pointer Interface ;	// Pointer**
	Returns Integer	// HRESULT

External_Function CreateDataModelManager "CreateDataModelManager" dbgmodel.dll ;
	Pointer debugHost ;	// IDebugHost
	Pointer manager ;	// IDataModelManager*
