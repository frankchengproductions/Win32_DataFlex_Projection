Use UI

// Define CRYPTCAT_VERSION For UInteger
Enum_List
	Define CRYPTCAT_VERSION_1								For 256
	Define CRYPTCAT_VERSION_2								For 512
End_Enum_List

// Define CRYPTCAT_OPEN_FLAGS For UInteger
Enum_List
	Define CRYPTCAT_OPEN_ALWAYS								For 2
	Define CRYPTCAT_OPEN_CREATENEW							For 1
	Define CRYPTCAT_OPEN_EXISTING							For 4
	Define CRYPTCAT_OPEN_EXCLUDE_PAGE_HASHES				For 65536
	Define CRYPTCAT_OPEN_INCLUDE_PAGE_HASHES				For 131072
	Define CRYPTCAT_OPEN_VERIFYSIGHASH						For 268435456
	Define CRYPTCAT_OPEN_NO_CONTENT_HCRYPTMSG				For 536870912
	Define CRYPTCAT_OPEN_SORTED								For 1073741824
	Define CRYPTCAT_OPEN_FLAGS_MASK							For 4294901760
End_Enum_List

// Define CRYPTCATATTRIBUTE_FLAGS For UInteger
Enum_List
	Define CRYPTCAT_ATTR_AUTHENTICATED						For 268435456
	Define CRYPTCAT_ATTR_UNAUTHENTICATED					For 536870912
	Define CRYPTCAT_ATTR_NAMEASCII							For 1
	Define CRYPTCAT_ATTR_NAMEOBJID							For 2
	Define CRYPTCAT_ATTR_DATAASCII							For 65536
	Define CRYPTCAT_ATTR_DATABASE64							For 131072
	Define CRYPTCAT_ATTR_DATAREPLACE						For 262144
