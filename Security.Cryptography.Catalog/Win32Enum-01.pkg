Use UI

// Define CRYPTCAT_VERSION For UInteger
Enum_List
	Define CRYPTCAT_VERSION_1								For |CI$00000100
	Define CRYPTCAT_VERSION_2								For |CI$00000200
End_Enum_List

// Define CRYPTCAT_OPEN_FLAGS For UInteger
Enum_List
	Define CRYPTCAT_OPEN_CREATENEW							For |CI$00000001
	Define CRYPTCAT_OPEN_ALWAYS								For |CI$00000002
	Define CRYPTCAT_OPEN_EXISTING							For |CI$00000004
	Define CRYPTCAT_OPEN_EXCLUDE_PAGE_HASHES				For |CI$00010000
	Define CRYPTCAT_OPEN_INCLUDE_PAGE_HASHES				For |CI$00020000
	Define CRYPTCAT_OPEN_VERIFYSIGHASH						For |CI$10000000
	Define CRYPTCAT_OPEN_NO_CONTENT_HCRYPTMSG				For |CI$20000000
	Define CRYPTCAT_OPEN_SORTED								For |CI$40000000
	Define CRYPTCAT_OPEN_FLAGS_MASK							For |CV$FFFF0000
End_Enum_List

// Define CRYPTCATATTRIBUTE_FLAGS For UInteger
Enum_List
	Define CRYPTCAT_ATTR_NAMEASCII							For |CI$00000001
	Define CRYPTCAT_ATTR_NAMEOBJID							For |CI$00000002
	Define CRYPTCAT_ATTR_DATAASCII							For |CI$00010000
	Define CRYPTCAT_ATTR_DATABASE64							For |CI$00020000
	Define CRYPTCAT_ATTR_DATAREPLACE						For |CI$00040000
	Define CRYPTCAT_ATTR_NO_AUTO_COMPAT_ENTRY				For |CI$01000000
	Define CRYPTCAT_ATTR_AUTHENTICATED						For |CI$10000000
	Define CRYPTCAT_ATTR_UNAUTHENTICATED					For |CI$20000000
End_Enum_List


Procedure DataFlex_Init
End_Procedure

