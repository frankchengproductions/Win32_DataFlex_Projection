Use UI

External_Function RtlDrainNonVolatileFlush "RtlDrainNonVolatileFlush" ntdll.dll ;
	Pointer NvToken ;	// Pointer*
	Returns UInteger

External_Function RtlFillNonVolatileMemory "RtlFillNonVolatileMemory" ntdll.dll ;
	Pointer NvToken ;	// Pointer*
	Pointer NvDestination ;	// Pointer*
	ULongPtr Size ;
	UChar Value ;
	UInteger Flags ;
	Returns UInteger

External_Function RtlFlushNonVolatileMemory "RtlFlushNonVolatileMemory" ntdll.dll ;
	Pointer NvToken ;	// Pointer*
	Pointer NvBuffer ;	// Pointer*
	ULongPtr Size ;
	UInteger Flags ;
	Returns UInteger

External_Function RtlFlushNonVolatileMemoryRanges "RtlFlushNonVolatileMemoryRanges" ntdll.dll ;
	Pointer NvToken ;	// Pointer*
	Pointer NvRanges ;	// NV_MEMORY_RANGE*
	ULongPtr NumRanges ;
	UInteger Flags ;
	Returns UInteger

External_Function RtlFreeNonVolatileToken "RtlFreeNonVolatileToken" ntdll.dll ;
	Pointer NvToken ;	// Pointer*
	Returns UInteger

External_Function RtlGetNonVolatileToken "RtlGetNonVolatileToken" ntdll.dll ;
	Pointer NvBuffer ;	// Pointer*
	ULongPtr Size ;
	Pointer NvToken ;	// Pointer**
	Returns UInteger

External_Function RtlWriteNonVolatileMemory "RtlWriteNonVolatileMemory" ntdll.dll ;
	Pointer NvToken ;	// Pointer*
	Pointer NvDestination ;	// Pointer*
	Pointer Source ;	// Pointer*
	ULongPtr Size ;
	UInteger Flags ;
	Returns UInteger


Procedure DataFlex_Init
End_Procedure

