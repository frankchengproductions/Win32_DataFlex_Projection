Use UI

// Define ENTERPRISE_DATA_POLICIES For Integer
Enum_List
	Define ENTERPRISE_POLICY_NONE							For |CI$00000000
	Define ENTERPRISE_POLICY_ALLOWED						For |CI$00000001
	Define ENTERPRISE_POLICY_ENLIGHTENED					For |CI$00000002
	Define ENTERPRISE_POLICY_EXEMPT							For |CI$00000004
End_Enum_List

// Define SRPHOSTING_TYPE For Integer
Enum_List
	Define SRPHOSTING_TYPE_NONE								For |CI$00000000
	Define SRPHOSTING_TYPE_WINHTTP							For |CI$00000001
	Define SRPHOSTING_TYPE_WININET							For |CI$00000002
End_Enum_List

// Define SRPHOSTING_VERSION For Integer
Enum_List
	Define SRPHOSTING_VERSION1								For |CI$00000001
End_Enum_List


Procedure DataFlex_Init
End_Procedure

