Use UI

// Define IDENTITY_TYPE For Integer
Enum_List
	Define IDENTITIES_ALL									For |CI$00000000
	Define IDENTITIES_ME_ONLY								For |CI$00000001
End_Enum_List

// Define IdentityUpdateEvent For Integer
Enum_List
	Define IDENTITY_ASSOCIATED								For |CI$00000001
	Define IDENTITY_DISASSOCIATED							For |CI$00000002
	Define IDENTITY_CREATED									For |CI$00000004
	Define IDENTITY_IMPORTED								For |CI$00000008
	Define IDENTITY_DELETED									For |CI$00000010
	Define IDENTITY_PROPCHANGED								For |CI$00000020
	Define IDENTITY_CONNECTED								For |CI$00000040
	Define IDENTITY_DISCONNECTED							For |CI$00000080
End_Enum_List

// Define IDENTITY_URL For Integer
Enum_List
	Define IDENTITY_URL_CREATE_ACCOUNT_WIZARD				For |CI$00000000
	Define IDENTITY_URL_SIGN_IN_WIZARD						For |CI$00000001
	Define IDENTITY_URL_CHANGE_PASSWORD_WIZARD				For |CI$00000002
	Define IDENTITY_URL_IFEXISTS_WIZARD						For |CI$00000003
	Define IDENTITY_URL_ACCOUNT_SETTINGS					For |CI$00000004
	Define IDENTITY_URL_RESTORE_WIZARD						For |CI$00000005
	Define IDENTITY_URL_CONNECT_WIZARD						For |CI$00000006
End_Enum_List

// Define ACCOUNT_STATE For Integer
Enum_List
	Define NOT_CONNECTED									For |CI$00000000
	Define CONNECTING										For |CI$00000001
	Define CONNECT_COMPLETED								For |CI$00000002
End_Enum_List


Procedure DataFlex_Init
End_Procedure

