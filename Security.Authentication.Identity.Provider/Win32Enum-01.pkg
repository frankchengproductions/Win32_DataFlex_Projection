Use UI

// Define IDENTITY_TYPE For Integer
Enum_List
	Define IDENTITIES_ALL									For 0
	Define IDENTITIES_ME_ONLY								For 1
End_Enum_List

// Define IdentityUpdateEvent For Integer
Enum_List
	Define IDENTITY_ASSOCIATED								For 1
	Define IDENTITY_DISASSOCIATED							For 2
	Define IDENTITY_CREATED									For 4
	Define IDENTITY_IMPORTED								For 8
	Define IDENTITY_DELETED									For 16
	Define IDENTITY_PROPCHANGED								For 32
	Define IDENTITY_CONNECTED								For 64
	Define IDENTITY_DISCONNECTED							For 128
End_Enum_List

// Define IDENTITY_URL For Integer
Enum_List
	Define IDENTITY_URL_CREATE_ACCOUNT_WIZARD				For 0
	Define IDENTITY_URL_SIGN_IN_WIZARD						For 1
	Define IDENTITY_URL_CHANGE_PASSWORD_WIZARD				For 2
	Define IDENTITY_URL_IFEXISTS_WIZARD						For 3
	Define IDENTITY_URL_ACCOUNT_SETTINGS					For 4
	Define IDENTITY_URL_RESTORE_WIZARD						For 5
	Define IDENTITY_URL_CONNECT_WIZARD						For 6
End_Enum_List

// Define ACCOUNT_STATE For Integer
Enum_List
	Define NOT_CONNECTED									For 0
	Define CONNECTING										For 1
	Define CONNECT_COMPLETED								For 2
End_Enum_List


Procedure DataFlex_Init
End_Procedure

