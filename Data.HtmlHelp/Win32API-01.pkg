Use UI

// https://learn.microsoft.com/windows/win32/api/htmlhelp/nf-htmlhelp-htmlhelpa
External_Function HtmlHelpA "HtmlHelpA" hhctrl.ocx ;
	Pointer hwndCaller ;	// HWND
	String pszFile ;	// PSTR
	UInteger uCommand ;
	ULongPtr dwData ;
	Returns Pointer	// HWND

// https://learn.microsoft.com/windows/win32/api/htmlhelp/nf-htmlhelp-htmlhelpw
External_Function HtmlHelpW "HtmlHelpW" hhctrl.ocx ;
	Pointer hwndCaller ;	// HWND
	WString pszFile ;	// PWSTR
	UInteger uCommand ;
	ULongPtr dwData ;
	Returns Pointer	// HWND


Procedure DataFlex_Init
End_Procedure

