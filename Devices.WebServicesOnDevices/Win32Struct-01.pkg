	Pointer Next											// WSDXML_ATTRIBUTE*
	Pointer Name											// WSDXML_NAME*
	Pointer Value											// PWSTR
End_Struct

// https://learn.microsoft.com/windows/win32/api/wsdxmldom/ns-wsdxmldom-wsdxml_element
Struct WSDXML_ELEMENT
