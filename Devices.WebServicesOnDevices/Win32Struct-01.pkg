	Pointer Name											// WSDXML_NAME*
	Pointer FirstAttribute									// WSDXML_ATTRIBUTE*
	Pointer FirstChild										// WSDXML_NODE*
	Pointer PrefixMappings									// WSDXML_PREFIX_MAPPING*
End_Struct

// https://learn.microsoft.com/windows/win32/api/wsdxmldom/ns-wsdxmldom-wsdxml_name
Struct WSDXML_NAME
