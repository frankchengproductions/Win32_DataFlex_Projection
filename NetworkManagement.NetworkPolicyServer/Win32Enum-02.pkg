Use UI

// Define RADIUS_CODE For Integer
Enum_List
	Define rcUnknown										For |CI$00000000
	Define rcAccessRequest									For |CI$00000001
	Define rcAccessAccept									For |CI$00000002
	Define rcAccessReject									For |CI$00000003
	Define rcAccountingRequest								For |CI$00000004
	Define rcAccountingResponse								For |CI$00000005
	Define rcAccessChallenge								For |CI$0000000B
	Define rcDiscard										For |CI$00000100
End_Enum_List

// Define RADIUS_AUTHENTICATION_PROVIDER For Integer
Enum_List
	Define rapUnknown										For |CI$00000000
	Define rapUsersFile										For |CI$00000001
	Define rapProxy											For |CI$00000002
	Define rapWindowsNT										For |CI$00000003
	Define rapMCIS											For |CI$00000004
	Define rapODBC											For |CI$00000005
	Define rapNone											For |CI$00000006
End_Enum_List

// Define RADIUS_REJECT_REASON_CODE For Integer
Enum_List
	Define rrrcUndefined									For |CI$00000000
	Define rrrcAccountUnknown								For |CI$00000001
	Define rrrcAccountDisabled								For |CI$00000002
	Define rrrcAccountExpired								For |CI$00000003
	Define rrrcAuthenticationFailure						For |CI$00000004
End_Enum_List

// Define RADIUS_DATA_TYPE For Integer
Enum_List
	Define rdtUnknown										For |CI$00000000
	Define rdtString										For |CI$00000001
	Define rdtAddress										For |CI$00000002
	Define rdtInteger										For |CI$00000003
	Define rdtTime											For |CI$00000004
	Define rdtIpv6Address									For |CI$00000005
End_Enum_List

// Define RADIUS_ACTION For Integer
Enum_List
	Define raContinue										For |CI$00000000
	Define raReject											For |CI$00000001
	Define raAccept											For |CI$00000002
End_Enum_List

// Define RADIUS_EXTENSION_POINT For Integer
Enum_List
	Define repAuthentication								For |CI$00000000
	Define repAuthorization									For |CI$00000001
End_Enum_List


Procedure DataFlex_Init
End_Procedure

