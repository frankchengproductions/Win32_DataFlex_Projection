Use UI

// Define RADIUS_CODE For Integer
Enum_List
	Define rcUnknown										For 0
	Define rcAccessRequest									For 1
	Define rcAccessAccept									For 2
	Define rcAccessReject									For 3
	Define rcAccountingRequest								For 4
	Define rcAccountingResponse								For 5
	Define rcAccessChallenge								For 11
	Define rcDiscard										For 256
End_Enum_List

// Define RADIUS_AUTHENTICATION_PROVIDER For Integer
Enum_List
	Define rapUnknown										For 0
	Define rapUsersFile										For 1
	Define rapProxy											For 2
	Define rapWindowsNT										For 3
	Define rapMCIS											For 4
	Define rapODBC											For 5
	Define rapNone											For 6
End_Enum_List

// Define RADIUS_REJECT_REASON_CODE For Integer
Enum_List
	Define rrrcUndefined									For 0
	Define rrrcAccountUnknown								For 1
	Define rrrcAccountDisabled								For 2
	Define rrrcAccountExpired								For 3
	Define rrrcAuthenticationFailure						For 4
End_Enum_List

// Define RADIUS_DATA_TYPE For Integer
Enum_List
	Define rdtUnknown										For 0
	Define rdtString										For 1
	Define rdtAddress										For 2
	Define rdtInteger										For 3
	Define rdtTime											For 4
	Define rdtIpv6Address									For 5
End_Enum_List

// Define RADIUS_ACTION For Integer
Enum_List
	Define raContinue										For 0
	Define raReject											For 1
	Define raAccept											For 2
End_Enum_List

// Define RADIUS_EXTENSION_POINT For Integer
Enum_List
	Define repAuthentication								For 0
	Define repAuthorization									For 1
End_Enum_List


Procedure DataFlex_Init
End_Procedure

