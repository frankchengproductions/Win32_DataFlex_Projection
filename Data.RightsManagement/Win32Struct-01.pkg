Struct DRMBOUNDLICENSEPARAMS
	UInteger uVersion
	UInteger hEnablingPrincipal
	UInteger hSecureStore
	Integer iMissingAlignment1
	Pointer wszRightsRequested								// PWSTR
	Pointer wszRightsGroup									// PWSTR
	DRMID idResource
	UInteger cAuthenticatorCount
	Integer iMissingAlignment2
	Pointer rghAuthenticators								// UInteger*
	Pointer wszDefaultEnablingPrincipalCredentials			// PWSTR
	UInteger dwFlags
	Integer iMissingAlignment3
End_Struct

// https://learn.microsoft.com/windows/win32/api/msdrmdefs/ns-msdrmdefs-drmid
Struct DRMID
	UInteger uVersion
	Integer iMissingAlignment1
	Pointer wszIDType										// PWSTR
	Pointer wszID											// PWSTR
End_Struct

// https://learn.microsoft.com/windows/win32/api/msdrmdefs/ns-msdrmdefs-drm_actserv_info
Struct DRM_ACTSERV_INFO
	UInteger uVersion
	Integer iMissingAlignment1
	Pointer wszPubKey										// PWSTR
	Pointer wszURL											// PWSTR
End_Struct

// https://learn.microsoft.com/windows/win32/api/msdrmdefs/ns-msdrmdefs-drm_client_version_info
Struct DRM_CLIENT_VERSION_INFO
	UInteger uStructVersion
	UInteger[4] dwVersion
	UShort[256] wszHierarchy
	UShort[256] wszProductId
	UShort[256] wszProductDescription
End_Struct


