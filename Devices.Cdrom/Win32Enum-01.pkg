Use UI

// Define TRACK_MODE_TYPE For Integer
Enum_List
	Define YellowMode2										For 0
	Define XAForm2											For 1
	Define CDDA												For 2
	Define RawWithC2AndSubCode								For 3
	Define RawWithC2										For 4
	Define RawWithSubCode									For 5
End_Enum_List

// Define MEDIA_BLANK_TYPE For Integer
Enum_List
	Define MediaBlankTypeFull								For 0
	Define MediaBlankTypeMinimal							For 1
	Define MediaBlankTypeIncompleteTrack					For 2
	Define MediaBlankTypeUnreserveLastTrack					For 3
	Define MediaBlankTypeTrackTail							For 4
	Define MediaBlankTypeUncloseLastSession					For 5
	Define MediaBlankTypeEraseLastSession					For 6
End_Enum_List

// Define EXCLUSIVE_ACCESS_REQUEST_TYPE For Integer
Enum_List
	Define ExclusiveAccessQueryState						For 0
	Define ExclusiveAccessLockDevice						For 1
	Define ExclusiveAccessUnlockDevice						For 2
End_Enum_List

// Define CDROM_SPEED_REQUEST For Integer
Enum_List
	Define CdromSetSpeed									For 0
	Define CdromSetStreaming								For 1
End_Enum_List

// Define WRITE_ROTATION For Integer
Enum_List
	Define CdromDefaultRotation								For 0
	Define CdromCAVRotation									For 1
End_Enum_List

// Define STREAMING_CONTROL_REQUEST_TYPE For Integer
Enum_List
	Define CdromStreamingDisable							For 1
	Define CdromStreamingEnableForReadOnly					For 2
	Define CdromStreamingEnableForWriteOnly					For 3
	Define CdromStreamingEnableForReadWrite					For 4
End_Enum_List

// Define CDROM_OPC_INFO_TYPE For Integer
Enum_List
	Define SimpleOpcInfo									For 1
End_Enum_List

// Define CDROM_PERFORMANCE_REQUEST_TYPE For Integer
Enum_List
	Define CdromPerformanceRequest							For 1
	Define CdromWriteSpeedRequest							For 2
End_Enum_List

// Define CDROM_PERFORMANCE_TYPE For Integer
Enum_List
	Define CdromReadPerformance								For 1
	Define CdromWritePerformance							For 2
End_Enum_List

// Define CDROM_PERFORMANCE_EXCEPTION_TYPE For Integer
Enum_List
	Define CdromNominalPerformance							For 1
	Define CdromEntirePerformanceList						For 2
	Define CdromPerformanceExceptionsOnly					For 3
End_Enum_List

// Define CDROM_PERFORMANCE_TOLERANCE_TYPE For Integer
Enum_List
	Define Cdrom10Nominal20Exceptions						For 1
End_Enum_List


Procedure DataFlex_Init
End_Procedure

