End_Enum_List

// Define EC_SUBSCRIPTION_TYPE For Integer
Enum_List
	Define EcSubscriptionTypeSourceInitiated				For 0
	Define EcSubscriptionTypeCollectorInitiated				For 1
End_Enum_List

// Define EC_VARIANT_TYPE For Integer
Enum_List
	Define EcVarTypeNull									For 0
