End_Enum_List

// Define EC_SUBSCRIPTION_RUNTIME_STATUS_INFO_ID For Integer
Enum_List
	Define EcSubscriptionRunTimeStatusActive				For 0
	Define EcSubscriptionRunTimeStatusLastError				For 1
	Define EcSubscriptionRunTimeStatusLastErrorMessage		For 2
	Define EcSubscriptionRunTimeStatusLastErrorTime			For 3
	Define EcSubscriptionRunTimeStatusNextRetryTime			For 4
	Define EcSubscriptionRunTimeStatusEventSources			For 5
	Define EcSubscriptionRunTimeStatusLastHeartbeatTime		For 6
	Define EcSubscriptionRunTimeStatusInfoIdEND				For 7
End_Enum_List

// Define EC_SUBSCRIPTION_CREDENTIALS_TYPE For Integer
Enum_List
	Define EcSubscriptionCredDefault						For 0
	Define EcSubscriptionCredNegotiate						For 1
	Define EcSubscriptionCredDigest							For 2
	Define EcSubscriptionCredBasic							For 3
