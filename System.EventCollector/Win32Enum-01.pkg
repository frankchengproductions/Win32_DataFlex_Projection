	Define EcSubscriptionEventSourceAddress					For 2
	Define EcSubscriptionEventSourceEnabled					For 3
	Define EcSubscriptionEventSourceUserName				For 4
	Define EcSubscriptionEventSourcePassword				For 5
	Define EcSubscriptionDescription						For 6
	Define EcSubscriptionURI								For 7
	Define EcSubscriptionConfigurationMode					For 8
	Define EcSubscriptionExpires							For 9
	Define EcSubscriptionQuery								For 10
	Define EcSubscriptionTransportName						For 11
	Define EcSubscriptionTransportPort						For 12
	Define EcSubscriptionDeliveryMode						For 13
	Define EcSubscriptionDeliveryMaxItems					For 14
	Define EcSubscriptionDeliveryMaxLatencyTime				For 15
	Define EcSubscriptionHeartbeatInterval					For 16
	Define EcSubscriptionLocale								For 17
	Define EcSubscriptionContentFormat						For 18
	Define EcSubscriptionLogFile							For 19
	Define EcSubscriptionPublisherName						For 20
	Define EcSubscriptionCredentialsType					For 21
	Define EcSubscriptionCommonUserName						For 22
	Define EcSubscriptionCommonPassword						For 23
	Define EcSubscriptionHostName							For 24
	Define EcSubscriptionReadExistingEvents					For 25
	Define EcSubscriptionDialect							For 26
