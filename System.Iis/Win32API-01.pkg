Use UI

External_Function GetExtensionVersion "GetExtensionVersion" RpcProxy.dll ;
	Pointer pVer ;	// HSE_VERSION_INFO*
	Returns Integer	// BOOL

External_Function GetFilterVersion "GetFilterVersion" RpcProxy.dll ;
	Pointer pVer ;	// HTTP_FILTER_VERSION*
	Returns Integer	// BOOL

External_Function HttpExtensionProc "HttpExtensionProc" RpcProxy.dll ;
	Pointer pECB ;	// EXTENSION_CONTROL_BLOCK*
	Returns UInteger

External_Function HttpFilterProc "HttpFilterProc" RpcProxy.dll ;
	Pointer pfc ;	// HTTP_FILTER_CONTEXT*
	UInteger NotificationType ;
	Pointer pvNotification ;	// Pointer*
	Returns UInteger


Procedure DataFlex_Init
End_Procedure

