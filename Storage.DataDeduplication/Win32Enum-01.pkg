Use UI

// Define DEDUP_BACKUP_SUPPORT_PARAM_TYPE For Integer
Enum_List
	Define DEDUP_RECONSTRUCT_UNOPTIMIZED					For 1
	Define DEDUP_RECONSTRUCT_OPTIMIZED						For 2
End_Enum_List

// Define DEDUP_SET_PARAM_TYPE For Integer
Enum_List
	Define DEDUP_PT_MinChunkSizeBytes						For 1
	Define DEDUP_PT_MaxChunkSizeBytes						For 2
	Define DEDUP_PT_AvgChunkSizeBytes						For 3
	Define DEDUP_PT_InvariantChunking						For 4
	Define DEDUP_PT_DisableStrongHashComputation			For 5
End_Enum_List

// Define DedupDataPortManagerOption For Integer
Enum_List
	Define DedupDataPortManagerOption_None					For 0
	Define DedupDataPortManagerOption_AutoStart				For 1
	Define DedupDataPortManagerOption_SkipReconciliation	For 2
End_Enum_List

// Define DedupDataPortVolumeStatus For Integer
Enum_List
	Define DedupDataPortVolumeStatus_Unknown				For 0
	Define DedupDataPortVolumeStatus_NotEnabled				For 1
	Define DedupDataPortVolumeStatus_NotAvailable			For 2
	Define DedupDataPortVolumeStatus_Initializing			For 3
	Define DedupDataPortVolumeStatus_Ready					For 4
	Define DedupDataPortVolumeStatus_Maintenance			For 5
	Define DedupDataPortVolumeStatus_Shutdown				For 6
End_Enum_List

// Define DedupDataPortRequestStatus For Integer
Enum_List
	Define DedupDataPortRequestStatus_Unknown				For 0
	Define DedupDataPortRequestStatus_Queued				For 1
	Define DedupDataPortRequestStatus_Processing			For 2
	Define DedupDataPortRequestStatus_Partial				For 3
	Define DedupDataPortRequestStatus_Complete				For 4
	Define DedupDataPortRequestStatus_Failed				For 5
End_Enum_List

// Define DedupChunkFlags For Integer
Enum_List
	Define DedupChunkFlags_None								For 0
	Define DedupChunkFlags_Compressed						For 1
End_Enum_List

// Define DedupChunkingAlgorithm For Integer
Enum_List
	Define DedupChunkingAlgorithm_Unknonwn					For 0
	Define DedupChunkingAlgorithm_V1						For 1
End_Enum_List

// Define DedupHashingAlgorithm For Integer
Enum_List
	Define DedupHashingAlgorithm_Unknonwn					For 0
	Define DedupHashingAlgorithm_V1							For 1
End_Enum_List

// Define DedupCompressionAlgorithm For Integer
Enum_List
	Define DedupCompressionAlgorithm_Unknonwn				For 0
	Define DedupCompressionAlgorithm_Xpress					For 1
End_Enum_List


Procedure DataFlex_Init
End_Procedure

