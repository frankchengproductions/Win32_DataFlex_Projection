Use UI

// Define DEDUP_BACKUP_SUPPORT_PARAM_TYPE For Integer
Enum_List
	Define DEDUP_RECONSTRUCT_UNOPTIMIZED					For |CI$00000001
	Define DEDUP_RECONSTRUCT_OPTIMIZED						For |CI$00000002
End_Enum_List

// Define DEDUP_SET_PARAM_TYPE For Integer
Enum_List
	Define DEDUP_PT_MinChunkSizeBytes						For |CI$00000001
	Define DEDUP_PT_MaxChunkSizeBytes						For |CI$00000002
	Define DEDUP_PT_AvgChunkSizeBytes						For |CI$00000003
	Define DEDUP_PT_InvariantChunking						For |CI$00000004
	Define DEDUP_PT_DisableStrongHashComputation			For |CI$00000005
End_Enum_List

// Define DedupDataPortManagerOption For Integer
Enum_List
	Define DedupDataPortManagerOption_None					For |CI$00000000
	Define DedupDataPortManagerOption_AutoStart				For |CI$00000001
	Define DedupDataPortManagerOption_SkipReconciliation	For |CI$00000002
End_Enum_List

// Define DedupDataPortVolumeStatus For Integer
Enum_List
	Define DedupDataPortVolumeStatus_Unknown				For |CI$00000000
	Define DedupDataPortVolumeStatus_NotEnabled				For |CI$00000001
	Define DedupDataPortVolumeStatus_NotAvailable			For |CI$00000002
	Define DedupDataPortVolumeStatus_Initializing			For |CI$00000003
	Define DedupDataPortVolumeStatus_Ready					For |CI$00000004
	Define DedupDataPortVolumeStatus_Maintenance			For |CI$00000005
	Define DedupDataPortVolumeStatus_Shutdown				For |CI$00000006
End_Enum_List

// Define DedupDataPortRequestStatus For Integer
Enum_List
	Define DedupDataPortRequestStatus_Unknown				For |CI$00000000
	Define DedupDataPortRequestStatus_Queued				For |CI$00000001
	Define DedupDataPortRequestStatus_Processing			For |CI$00000002
	Define DedupDataPortRequestStatus_Partial				For |CI$00000003
	Define DedupDataPortRequestStatus_Complete				For |CI$00000004
	Define DedupDataPortRequestStatus_Failed				For |CI$00000005
End_Enum_List

// Define DedupChunkFlags For Integer
Enum_List
	Define DedupChunkFlags_None								For |CI$00000000
	Define DedupChunkFlags_Compressed						For |CI$00000001
End_Enum_List

// Define DedupChunkingAlgorithm For Integer
Enum_List
	Define DedupChunkingAlgorithm_Unknonwn					For |CI$00000000
	Define DedupChunkingAlgorithm_V1						For |CI$00000001
End_Enum_List

// Define DedupHashingAlgorithm For Integer
Enum_List
	Define DedupHashingAlgorithm_Unknonwn					For |CI$00000000
	Define DedupHashingAlgorithm_V1							For |CI$00000001
End_Enum_List

// Define DedupCompressionAlgorithm For Integer
Enum_List
	Define DedupCompressionAlgorithm_Unknonwn				For |CI$00000000
	Define DedupCompressionAlgorithm_Xpress					For |CI$00000001
End_Enum_List


Procedure DataFlex_Init
End_Procedure

