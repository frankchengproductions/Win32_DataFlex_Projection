Use UI

// https://learn.microsoft.com/windows/win32/api/aclui/nf-aclui-createsecuritypage
External_Function CreateSecurityPage "CreateSecurityPage" ACLUI.dll ;
	Pointer psi ;	// ISecurityInformation
	Returns Pointer	// HPROPSHEETPAGE

// https://learn.microsoft.com/windows/win32/api/aclui/nf-aclui-editsecurity
External_Function EditSecurity "EditSecurity" ACLUI.dll ;
	Pointer hwndOwner ;	// HWND
	Pointer psi ;	// ISecurityInformation
	Returns Integer	// BOOL

// https://learn.microsoft.com/windows/win32/api/aclui/nf-aclui-editsecurityadvanced
External_Function EditSecurityAdvanced "EditSecurityAdvanced" ACLUI.dll ;
	Pointer hwndOwner ;	// HWND
	Pointer psi ;	// ISecurityInformation
	Integer uSIPage ;	// SI_PAGE_TYPE
	Returns Integer	// HRESULT


Procedure DataFlex_Init
End_Procedure

