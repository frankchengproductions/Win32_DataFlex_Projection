	Define SI_OWNER_ELEVATION_REQUIRED						For |CI$04000000
	Define SI_SCOPE_ELEVATION_REQUIRED						For |CI$08000000
	Define SI_MAY_WRITE										For |CI$10000000
	Define SI_ENABLE_EDIT_ATTRIBUTE_CONDITION				For |CI$20000000
	Define SI_ENABLE_CENTRAL_POLICY							For |CI$40000000
	Define SI_DISABLE_DENY_ACE								For |CV$80000000
End_Enum_List

// Define SI_PAGE_TYPE For Integer
Enum_List
	Define SI_PAGE_PERM										For |CI$00000000
	Define SI_PAGE_ADVPERM									For |CI$00000001
	Define SI_PAGE_AUDIT									For |CI$00000002
