	Define SI_SHOW_DEFAULT									For |CI$00000000
	Define SI_SHOW_PERM_ACTIVATED							For |CI$00000001
	Define SI_SHOW_AUDIT_ACTIVATED							For |CI$00000002
	Define SI_SHOW_OWNER_ACTIVATED							For |CI$00000003
