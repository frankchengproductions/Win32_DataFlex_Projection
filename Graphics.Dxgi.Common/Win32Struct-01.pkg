Use UI

Struct DXGI_GAMMA_CONTROL
	DXGI_RGB Scale
	DXGI_RGB Offset
	DXGI_RGB[1025] GammaCurve
End_Struct

Struct DXGI_GAMMA_CONTROL_CAPABILITIES
	Integer ScaleAndOffsetSupported							// BOOL
	Float MaxConvertedValue
	Float MinConvertedValue
	UInteger NumGammaControlPoints
	Float[1025] ControlPointPositions
End_Struct

// https://learn.microsoft.com/windows/win32/direct3ddxgi/dxgi-jpeg-ac-huffman-table
Struct DXGI_JPEG_AC_HUFFMAN_TABLE
	UChar[16] CodeCounts
	UChar[162] CodeValues
End_Struct

// https://learn.microsoft.com/windows/win32/direct3ddxgi/dxgi-jpeg-dc-huffman-table
Struct DXGI_JPEG_DC_HUFFMAN_TABLE
	UChar[12] CodeCounts
	UChar[12] CodeValues
End_Struct

// https://learn.microsoft.com/windows/win32/direct3ddxgi/dxgi-jpeg-quantization-table
Struct DXGI_JPEG_QUANTIZATION_TABLE
	UChar[64] Elements
End_Struct

Struct DXGI_MODE_DESC
	UInteger Width
	UInteger Height
	DXGI_RATIONAL RefreshRate
	Integer Format											// DXGI_FORMAT
	Integer ScanlineOrdering								// DXGI_MODE_SCANLINE_ORDER
	Integer Scaling											// DXGI_MODE_SCALING
End_Struct

// https://learn.microsoft.com/windows/win32/api/dxgicommon/ns-dxgicommon-dxgi_rational
Struct DXGI_RATIONAL
	UInteger Numerator
	UInteger Denominator
End_Struct

Struct DXGI_RGB
	Float Red
	Float Green
	Float Blue
End_Struct

// https://learn.microsoft.com/windows/win32/api/dxgicommon/ns-dxgicommon-dxgi_sample_desc
Struct DXGI_SAMPLE_DESC
	UInteger Count
	UInteger Quality
End_Struct


Procedure DataFlex_Init
End_Procedure
