Use UI

Struct DXGI_MODE_DESC
	UInteger Width
	UInteger Height
	DXGI_RATIONAL RefreshRate
	Integer Format											// DXGI_FORMAT
	Integer ScanlineOrdering								// DXGI_MODE_SCANLINE_ORDER
	Integer Scaling											// DXGI_MODE_SCALING
End_Struct

// https://learn.microsoft.com/windows/win32/api/dxgicommon/ns-dxgicommon-dxgi_rational
Struct DXGI_RATIONAL
	UInteger Numerator
	UInteger Denominator
End_Struct

// https://learn.microsoft.com/windows/win32/api/dxgicommon/ns-dxgicommon-dxgi_sample_desc
Struct DXGI_SAMPLE_DESC
	UInteger Count
	UInteger Quality
End_Struct


Procedure DataFlex_Init
End_Procedure

