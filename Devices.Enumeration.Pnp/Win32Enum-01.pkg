Use UI

// Define SW_DEVICE_LIFETIME For Integer
Enum_List
	Define SWDeviceLifetimeHandle							For |CI$00000000
	Define SWDeviceLifetimeParentPresent					For |CI$00000001
	Define SWDeviceLifetimeMax								For |CI$00000002
End_Enum_List

// Define SW_DEVICE_CAPABILITIES For Integer
Enum_List
	Define SWDeviceCapabilitiesNone							For |CI$00000000
	Define SWDeviceCapabilitiesRemovable					For |CI$00000001
	Define SWDeviceCapabilitiesSilentInstall				For |CI$00000002
	Define SWDeviceCapabilitiesNoDisplayInUI				For |CI$00000004
	Define SWDeviceCapabilitiesDriverRequired				For |CI$00000008
End_Enum_List


Procedure DataFlex_Init
End_Procedure

