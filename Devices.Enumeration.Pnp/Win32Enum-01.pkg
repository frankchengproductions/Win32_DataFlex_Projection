Use UI

// Define SW_DEVICE_LIFETIME For Integer
Enum_List
	Define SWDeviceLifetimeHandle							For 0
	Define SWDeviceLifetimeParentPresent					For 1
	Define SWDeviceLifetimeMax								For 2
End_Enum_List

// Define SW_DEVICE_CAPABILITIES For Integer
Enum_List
	Define SWDeviceCapabilitiesNone							For 0
	Define SWDeviceCapabilitiesRemovable					For 1
	Define SWDeviceCapabilitiesSilentInstall				For 2
	Define SWDeviceCapabilitiesNoDisplayInUI				For 4
	Define SWDeviceCapabilitiesDriverRequired				For 8
End_Enum_List


Procedure DataFlex_Init
End_Procedure

