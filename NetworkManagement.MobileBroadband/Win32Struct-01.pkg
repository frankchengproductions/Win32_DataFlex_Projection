Struct MBN_CONTEXT
	UInteger contextID
	Integer contextType										// MBN_CONTEXT_TYPE
	Pointer accessString									// BSTR
	Pointer userName										// BSTR
	Pointer password										// BSTR
	Integer compression										// MBN_COMPRESSION
	Integer authType										// MBN_AUTH_PROTOCOL
End_Struct

