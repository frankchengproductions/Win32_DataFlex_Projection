Use UI

// Define RM_APP_TYPE For Integer
Enum_List
	Define RmUnknownApp										For 0
	Define RmMainWindow										For 1
	Define RmOtherWindow									For 2
	Define RmService										For 3
	Define RmExplorer										For 4
	Define RmConsole										For 5
	Define RmCritical										For 1000
End_Enum_List

// Define RM_FILTER_ACTION For Integer
Enum_List
	Define RmInvalidFilterAction							For 0
	Define RmNoRestart										For 1
	Define RmNoShutdown										For 2
End_Enum_List

// Define RM_SHUTDOWN_TYPE For Integer
Enum_List
	Define RmForceShutdown									For 1
	Define RmShutdownOnlyRegistered							For 16
End_Enum_List

// Define RM_APP_STATUS For Integer
Enum_List
	Define RmStatusUnknown									For 0
	Define RmStatusRunning									For 1
	Define RmStatusStopped									For 2
	Define RmStatusStoppedOther								For 4
	Define RmStatusRestarted								For 8
	Define RmStatusErrorOnStop								For 16
	Define RmStatusErrorOnRestart							For 32
	Define RmStatusShutdownMasked							For 64
	Define RmStatusRestartMasked							For 128
End_Enum_List

// Define RM_REBOOT_REASON For Integer
Enum_List
	Define RmRebootReasonNone								For 0
	Define RmRebootReasonPermissionDenied					For 1
	Define RmRebootReasonSessionMismatch					For 2
	Define RmRebootReasonCriticalProcess					For 4
	Define RmRebootReasonCriticalService					For 8
	Define RmRebootReasonDetectedSelf						For 16
End_Enum_List

// Define RM_FILTER_TRIGGER For Integer
Enum_List
	Define RmFilterTriggerInvalid							For 0
	Define RmFilterTriggerFile								For 1
	Define RmFilterTriggerProcess							For 2
	Define RmFilterTriggerService							For 3
End_Enum_List


Procedure DataFlex_Init
End_Procedure

