Use UI

// Define RM_APP_TYPE For Integer
Enum_List
	Define RmUnknownApp										For |CI$00000000
	Define RmMainWindow										For |CI$00000001
	Define RmOtherWindow									For |CI$00000002
	Define RmService										For |CI$00000003
	Define RmExplorer										For |CI$00000004
	Define RmConsole										For |CI$00000005
	Define RmCritical										For |CI$000003E8
End_Enum_List

// Define RM_FILTER_ACTION For Integer
Enum_List
	Define RmInvalidFilterAction							For |CI$00000000
	Define RmNoRestart										For |CI$00000001
	Define RmNoShutdown										For |CI$00000002
End_Enum_List

// Define RM_SHUTDOWN_TYPE For Integer
Enum_List
	Define RmForceShutdown									For |CI$00000001
	Define RmShutdownOnlyRegistered							For |CI$00000010
End_Enum_List

// Define RM_APP_STATUS For Integer
Enum_List
	Define RmStatusUnknown									For |CI$00000000
	Define RmStatusRunning									For |CI$00000001
	Define RmStatusStopped									For |CI$00000002
	Define RmStatusStoppedOther								For |CI$00000004
	Define RmStatusRestarted								For |CI$00000008
	Define RmStatusErrorOnStop								For |CI$00000010
	Define RmStatusErrorOnRestart							For |CI$00000020
	Define RmStatusShutdownMasked							For |CI$00000040
	Define RmStatusRestartMasked							For |CI$00000080
End_Enum_List

// Define RM_REBOOT_REASON For Integer
Enum_List
	Define RmRebootReasonNone								For |CI$00000000
	Define RmRebootReasonPermissionDenied					For |CI$00000001
	Define RmRebootReasonSessionMismatch					For |CI$00000002
	Define RmRebootReasonCriticalProcess					For |CI$00000004
	Define RmRebootReasonCriticalService					For |CI$00000008
	Define RmRebootReasonDetectedSelf						For |CI$00000010
End_Enum_List

// Define RM_FILTER_TRIGGER For Integer
Enum_List
	Define RmFilterTriggerInvalid							For |CI$00000000
	Define RmFilterTriggerFile								For |CI$00000001
	Define RmFilterTriggerProcess							For |CI$00000002
	Define RmFilterTriggerService							For |CI$00000003
End_Enum_List


Procedure DataFlex_Init
End_Procedure

