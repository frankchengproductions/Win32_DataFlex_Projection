Use UI

// Define HANDLE_OPTIONS For UInteger
Enum_List
	Define HO_NONE											For |CI$00000000
	Define HO_OPEN_REQUIRING_OPLOCK							For |CI$00040000
	Define HO_DELETE_ON_CLOSE								For |CI$04000000
	Define HO_SEQUENTIAL_SCAN								For |CI$08000000
	Define HO_RANDOM_ACCESS									For |CI$10000000
	Define HO_NO_BUFFERING									For |CI$20000000
	Define HO_OVERLAPPED									For |CI$40000000
	Define HO_WRITE_THROUGH									For |CV$80000000
End_Enum_List

// Define HANDLE_ACCESS_OPTIONS For Integer
Enum_List
	Define HAO_NONE											For |CI$00000000
	Define HAO_READ_ATTRIBUTES								For |CI$00000080
	Define HAO_DELETE										For |CI$00010000
	Define HAO_READ											For |CI$00120089
	Define HAO_WRITE										For |CI$00120116
End_Enum_List

// Define HANDLE_SHARING_OPTIONS For Integer
Enum_List
	Define HSO_SHARE_NONE									For |CI$00000000
	Define HSO_SHARE_READ									For |CI$00000001
	Define HSO_SHARE_WRITE									For |CI$00000002
	Define HSO_SHARE_DELETE									For |CI$00000004
End_Enum_List

// Define HANDLE_CREATION_OPTIONS For Integer
Enum_List
	Define HCO_CREATE_NEW									For |CI$00000001
	Define HCO_CREATE_ALWAYS								For |CI$00000002
	Define HCO_OPEN_EXISTING								For |CI$00000003
	Define HCO_OPEN_ALWAYS									For |CI$00000004
	Define HCO_TRUNCATE_EXISTING							For |CI$00000005
End_Enum_List


Procedure DataFlex_Init
End_Procedure

