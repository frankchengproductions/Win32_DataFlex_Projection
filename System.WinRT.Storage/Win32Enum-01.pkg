Use UI

// Define HANDLE_OPTIONS For UInteger
Enum_List
	Define HO_NONE											For 0
	Define HO_OPEN_REQUIRING_OPLOCK							For 262144
	Define HO_DELETE_ON_CLOSE								For 67108864
	Define HO_SEQUENTIAL_SCAN								For 134217728
	Define HO_RANDOM_ACCESS									For 268435456
	Define HO_NO_BUFFERING									For 536870912
	Define HO_OVERLAPPED									For 1073741824
	Define HO_WRITE_THROUGH									For 2147483648
End_Enum_List

// Define HANDLE_ACCESS_OPTIONS For Integer
Enum_List
	Define HAO_NONE											For 0
	Define HAO_READ_ATTRIBUTES								For 128
	Define HAO_READ											For 1179785
	Define HAO_WRITE										For 1179926
	Define HAO_DELETE										For 65536
End_Enum_List

// Define HANDLE_SHARING_OPTIONS For Integer
Enum_List
	Define HSO_SHARE_NONE									For 0
	Define HSO_SHARE_READ									For 1
	Define HSO_SHARE_WRITE									For 2
	Define HSO_SHARE_DELETE									For 4
End_Enum_List

// Define HANDLE_CREATION_OPTIONS For Integer
Enum_List
	Define HCO_CREATE_NEW									For 1
	Define HCO_CREATE_ALWAYS								For 2
	Define HCO_OPEN_EXISTING								For 3
	Define HCO_OPEN_ALWAYS									For 4
	Define HCO_TRUNCATE_EXISTING							For 5
End_Enum_List


Procedure DataFlex_Init
End_Procedure

