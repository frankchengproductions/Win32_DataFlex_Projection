Use UI

// Define HrtfDistanceDecayType For Integer
Enum_List
	Define NaturalDecay										For 0
	Define CustomDecay										For 1
End_Enum_List

// Define HrtfDirectivityType For Integer
Enum_List
	Define OmniDirectional									For 0
	Define Cardioid											For 1
	Define Cone												For 2
End_Enum_List

// Define XAPO_BUFFER_FLAGS For Integer
Enum_List
	Define XAPO_BUFFER_SILENT								For 0
	Define XAPO_BUFFER_VALID								For 1
End_Enum_List

// Define XAUDIO2_FILTER_TYPE For Integer
Enum_List
	Define LowPassFilter									For 0
	Define BandPassFilter									For 1
	Define HighPassFilter									For 2
	Define NotchFilter										For 3
	Define LowPassOnePoleFilter								For 4
	Define HighPassOnePoleFilter							For 5
End_Enum_List

// Define HrtfEnvironment For Integer
Enum_List
	Define Small											For 0
	Define Medium											For 1
	Define Large											For 2
	Define Outdoors											For 3
End_Enum_List


Procedure DataFlex_Init
End_Procedure

