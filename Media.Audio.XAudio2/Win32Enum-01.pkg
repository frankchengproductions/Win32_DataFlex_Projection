Use UI

// Define HrtfDistanceDecayType For Integer
Enum_List
	Define NaturalDecay										For |CI$00000000
	Define CustomDecay										For |CI$00000001
End_Enum_List

// Define HrtfDirectivityType For Integer
Enum_List
	Define OmniDirectional									For |CI$00000000
	Define Cardioid											For |CI$00000001
	Define Cone												For |CI$00000002
End_Enum_List

// Define XAPO_BUFFER_FLAGS For Integer
Enum_List
	Define XAPO_BUFFER_SILENT								For |CI$00000000
	Define XAPO_BUFFER_VALID								For |CI$00000001
End_Enum_List

// Define XAUDIO2_FILTER_TYPE For Integer
Enum_List
	Define LowPassFilter									For |CI$00000000
	Define BandPassFilter									For |CI$00000001
	Define HighPassFilter									For |CI$00000002
	Define NotchFilter										For |CI$00000003
	Define LowPassOnePoleFilter								For |CI$00000004
	Define HighPassOnePoleFilter							For |CI$00000005
End_Enum_List

// Define HrtfEnvironment For Integer
Enum_List
	Define Small											For |CI$00000000
	Define Medium											For |CI$00000001
	Define Large											For |CI$00000002
	Define Outdoors											For |CI$00000003
End_Enum_List


Procedure DataFlex_Init
End_Procedure

