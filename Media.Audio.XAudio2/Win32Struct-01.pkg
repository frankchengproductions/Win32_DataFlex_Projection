Use UI

// https://learn.microsoft.com/windows/win32/api/hrtfapoapi/ns-hrtfapoapi-hrtfapoinit
Struct HrtfApoInit
	Pointer distanceDecay									// HrtfDistanceDecay*
	Pointer directivity										// HrtfDirectivity*
End_Struct

// https://learn.microsoft.com/windows/win32/api/hrtfapoapi/ns-hrtfapoapi-hrtfdirectivity
Struct HrtfDirectivity
	Integer type											// HrtfDirectivityType
	Float scaling
End_Struct

// https://learn.microsoft.com/windows/win32/api/hrtfapoapi/ns-hrtfapoapi-hrtfdistancedecay
Struct HrtfDistanceDecay
	Integer type											// HrtfDistanceDecayType
	Float maxGain
	Float minGain
	Float unityGainDistance
	Float cutoffDistance
End_Struct


Procedure DataFlex_Init
End_Procedure

