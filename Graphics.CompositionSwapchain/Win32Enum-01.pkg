Use UI

// Define PresentStatisticsKind For Integer
Enum_List
	Define PresentStatisticsKind_PresentStatus				For |CI$00000001
	Define PresentStatisticsKind_CompositionFrame			For |CI$00000002
	Define PresentStatisticsKind_IndependentFlipFrame		For |CI$00000003
End_Enum_List

// Define PresentStatus For Integer
Enum_List
	Define PresentStatus_Queued								For |CI$00000000
	Define PresentStatus_Skipped							For |CI$00000001
	Define PresentStatus_Canceled							For |CI$00000002
End_Enum_List

// Define CompositionFrameInstanceKind For Integer
Enum_List
	Define CompositionFrameInstanceKind_ComposedOnScreen	For |CI$00000000
	Define CompositionFrameInstanceKind_ScanoutOnScreen		For |CI$00000001
	Define CompositionFrameInstanceKind_ComposedToIntermediate	For |CI$00000002
End_Enum_List


Procedure DataFlex_Init
End_Procedure

