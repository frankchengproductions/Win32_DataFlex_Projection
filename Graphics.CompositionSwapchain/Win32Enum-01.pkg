Use UI

// Define PresentStatisticsKind For Integer
Enum_List
	Define PresentStatisticsKind_PresentStatus				For 1
	Define PresentStatisticsKind_CompositionFrame			For 2
	Define PresentStatisticsKind_IndependentFlipFrame		For 3
End_Enum_List

// Define PresentStatus For Integer
Enum_List
	Define PresentStatus_Queued								For 0
	Define PresentStatus_Skipped							For 1
	Define PresentStatus_Canceled							For 2
End_Enum_List

// Define CompositionFrameInstanceKind For Integer
Enum_List
	Define CompositionFrameInstanceKind_ComposedOnScreen	For 0
	Define CompositionFrameInstanceKind_ScanoutOnScreen		For 1
	Define CompositionFrameInstanceKind_ComposedToIntermediate	For 2
End_Enum_List


Procedure DataFlex_Init
End_Procedure

