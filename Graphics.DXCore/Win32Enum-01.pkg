Use UI

// Define DXCoreAdapterProperty For UInteger
Enum_List
	Define InstanceLuid										For 0
	Define DXCoreAdapterProperty_DriverVersion				For 1
	Define DriverDescription								For 2
	Define HardwareID										For 3
	Define KmdModelVersion									For 4
	Define ComputePreemptionGranularity						For 5
	Define GraphicsPreemptionGranularity					For 6
	Define DedicatedAdapterMemory							For 7
	Define DedicatedSystemMemory							For 8
	Define SharedSystemMemory								For 9
	Define AcgCompatible									For 10
	Define IsHardware										For 11
	Define IsIntegrated										For 12
	Define IsDetachable										For 13
	Define HardwareIDParts									For 14
	Define PhysicalAdapterCount								For 15
	Define AdapterEngineCount								For 16
	Define AdapterEngineName								For 17
End_Enum_List

// Define DXCoreAdapterState For UInteger
Enum_List
	Define IsDriverUpdateInProgress							For 0
	Define AdapterMemoryBudget								For 1
	Define AdapterMemoryUsageBytes							For 2
	Define AdapterMemoryUsageByProcessBytes					For 3
	Define AdapterEngineRunningTimeMicroseconds				For 4
	Define AdapterEngineRunningTimeByProcessMicroseconds	For 5
	Define AdapterTemperatureCelsius						For 6
	Define AdapterInUseProcessCount							For 7
	Define AdapterInUseProcessSet							For 8
	Define AdapterEngineFrequencyHertz						For 9
	Define AdapterMemoryFrequencyHertz						For 10
End_Enum_List

// Define DXCoreSegmentGroup For UInteger
Enum_List
	Define Local											For 0
	Define NonLocal											For 1
End_Enum_List

// Define DXCoreNotificationType For UInteger
Enum_List
	Define AdapterListStale									For 0
	Define AdapterNoLongerValid								For 1
	Define AdapterBudgetChange								For 2
	Define AdapterHardwareContentProtectionTeardown			For 3
End_Enum_List

// Define DXCoreAdapterPreference For UInteger
Enum_List
	Define Hardware											For 0
	Define MinimumPower										For 1
	Define HighPerformance									For 2
End_Enum_List

// Define DXCoreWorkload For UInteger
Enum_List
	Define Graphics											For 0
	Define Compute											For 1
	Define Media											For 2
	Define MachineLearning									For 3
End_Enum_List

// Define DXCoreRuntimeFilterFlags For UInteger
Enum_List
	Define DXCoreRuntimeFilterFlags_None					For 0
	Define D3D11											For 1
	Define D3D12											For 2
End_Enum_List

// Define DXCoreHardwareTypeFilterFlags For UInteger
Enum_List
	Define DXCoreHardwareTypeFilterFlags_None				For 0
	Define GPU												For 1
	Define ComputeAccelerator								For 2
	Define NPU												For 4
	Define MediaAccelerator									For 8
End_Enum_List

// Define DXCoreMemoryType For UInteger
Enum_List
	Define Dedicated										For 0
	Define Shared											For 1
End_Enum_List


Procedure DataFlex_Init
End_Procedure

