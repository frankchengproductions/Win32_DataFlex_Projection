Use UI

// Define OPC_URI_TARGET_MODE For Integer
Enum_List
	Define OPC_URI_TARGET_MODE_INTERNAL						For 0
	Define OPC_URI_TARGET_MODE_EXTERNAL						For 1
End_Enum_List

// Define OPC_COMPRESSION_OPTIONS For Integer
Enum_List
	Define OPC_COMPRESSION_NONE								For -1
	Define OPC_COMPRESSION_NORMAL							For 0
	Define OPC_COMPRESSION_MAXIMUM							For 1
	Define OPC_COMPRESSION_FAST								For 2
	Define OPC_COMPRESSION_SUPERFAST						For 3
End_Enum_List

// Define OPC_STREAM_IO_MODE For Integer
Enum_List
	Define OPC_STREAM_IO_READ								For 1
	Define OPC_STREAM_IO_WRITE								For 2
End_Enum_List

// Define OPC_READ_FLAGS For Integer
Enum_List
	Define OPC_READ_DEFAULT									For 0
	Define OPC_VALIDATE_ON_LOAD								For 1
	Define OPC_CACHE_ON_ACCESS								For 2
End_Enum_List

// Define OPC_WRITE_FLAGS For Integer
Enum_List
	Define OPC_WRITE_DEFAULT								For 0
	Define OPC_WRITE_FORCE_ZIP32							For 1
End_Enum_List

// Define OPC_SIGNATURE_VALIDATION_RESULT For Integer
Enum_List
	Define OPC_SIGNATURE_VALID								For 0
	Define OPC_SIGNATURE_INVALID							For -1
End_Enum_List

// Define OPC_CANONICALIZATION_METHOD For Integer
Enum_List
	Define OPC_CANONICALIZATION_NONE						For 0
	Define OPC_CANONICALIZATION_C14N						For 1
	Define OPC_CANONICALIZATION_C14N_WITH_COMMENTS			For 2
End_Enum_List

// Define OPC_RELATIONSHIP_SELECTOR For Integer
Enum_List
	Define OPC_RELATIONSHIP_SELECT_BY_ID					For 0
	Define OPC_RELATIONSHIP_SELECT_BY_TYPE					For 1
End_Enum_List

// Define OPC_RELATIONSHIPS_SIGNING_OPTION For Integer
Enum_List
	Define OPC_RELATIONSHIP_SIGN_USING_SELECTORS			For 0
	Define OPC_RELATIONSHIP_SIGN_PART						For 1
End_Enum_List

// Define OPC_CERTIFICATE_EMBEDDING_OPTION For Integer
Enum_List
	Define OPC_CERTIFICATE_IN_CERTIFICATE_PART				For 0
	Define OPC_CERTIFICATE_IN_SIGNATURE_PART				For 1
	Define OPC_CERTIFICATE_NOT_EMBEDDED						For 2
End_Enum_List

// Define OPC_SIGNATURE_TIME_FORMAT For Integer
Enum_List
	Define OPC_SIGNATURE_TIME_FORMAT_MILLISECONDS			For 0
	Define OPC_SIGNATURE_TIME_FORMAT_SECONDS				For 1
	Define OPC_SIGNATURE_TIME_FORMAT_MINUTES				For 2
	Define OPC_SIGNATURE_TIME_FORMAT_DAYS					For 3
	Define OPC_SIGNATURE_TIME_FORMAT_MONTHS					For 4
	Define OPC_SIGNATURE_TIME_FORMAT_YEARS					For 5
End_Enum_List


Procedure DataFlex_Init
End_Procedure

