Use UI

// https://learn.microsoft.com/windows/win32/api/msxml6/ns-msxml6-xhr_cert
Struct XHR_CERT
	UInteger cbCert
	Integer iMissingAlignment1
	Pointer pbCert											// UChar*
End_Struct

// https://learn.microsoft.com/windows/win32/api/msxml6/ns-msxml6-xhr_cookie
Struct XHR_COOKIE
	Pointer pwszUrl											// PWSTR
	Pointer pwszName										// PWSTR
	Pointer pwszValue										// PWSTR
	Pointer pwszP3PPolicy									// PWSTR
	FILETIME ftExpires
	UInteger dwFlags
	Integer iMissingAlignment1
End_Struct

Struct XML_ERROR
	UInteger _nLine
	Integer iMissingAlignment1
	Pointer _pchBuf											// BSTR
	UInteger _cchBuf
	UInteger _ich
	Pointer _pszFound										// BSTR
	Pointer _pszExpected									// BSTR
	UInteger _reserved1
	UInteger _reserved2
End_Struct

Struct __msxml6_ReferenceRemainingTypes__
	Integer __tagDomNodeType__								// DOMNodeType
	Integer __domNodeType__									// DOMNodeType
	Integer __serverXmlHttpOptionEnum__						// SERVERXMLHTTP_OPTION
	Integer __serverXmlHttpOption__							// SERVERXMLHTTP_OPTION
	Integer __serverCertOptionEnum__						// SXH_SERVER_CERT_OPTION
	Integer __serverCertOption__							// SXH_SERVER_CERT_OPTION
	Integer __proxySettingEnum__							// SXH_PROXY_SETTING
	Integer __proxySetting__								// SXH_PROXY_SETTING
	Integer __somItemTypeEnum__								// SOMITEMTYPE
	Integer __somItemType__									// SOMITEMTYPE
	Integer __schemaUseEnum__								// SCHEMAUSE
	Integer __schemaUse__									// SCHEMAUSE
	Integer __schemaDerivationMethodEnum__					// SCHEMADERIVATIONMETHOD
	Integer __schemaDerivationMethod__						// SCHEMADERIVATIONMETHOD
	Integer __schemaContentTypeEnum__						// SCHEMACONTENTTYPE
	Integer __schemaContentType__							// SCHEMACONTENTTYPE
	Integer __schemaProcessContentsEnum__					// SCHEMAPROCESSCONTENTS
	Integer __schemaProcessContents__						// SCHEMAPROCESSCONTENTS
	Integer __schemaWhitespaceEnum__						// SCHEMAWHITESPACE
	Integer __schemaWhitespace__							// SCHEMAWHITESPACE
	Integer __schemaTypeVarietyEnum__						// SCHEMATYPEVARIETY
	Integer __schemaTypeVariety__							// SCHEMATYPEVARIETY
End_Struct


Procedure DataFlex_Init
