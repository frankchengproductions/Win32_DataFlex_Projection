Use UI

Struct HIT_LOGGING_INFO
	UInteger dwStructSize
	Integer iMissingAlignment1
	Pointer lpszLoggedUrlName								// PSTR
	SYSTEMTIME StartTime
	SYSTEMTIME EndTime
	Pointer lpszExtendedInfo								// PSTR
End_Struct

// https://learn.microsoft.com/windows/win32/api/urlmon/ns-urlmon-softdistinfo
Struct SOFTDISTINFO
	UInteger cbSize
	UInteger dwFlags
	UInteger dwAdState
	Integer iMissingAlignment1
	Pointer szTitle											// PWSTR
	Pointer szAbstract										// PWSTR
	Pointer szHREF											// PWSTR
	UInteger dwInstalledVersionMS
	UInteger dwInstalledVersionLS
	UInteger dwUpdateVersionMS
	UInteger dwUpdateVersionLS
	UInteger dwAdvertisedVersionMS
	UInteger dwAdvertisedVersionLS
	UInteger dwReserved
	Integer iMissingAlignment2
End_Struct


Procedure DataFlex_Init
End_Procedure

