	Define GPIO_BUTTON_CAMERA_FOCUS							For |CI$00000007
	Define GPIO_BUTTON_CAMERA_SHUTTER						For |CI$00000008
	Define GPIO_BUTTON_RINGER_TOGGLE						For |CI$00000009
