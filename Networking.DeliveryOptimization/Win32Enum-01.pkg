Use UI

// Define DODownloadState For Integer
Enum_List
	Define DODownloadState_Created							For 0
	Define DODownloadState_Transferring						For 1
	Define DODownloadState_Transferred						For 2
	Define DODownloadState_Finalized						For 3
	Define DODownloadState_Aborted							For 4
	Define DODownloadState_Paused							For 5
End_Enum_List

// Define DODownloadCostPolicy For Integer
Enum_List
	Define DODownloadCostPolicy_Always						For 0
	Define DODownloadCostPolicy_Unrestricted				For 1
	Define DODownloadCostPolicy_Standard					For 2
	Define DODownloadCostPolicy_NoRoaming					For 3
	Define DODownloadCostPolicy_NoSurcharge					For 4
	Define DODownloadCostPolicy_NoCellular					For 5
End_Enum_List

// Define DODownloadProperty For Integer
Enum_List
	Define DODownloadProperty_Id							For 0
	Define DODownloadProperty_Uri							For 1
	Define DODownloadProperty_ContentId						For 2
	Define DODownloadProperty_DisplayName					For 3
	Define DODownloadProperty_LocalPath						For 4
	Define DODownloadProperty_HttpCustomHeaders				For 5
	Define DODownloadProperty_CostPolicy					For 6
	Define DODownloadProperty_SecurityFlags					For 7
	Define DODownloadProperty_CallbackFreqPercent			For 8
	Define DODownloadProperty_CallbackFreqSeconds			For 9
	Define DODownloadProperty_NoProgressTimeoutSeconds		For 10
	Define DODownloadProperty_ForegroundPriority			For 11
	Define DODownloadProperty_BlockingMode					For 12
	Define DODownloadProperty_CallbackInterface				For 13
	Define DODownloadProperty_StreamInterface				For 14
	Define DODownloadProperty_SecurityContext				For 15
	Define DODownloadProperty_NetworkToken					For 16
	Define DODownloadProperty_CorrelationVector				For 17
	Define DODownloadProperty_DecryptionInfo				For 18
	Define DODownloadProperty_IntegrityCheckInfo			For 19
	Define DODownloadProperty_IntegrityCheckMandatory		For 20
	Define DODownloadProperty_TotalSizeBytes				For 21
	Define DODownloadProperty_DisallowOnCellular			For 22
	Define DODownloadProperty_HttpCustomAuthHeaders			For 23
	Define DODownloadProperty_HttpAllowSecureToNonSecureRedirect	For 24
	Define DODownloadProperty_NonVolatile					For 25
	Define DODownloadProperty_HttpRedirectionTarget			For 26
	Define DODownloadProperty_HttpResponseHeaders			For 27
	Define DODownloadProperty_HttpServerIPAddress			For 28
	Define DODownloadProperty_HttpStatusCode				For 29
End_Enum_List


Procedure DataFlex_Init
End_Procedure

