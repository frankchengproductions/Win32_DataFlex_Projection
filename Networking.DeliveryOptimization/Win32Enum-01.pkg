Use UI

// Define DODownloadState For Integer
Enum_List
	Define DODownloadState_Created							For |CI$00000000
	Define DODownloadState_Transferring						For |CI$00000001
	Define DODownloadState_Transferred						For |CI$00000002
	Define DODownloadState_Finalized						For |CI$00000003
	Define DODownloadState_Aborted							For |CI$00000004
	Define DODownloadState_Paused							For |CI$00000005
End_Enum_List

// Define DODownloadCostPolicy For Integer
Enum_List
	Define DODownloadCostPolicy_Always						For |CI$00000000
	Define DODownloadCostPolicy_Unrestricted				For |CI$00000001
	Define DODownloadCostPolicy_Standard					For |CI$00000002
	Define DODownloadCostPolicy_NoRoaming					For |CI$00000003
	Define DODownloadCostPolicy_NoSurcharge					For |CI$00000004
	Define DODownloadCostPolicy_NoCellular					For |CI$00000005
End_Enum_List

// Define DODownloadProperty For Integer
Enum_List
	Define DODownloadProperty_Id							For |CI$00000000
	Define DODownloadProperty_Uri							For |CI$00000001
	Define DODownloadProperty_ContentId						For |CI$00000002
	Define DODownloadProperty_DisplayName					For |CI$00000003
	Define DODownloadProperty_LocalPath						For |CI$00000004
	Define DODownloadProperty_HttpCustomHeaders				For |CI$00000005
	Define DODownloadProperty_CostPolicy					For |CI$00000006
	Define DODownloadProperty_SecurityFlags					For |CI$00000007
	Define DODownloadProperty_CallbackFreqPercent			For |CI$00000008
	Define DODownloadProperty_CallbackFreqSeconds			For |CI$00000009
	Define DODownloadProperty_NoProgressTimeoutSeconds		For |CI$0000000A
	Define DODownloadProperty_ForegroundPriority			For |CI$0000000B
	Define DODownloadProperty_BlockingMode					For |CI$0000000C
	Define DODownloadProperty_CallbackInterface				For |CI$0000000D
	Define DODownloadProperty_StreamInterface				For |CI$0000000E
	Define DODownloadProperty_SecurityContext				For |CI$0000000F
	Define DODownloadProperty_NetworkToken					For |CI$00000010
	Define DODownloadProperty_CorrelationVector				For |CI$00000011
	Define DODownloadProperty_DecryptionInfo				For |CI$00000012
	Define DODownloadProperty_IntegrityCheckInfo			For |CI$00000013
	Define DODownloadProperty_IntegrityCheckMandatory		For |CI$00000014
	Define DODownloadProperty_TotalSizeBytes				For |CI$00000015
	Define DODownloadProperty_DisallowOnCellular			For |CI$00000016
	Define DODownloadProperty_HttpCustomAuthHeaders			For |CI$00000017
	Define DODownloadProperty_HttpAllowSecureToNonSecureRedirect	For |CI$00000018
	Define DODownloadProperty_NonVolatile					For |CI$00000019
	Define DODownloadProperty_HttpRedirectionTarget			For |CI$0000001A
	Define DODownloadProperty_HttpResponseHeaders			For |CI$0000001B
	Define DODownloadProperty_HttpServerIPAddress			For |CI$0000001C
	Define DODownloadProperty_HttpStatusCode				For |CI$0000001D
End_Enum_List


Procedure DataFlex_Init
End_Procedure

