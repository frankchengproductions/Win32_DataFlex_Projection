Use UI

// https://learn.microsoft.com/windows/win32/api/ntdef/ns-ntdef-list_entry
Struct LIST_ENTRY
	Pointer Flink											// LIST_ENTRY*
	Pointer Blink											// LIST_ENTRY*
End_Struct

// https://learn.microsoft.com/windows/win32/api/winnt/ns-winnt-processor_number
Struct PROCESSOR_NUMBER
	UShort Group
	UChar Number
	UChar Reserved
End_Struct

// https://learn.microsoft.com/windows/win32/api/winnt/ns-winnt-slist_entry
Struct SLIST_ENTRY
	Pointer Next											// SLIST_ENTRY*
End_Struct

Struct SLIST_HEADER
	UChar[8] UnionName1
	UChar[8] UnionName2
End_Struct

// https://learn.microsoft.com/windows/win32/api/ntdef/ns-ntdef-string
Struct STRING
	UShort Length
	UShort MaximumLength
	Integer iMissingAlignment1
	Pointer Buffer											// PSTR
End_Struct


Procedure DataFlex_Init
End_Procedure

