	Define NotificationEvent								For |CI$00000000
	Define SynchronizationEvent								For |CI$00000001
End_Enum_List

// Define TIMER_TYPE For Integer
Enum_List
	Define NotificationTimer								For |CI$00000000
	Define SynchronizationTimer								For |CI$00000001
End_Enum_List

// Define WAIT_TYPE For Integer
Enum_List
	Define WaitAll											For |CI$00000000
	Define WaitAny											For |CI$00000001
	Define WaitNotification									For |CI$00000002
	Define WaitDequeue										For |CI$00000003
	Define WaitDpc											For |CI$00000004
