Use UI

// Define EXCEPTION_DISPOSITION For Integer
Enum_List
	Define ExceptionContinueExecution						For 0
	Define ExceptionContinueSearch							For 1
	Define ExceptionNestedException							For 2
	Define ExceptionCollidedUnwind							For 3
End_Enum_List

// Define EVENT_TYPE For Integer
Enum_List
	Define NotificationEvent								For 0
	Define SynchronizationEvent								For 1
End_Enum_List

// Define TIMER_TYPE For Integer
Enum_List
	Define NotificationTimer								For 0
	Define SynchronizationTimer								For 1
End_Enum_List

// Define WAIT_TYPE For Integer
Enum_List
	Define WaitAll											For 0
	Define WaitAny											For 1
	Define WaitNotification									For 2
	Define WaitDequeue										For 3
	Define WaitDpc											For 4
End_Enum_List

// Define NT_PRODUCT_TYPE For Integer
Enum_List
	Define NtProductWinNt									For 1
	Define NtProductLanManNt								For 2
	Define NtProductServer									For 3
End_Enum_List

// Define SUITE_TYPE For Integer
Enum_List
	Define SmallBusiness									For 0
	Define Enterprise										For 1
	Define BackOffice										For 2
	Define CommunicationServer								For 3
	Define TerminalServer									For 4
	Define SmallBusinessRestricted							For 5
	Define EmbeddedNT										For 6
	Define DataCenter										For 7
	Define SingleUserTS										For 8
	Define Personal											For 9
	Define Blade											For 10
	Define EmbeddedRestricted								For 11
	Define SecurityAppliance								For 12
	Define StorageServer									For 13
	Define ComputeServer									For 14
	Define WHServer											For 15
	Define PhoneNT											For 16
	Define MultiUserTS										For 17
	Define MaxSuiteType										For 18
End_Enum_List

// Define COMPARTMENT_ID For Integer
Enum_List
	Define UNSPECIFIED_COMPARTMENT_ID						For 0
	Define DEFAULT_COMPARTMENT_ID							For 1
End_Enum_List


Procedure DataFlex_Init
End_Procedure

