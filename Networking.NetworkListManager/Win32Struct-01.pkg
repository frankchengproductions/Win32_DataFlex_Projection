Use UI

// https://learn.microsoft.com/windows/win32/api/netlistmgr/ns-netlistmgr-nlm_dataplan_status
Struct NLM_DATAPLAN_STATUS
	Guid InterfaceGuid
	NLM_USAGE_DATA UsageData
	UInteger DataLimitInMegabytes
	UInteger InboundBandwidthInKbps
	UInteger OutboundBandwidthInKbps
	FILETIME NextBillingCycle
	UInteger MaxTransferSizeInMegabytes
	UInteger Reserved
End_Struct

// https://learn.microsoft.com/windows/win32/api/netlistmgr/ns-netlistmgr-nlm_simulated_profile_info
Struct NLM_SIMULATED_PROFILE_INFO
	UShort[256] ProfileName
	Integer cost											// NLM_CONNECTION_COST
	UInteger UsageInMegabytes
	UInteger DataLimitInMegabytes
End_Struct

// https://learn.microsoft.com/windows/win32/api/netlistmgr/ns-netlistmgr-nlm_sockaddr
Struct NLM_SOCKADDR
	UChar[128] data
End_Struct

// https://learn.microsoft.com/windows/win32/api/netlistmgr/ns-netlistmgr-nlm_usage_data
Struct NLM_USAGE_DATA
	UInteger UsageInMegabytes
	FILETIME LastSyncTime
End_Struct


Procedure DataFlex_Init
End_Procedure
