Use UI

// https://learn.microsoft.com/windows/win32/api/ddeml/ns-ddeml-convcontext
Struct CONVCONTEXT
	UInteger cb
	UInteger wFlags
	UInteger wCountryID
	Integer iCodePage
	UInteger dwLangID
	UInteger dwSecurity
	SECURITY_QUALITY_OF_SERVICE qos
End_Struct

// https://learn.microsoft.com/windows/win32/api/ddeml/ns-ddeml-convinfo
Struct CONVINFO
	UInteger cb
	Integer iMissingAlignment1
	ULongPtr hUser
	Pointer hConvPartner									// HCONV
	Pointer hszSvcPartner									// HSZ
	Pointer hszServiceReq									// HSZ
	Pointer hszTopic										// HSZ
	Pointer hszItem											// HSZ
	UInteger wFmt
	UInteger wType											// DDE_CLIENT_TRANSACTION_TYPE
	UInteger wStatus										// CONVINFO_STATUS
	UInteger wConvst										// CONVINFO_CONVERSATION_STATE
	UInteger wLastError
	Integer iMissingAlignment2
	Pointer hConvList										// HCONVLIST
	CONVCONTEXT ConvCtxt
	Integer iMissingAlignment3
	Pointer hwnd											// HWND
	Pointer hwndPartner										// HWND
End_Struct

// https://learn.microsoft.com/windows/win32/api/wingdi/ns-wingdi-metafilepict
Struct METAFILEPICT
	Integer mm
	Integer xExt
	Integer yExt
	Integer iMissingAlignment1
	Pointer hMF												// HMETAFILE
End_Struct


