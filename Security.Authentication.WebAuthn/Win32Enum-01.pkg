Use UI

// Define AUTHENTICATOR_STATE For Integer
Enum_List
	Define AuthenticatorState_Disabled						For 0
	Define AuthenticatorState_Enabled						For 1
End_Enum_List

// Define EXPERIMENTAL_PLUGIN_AUTHENTICATOR_STATE For Integer
Enum_List
	Define PluginAuthenticatorState_Unknown					For 0
	Define PluginAuthenticatorState_Disabled				For 1
	Define PluginAuthenticatorState_Enabled					For 2
End_Enum_List

// Define EXPERIMENTAL_WEBAUTHN_PLUGIN_PERFORM_UV_OPERATION_TYPE For Integer
Enum_List
	Define PerformUv										For 1
	Define GetUvCount										For 2
	Define GetPubKey										For 3
End_Enum_List

// Define WEBAUTHN_PLUGIN_PERFORM_UV_OPERATION_TYPE For Integer
Enum_List
	Define PerformUserVerification							For 1
	Define GetUserVerificationCount							For 2
	Define GetPublicKey										For 3
End_Enum_List

// Define WEBAUTHN_PLUGIN_REQUEST_TYPE For Integer
Enum_List
	Define WEBAUTHN_PLUGIN_REQUEST_TYPE_CTAP2_CBOR			For 1
End_Enum_List

// Define PLUGIN_LOCK_STATUS For Integer
Enum_List
	Define PluginLocked										For 0
	Define PluginUnlocked									For 1
End_Enum_List


Procedure DataFlex_Init
End_Procedure

