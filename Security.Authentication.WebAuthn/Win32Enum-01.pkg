Use UI

// Define AUTHENTICATOR_STATE For Integer
Enum_List
	Define AuthenticatorState_Disabled						For |CI$00000000
	Define AuthenticatorState_Enabled						For |CI$00000001
End_Enum_List

// Define EXPERIMENTAL_PLUGIN_AUTHENTICATOR_STATE For Integer
Enum_List
	Define PluginAuthenticatorState_Unknown					For |CI$00000000
	Define PluginAuthenticatorState_Disabled				For |CI$00000001
	Define PluginAuthenticatorState_Enabled					For |CI$00000002
End_Enum_List

// Define EXPERIMENTAL_WEBAUTHN_PLUGIN_PERFORM_UV_OPERATION_TYPE For Integer
Enum_List
	Define PerformUv										For |CI$00000001
	Define GetUvCount										For |CI$00000002
	Define GetPubKey										For |CI$00000003
End_Enum_List

// Define WEBAUTHN_PLUGIN_PERFORM_UV_OPERATION_TYPE For Integer
Enum_List
	Define PerformUserVerification							For |CI$00000001
	Define GetUserVerificationCount							For |CI$00000002
	Define GetPublicKey										For |CI$00000003
End_Enum_List

// Define WEBAUTHN_PLUGIN_REQUEST_TYPE For Integer
Enum_List
	Define WEBAUTHN_PLUGIN_REQUEST_TYPE_CTAP2_CBOR			For |CI$00000001
End_Enum_List

// Define PLUGIN_LOCK_STATUS For Integer
Enum_List
	Define PluginLocked										For |CI$00000000
	Define PluginUnlocked									For |CI$00000001
End_Enum_List


Procedure DataFlex_Init
End_Procedure

