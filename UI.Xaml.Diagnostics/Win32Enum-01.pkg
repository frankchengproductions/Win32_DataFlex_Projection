Use UI

// Define VisualMutationType For Integer
Enum_List
	Define Add												For 0
	Define Remove											For 1
End_Enum_List

// Define BaseValueSource For Integer
Enum_List
	Define BaseValueSourceUnknown							For 0
	Define BaseValueSourceDefault							For 1
	Define BaseValueSourceBuiltInStyle						For 2
	Define BaseValueSourceStyle								For 3
	Define BaseValueSourceLocal								For 4
	Define Inherited										For 5
	Define DefaultStyleTrigger								For 6
	Define TemplateTrigger									For 7
	Define StyleTrigger										For 8
	Define ImplicitStyleReference							For 9
	Define ParentTemplate									For 10
	Define ParentTemplateTrigger							For 11
	Define Animation										For 12
	Define Coercion											For 13
	Define BaseValueSourceVisualState						For 14
End_Enum_List

// Define MetadataBit For Integer
Enum_List
	Define MetadataBit_None									For 0
	Define IsValueHandle									For 1
	Define IsPropertyReadOnly								For 2
	Define IsValueCollection								For 4
	Define IsValueCollectionReadOnly						For 8
	Define IsValueBindingExpression							For 16
	Define IsValueNull										For 32
	Define IsValueHandleAndEvaluatedValue					For 64
End_Enum_List

// Define RenderTargetBitmapOptions For Integer
Enum_List
	Define RenderTarget										For 0
	Define RenderTargetAndChildren							For 1
End_Enum_List

// Define ResourceType For Integer
Enum_List
	Define ResourceTypeStatic								For 0
	Define ResourceTypeTheme								For 1
End_Enum_List

// Define VisualElementState For Integer
Enum_List
	Define ErrorResolved									For 0
	Define ErrorResourceNotFound							For 1
	Define ErrorInvalidResource								For 2
End_Enum_List


Procedure DataFlex_Init
End_Procedure

