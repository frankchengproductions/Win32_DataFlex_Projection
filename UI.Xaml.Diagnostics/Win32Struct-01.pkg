Use UI

// https://learn.microsoft.com/windows/win32/api/xamlom/ns-xamlom-bitmapdescription
Struct BitmapDescription
	UInteger Width
	UInteger Height
	Integer Format											// DXGI_FORMAT
	Integer AlphaMode										// DXGI_ALPHA_MODE
End_Struct

// https://learn.microsoft.com/windows/win32/api/xamlom/ns-xamlom-collectionelementvalue
Struct CollectionElementValue
	UInteger Index
	Integer iMissingAlignment1
	Pointer ValueType										// BSTR
	Pointer Value											// BSTR
	Bigint MetadataBits
End_Struct

// https://learn.microsoft.com/windows/win32/api/xamlom/ns-xamlom-enumtype
Struct EnumType
	Pointer Name											// BSTR
	Pointer ValueInts										// SAFEARRAY*
	Pointer ValueStrings									// SAFEARRAY*
End_Struct

// https://learn.microsoft.com/windows/win32/api/xamlom/ns-xamlom-parentchildrelation
Struct ParentChildRelation
	UBigint Parent
	UBigint Child
	UInteger ChildIndex
	Integer iMissingAlignment1
End_Struct

// https://learn.microsoft.com/windows/win32/api/xamlom/ns-xamlom-propertychainsource
Struct PropertyChainSource
	UBigint Handle
	Pointer TargetType										// BSTR
	Pointer Name											// BSTR
	Integer Source											// BaseValueSource
	Integer iMissingAlignment1
	SourceInfo SrcInfo
End_Struct

// https://learn.microsoft.com/windows/win32/api/xamlom/ns-xamlom-propertychainvalue
Struct PropertyChainValue
	UInteger Index
	Integer iMissingAlignment1
	Pointer Type											// BSTR
	Pointer DeclaringType									// BSTR
	Pointer ValueType										// BSTR
	Pointer ItemType										// BSTR
	Pointer Value											// BSTR
	Integer Overridden										// BOOL
	Integer iMissingAlignment2
	Bigint MetadataBits
	Pointer PropertyName									// BSTR
	UInteger PropertyChainIndex
	Integer iMissingAlignment3
End_Struct

// https://learn.microsoft.com/windows/win32/api/xamlom/ns-xamlom-sourceinfo
Struct SourceInfo
	Pointer FileName										// BSTR
	UInteger LineNumber
	UInteger ColumnNumber
	UInteger CharPosition
	Integer iMissingAlignment1
	Pointer Hash											// BSTR
End_Struct

// https://learn.microsoft.com/windows/win32/api/xamlom/ns-xamlom-visualelement
Struct VisualElement
	UBigint Handle
	SourceInfo SrcInfo
	Pointer Type											// BSTR
	Pointer Name											// BSTR
	UInteger NumChildren
	Integer iMissingAlignment1
End_Struct


