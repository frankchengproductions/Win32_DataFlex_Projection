Use UI

// https://learn.microsoft.com/windows/win32/api/winuser/ns-winuser-hardwareinput
Struct HARDWAREINPUT
	UInteger uMsg
	UShort wParamL
	UShort wParamH
End_Struct

// https://learn.microsoft.com/windows/win32/api/winuser/ns-winuser-input
Struct INPUT
	UInteger type											// INPUT_TYPE
	Integer iMissingAlignment1
	UChar[32] UnionName1
End_Struct

// https://learn.microsoft.com/windows/win32/api/winuser/ns-winuser-keybdinput
Struct KEYBDINPUT
	UShort wVk												// VIRTUAL_KEY
	UShort wScan
	UInteger dwFlags										// KEYBD_EVENT_FLAGS
	UInteger time
	Integer iMissingAlignment1
	ULongPtr dwExtraInfo
End_Struct

// https://learn.microsoft.com/windows/win32/api/winuser/ns-winuser-lastinputinfo
Struct LASTINPUTINFO
	UInteger cbSize
	UInteger dwTime
End_Struct

// https://learn.microsoft.com/windows/win32/api/winuser/ns-winuser-mouseinput
Struct MOUSEINPUT
	Integer dx
	Integer dy
	UInteger mouseData
	UInteger dwFlags										// MOUSE_EVENT_FLAGS
	UInteger time
	Integer iMissingAlignment1
	ULongPtr dwExtraInfo
End_Struct

// https://learn.microsoft.com/windows/win32/api/winuser/ns-winuser-mousemovepoint
Struct MOUSEMOVEPOINT
	Integer x
	Integer y
	UInteger time
	Integer iMissingAlignment1
	ULongPtr dwExtraInfo
End_Struct

// https://learn.microsoft.com/windows/win32/api/winuser/ns-winuser-trackmouseevent
Struct TRACKMOUSEEVENT
	UInteger cbSize
	UInteger dwFlags										// TRACKMOUSEEVENT_FLAGS
	Pointer hwndTrack										// HWND
	UInteger dwHoverTime
	Integer iMissingAlignment1
End_Struct


Procedure DataFlex_Init
End_Procedure

