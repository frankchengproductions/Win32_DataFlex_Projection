Use UI

// Define DXC_CP For UInteger
Enum_List
	Define DXC_CP_ACP										For |CI$00000000
	Define DXC_CP_UTF16										For |CI$000004B0
	Define DXC_CP_WIDE										For |CI$000004B0
	Define DXC_CP_UTF32										For |CI$00002EE0
	Define DXC_CP_UTF8										For |CI$0000FDE9
End_Enum_List

// Define DXC_OUT_KIND For Integer
Enum_List
	Define DXC_OUT_NONE										For |CI$00000000
	Define DXC_OUT_OBJECT									For |CI$00000001
	Define DXC_OUT_ERRORS									For |CI$00000002
	Define DXC_OUT_PDB										For |CI$00000003
	Define DXC_OUT_SHADER_HASH								For |CI$00000004
	Define DXC_OUT_DISASSEMBLY								For |CI$00000005
	Define DXC_OUT_HLSL										For |CI$00000006
	Define DXC_OUT_TEXT										For |CI$00000007
	Define DXC_OUT_REFLECTION								For |CI$00000008
	Define DXC_OUT_ROOT_SIGNATURE							For |CI$00000009
	Define DXC_OUT_EXTRA_OUTPUTS							For |CI$0000000A
	Define DXC_OUT_REMARKS									For |CI$0000000B
	Define DXC_OUT_TIME_REPORT								For |CI$0000000C
	Define DXC_OUT_TIME_TRACE								For |CI$0000000D
	Define DXC_OUT_LAST										For |CI$0000000D
	Define DXC_OUT_NUM_ENUMS								For |CI$0000000E
End_Enum_List


Procedure DataFlex_Init
End_Procedure

