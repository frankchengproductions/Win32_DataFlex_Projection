Use UI

// Define RESTOREPOINTINFO_TYPE For UInteger
Enum_List
	Define APPLICATION_INSTALL								For |CI$00000000
	Define APPLICATION_UNINSTALL							For |CI$00000001
	Define DEVICE_DRIVER_INSTALL							For |CI$0000000A
	Define MODIFY_SETTINGS									For |CI$0000000C
	Define CANCELLED_OPERATION								For |CI$0000000D
End_Enum_List

// Define RESTOREPOINTINFO_EVENT_TYPE For UInteger
Enum_List
	Define BEGIN_SYSTEM_CHANGE								For |CI$00000064
	Define END_SYSTEM_CHANGE								For |CI$00000065
	Define BEGIN_NESTED_SYSTEM_CHANGE						For |CI$00000066
	Define END_NESTED_SYSTEM_CHANGE							For |CI$00000067
End_Enum_List


Procedure DataFlex_Init
End_Procedure

