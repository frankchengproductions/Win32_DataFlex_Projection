Use UI

// Define SECURE_ELEMENT_TYPE For Integer
Enum_List
	Define Integrated										For |CI$00000000
	Define External											For |CI$00000001
	Define DeviceHost										For |CI$00000002
End_Enum_List

// Define SECURE_ELEMENT_EVENT_TYPE For Integer
Enum_List
	Define ExternalReaderArrival							For |CI$00000000
	Define ExternalReaderDeparture							For |CI$00000001
	Define ApplicationSelected								For |CI$00000002
	Define Transaction										For |CI$00000003
	Define HceActivated										For |CI$00000004
	Define HceDeactivated									For |CI$00000005
	Define ExternalFieldEnter								For |CI$00000006
	Define ExternalFieldExit								For |CI$00000007
End_Enum_List

// Define SECURE_ELEMENT_CARD_EMULATION_MODE For Integer
Enum_List
	Define EmulationOff										For |CI$00000000
	Define EmulationOnPowerIndependent						For |CI$00000001
	Define EmulationOnPowerDependent						For |CI$00000002
	Define EmulationStealthListen							For |CI$00000003
End_Enum_List

// Define SECURE_ELEMENT_ROUTING_TYPE For Integer
Enum_List
	Define RoutingTypeTech									For |CI$00000000
	Define RoutingTypeProtocol								For |CI$00000001
	Define RoutingTypeAid									For |CI$00000002
End_Enum_List

// Define SECURE_ELEMENT_POWER_MODE For Integer
Enum_List
	Define SEPowerMode_ForceOn								For |CI$00000000
	Define SEPowerMode_AllowOff								For |CI$00000001
End_Enum_List

// Define NFC_RF_DISCOVERY_MODE For Integer
Enum_List
	Define RfDiscoveryConfig								For |CI$00000000
	Define RfDiscoveryStart									For |CI$00000001
	Define RFDiscoveryResume								For |CI$00000002
End_Enum_List

// Define NFC_P2P_MODE For Integer
Enum_List
	Define NfcDepDefault									For |CI$00000000
	Define NfcDepPoll										For |CI$00000001
	Define NfcDepListen										For |CI$00000002
End_Enum_List

// Define NFC_DEVICE_TYPE For Integer
Enum_List
	Define NfcType1Tag										For |CI$00000000
	Define NfcType2Tag										For |CI$00000001
	Define NfcType3Tag										For |CI$00000002
	Define NfcType4Tag										For |CI$00000003
	Define NfcIP1Target										For |CI$00000004
	Define NfcIP1Initiator									For |CI$00000005
	Define NfcReader										For |CI$00000006
End_Enum_List

// Define NFC_RELEASE_TYPE For Integer
Enum_List
	Define IdleMode											For |CI$00000000
	Define SleepMode										For |CI$00000001
	Define Discovery										For |CI$00000002
End_Enum_List

// Define NFC_LLCP_SOCKET_TYPE For Integer
Enum_List
	Define ConnectionOriented								For |CI$00000000
	Define Connectionless									For |CI$00000001
End_Enum_List

// Define NFC_LLCP_LINK_STATUS For Integer
Enum_List
	Define LinkActivated									For |CI$00000000
	Define LinkDeactivated									For |CI$00000001
End_Enum_List

// Define NFC_LLCP_SOCKET_CONNECT_TYPE For Integer
Enum_List
	Define NfcConnectBySap									For |CI$00000000
	Define NfcConnectByUri									For |CI$00000001
End_Enum_List

// Define NFC_LLCP_SOCKET_ERROR For Integer
Enum_List
	Define NfcLlcpErrorDisconnected							For |CI$00000000
	Define NfcLlcpErrorFrameRejected						For |CI$00000001
	Define NfcLlcpErrorBusyCondition						For |CI$00000002
	Define NfcLlcpErrorNotBusyCondition						For |CI$00000003
End_Enum_List

// Define NFC_SNEP_SERVER_TYPE For Integer
Enum_List
	Define DefaultSnepServer								For |CI$00000000
	Define ExtendedSnepServer								For |CI$00000001
End_Enum_List

// Define NFC_SNEP_REQUEST_TYPE For Integer
Enum_List
	Define SnepRequestGet									For |CI$00000000
	Define SnepRequestPut									For |CI$00000001
End_Enum_List

// Define NFC_SE_EMULATION_MODE For Integer
Enum_List
	Define EmulationDisabled								For |CI$00000000
	Define EmulationEnabled									For |CI$00000001
End_Enum_List


Procedure DataFlex_Init
End_Procedure

