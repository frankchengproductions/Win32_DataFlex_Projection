Use UI

// Define SECURE_ELEMENT_TYPE For Integer
Enum_List
	Define Integrated										For 0
	Define External											For 1
	Define DeviceHost										For 2
End_Enum_List

// Define SECURE_ELEMENT_EVENT_TYPE For Integer
Enum_List
	Define ExternalReaderArrival							For 0
	Define ExternalReaderDeparture							For 1
	Define ApplicationSelected								For 2
	Define Transaction										For 3
	Define HceActivated										For 4
	Define HceDeactivated									For 5
	Define ExternalFieldEnter								For 6
	Define ExternalFieldExit								For 7
End_Enum_List

// Define SECURE_ELEMENT_CARD_EMULATION_MODE For Integer
Enum_List
	Define EmulationOff										For 0
	Define EmulationOnPowerIndependent						For 1
	Define EmulationOnPowerDependent						For 2
	Define EmulationStealthListen							For 3
End_Enum_List

// Define SECURE_ELEMENT_ROUTING_TYPE For Integer
Enum_List
	Define RoutingTypeTech									For 0
	Define RoutingTypeProtocol								For 1
	Define RoutingTypeAid									For 2
End_Enum_List

// Define SECURE_ELEMENT_POWER_MODE For Integer
Enum_List
	Define SEPowerMode_ForceOn								For 0
	Define SEPowerMode_AllowOff								For 1
End_Enum_List

// Define NFC_RF_DISCOVERY_MODE For Integer
Enum_List
	Define RfDiscoveryConfig								For 0
	Define RfDiscoveryStart									For 1
	Define RFDiscoveryResume								For 2
End_Enum_List

// Define NFC_P2P_MODE For Integer
Enum_List
	Define NfcDepDefault									For 0
	Define NfcDepPoll										For 1
	Define NfcDepListen										For 2
End_Enum_List

// Define NFC_DEVICE_TYPE For Integer
Enum_List
	Define NfcType1Tag										For 0
	Define NfcType2Tag										For 1
	Define NfcType3Tag										For 2
	Define NfcType4Tag										For 3
	Define NfcIP1Target										For 4
	Define NfcIP1Initiator									For 5
	Define NfcReader										For 6
End_Enum_List

// Define NFC_RELEASE_TYPE For Integer
Enum_List
	Define IdleMode											For 0
	Define SleepMode										For 1
	Define Discovery										For 2
End_Enum_List

// Define NFC_LLCP_SOCKET_TYPE For Integer
Enum_List
	Define ConnectionOriented								For 0
	Define Connectionless									For 1
End_Enum_List

// Define NFC_LLCP_LINK_STATUS For Integer
Enum_List
	Define LinkActivated									For 0
	Define LinkDeactivated									For 1
End_Enum_List

// Define NFC_LLCP_SOCKET_CONNECT_TYPE For Integer
Enum_List
	Define NfcConnectBySap									For 0
	Define NfcConnectByUri									For 1
End_Enum_List

// Define NFC_LLCP_SOCKET_ERROR For Integer
Enum_List
	Define NfcLlcpErrorDisconnected							For 0
	Define NfcLlcpErrorFrameRejected						For 1
	Define NfcLlcpErrorBusyCondition						For 2
	Define NfcLlcpErrorNotBusyCondition						For 3
End_Enum_List

// Define NFC_SNEP_SERVER_TYPE For Integer
Enum_List
	Define DefaultSnepServer								For 0
	Define ExtendedSnepServer								For 1
End_Enum_List

// Define NFC_SNEP_REQUEST_TYPE For Integer
Enum_List
	Define SnepRequestGet									For 0
	Define SnepRequestPut									For 1
End_Enum_List

// Define NFC_SE_EMULATION_MODE For Integer
Enum_List
	Define EmulationDisabled								For 0
	Define EmulationEnabled									For 1
End_Enum_List


Procedure DataFlex_Init
End_Procedure

