Use UI

// Define WCM_PROPERTY For Integer
Enum_List
	Define wcm_global_property_domain_policy				For |CI$00000000
	Define wcm_global_property_minimize_policy				For |CI$00000001
	Define wcm_global_property_roaming_policy				For |CI$00000002
	Define wcm_global_property_powermanagement_policy		For |CI$00000003
	Define wcm_intf_property_connection_cost				For |CI$00000004
	Define wcm_intf_property_dataplan_status				For |CI$00000005
	Define wcm_intf_property_hotspot_profile				For |CI$00000006
End_Enum_List

// Define WCM_MEDIA_TYPE For Integer
Enum_List
	Define wcm_media_unknown								For |CI$00000000
	Define wcm_media_ethernet								For |CI$00000001
	Define wcm_media_wlan									For |CI$00000002
	Define wcm_media_mbn									For |CI$00000003
	Define wcm_media_invalid								For |CI$00000004
	Define wcm_media_max									For |CI$00000005
End_Enum_List

// Define WCM_CONNECTION_COST For Integer
Enum_List
	Define WCM_CONNECTION_COST_UNKNOWN						For |CI$00000000
	Define WCM_CONNECTION_COST_UNRESTRICTED					For |CI$00000001
	Define WCM_CONNECTION_COST_FIXED						For |CI$00000002
