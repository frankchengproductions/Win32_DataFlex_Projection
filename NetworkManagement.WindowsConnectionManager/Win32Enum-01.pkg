	Define WCM_CONNECTION_COST_OVERDATALIMIT				For |CI$00010000
	Define WCM_CONNECTION_COST_CONGESTED					For |CI$00020000
	Define WCM_CONNECTION_COST_ROAMING						For |CI$00040000
	Define WCM_CONNECTION_COST_APPROACHINGDATALIMIT			For |CI$00080000
End_Enum_List

// Define WCM_CONNECTION_COST_SOURCE For Integer
Enum_List
	Define WCM_CONNECTION_COST_SOURCE_DEFAULT				For |CI$00000000
	Define WCM_CONNECTION_COST_SOURCE_GP					For |CI$00000001
	Define WCM_CONNECTION_COST_SOURCE_USER					For |CI$00000002
	Define WCM_CONNECTION_COST_SOURCE_OPERATOR				For |CI$00000003
