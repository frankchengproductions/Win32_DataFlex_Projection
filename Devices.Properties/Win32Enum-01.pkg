Use UI

// Define DEVPROPTYPE For UInteger
Enum_List
	Define DEVPROP_TYPE_EMPTY								For |CI$00000000
	Define DEVPROP_TYPE_NULL								For |CI$00000001
	Define DEVPROP_TYPE_SBYTE								For |CI$00000002
	Define DEVPROP_TYPE_BYTE								For |CI$00000003
	Define DEVPROP_TYPE_INT16								For |CI$00000004
	Define DEVPROP_TYPE_UINT16								For |CI$00000005
	Define DEVPROP_TYPE_INT32								For |CI$00000006
	Define DEVPROP_TYPE_UINT32								For |CI$00000007
	Define DEVPROP_TYPE_INT64								For |CI$00000008
	Define DEVPROP_TYPE_UINT64								For |CI$00000009
	Define DEVPROP_TYPE_FLOAT								For |CI$0000000A
	Define DEVPROP_TYPE_DOUBLE								For |CI$0000000B
	Define DEVPROP_TYPE_DECIMAL								For |CI$0000000C
	Define DEVPROP_TYPE_GUID								For |CI$0000000D
	Define DEVPROP_TYPE_CURRENCY							For |CI$0000000E
	Define DEVPROP_TYPE_DATE								For |CI$0000000F
	Define DEVPROP_TYPE_FILETIME							For |CI$00000010
	Define DEVPROP_TYPE_BOOLEAN								For |CI$00000011
	Define DEVPROP_TYPE_STRING								For |CI$00000012
	Define DEVPROP_TYPE_SECURITY_DESCRIPTOR					For |CI$00000013
	Define DEVPROP_TYPE_SECURITY_DESCRIPTOR_STRING			For |CI$00000014
	Define DEVPROP_TYPE_DEVPROPKEY							For |CI$00000015
	Define DEVPROP_TYPE_DEVPROPTYPE							For |CI$00000016
	Define DEVPROP_TYPE_ERROR								For |CI$00000017
	Define DEVPROP_TYPE_NTSTATUS							For |CI$00000018
	Define DEVPROP_TYPE_STRING_INDIRECT						For |CI$00000019
	Define DEVPROP_TYPEMOD_ARRAY							For |CI$00001000
	Define DEVPROP_TYPE_BINARY								For |CI$00001003
	Define DEVPROP_TYPEMOD_LIST								For |CI$00002000
	Define DEVPROP_TYPE_STRING_LIST							For |CI$00002012
End_Enum_List

// Define DEVPROPSTORE For Integer
Enum_List
	Define DEVPROP_STORE_SYSTEM								For |CI$00000000
	Define DEVPROP_STORE_USER								For |CI$00000001
End_Enum_List


Procedure DataFlex_Init
