Use UI

// Define XPS_JOB_COMPLETION For Integer
Enum_List
	Define XPS_JOB_IN_PROGRESS								For 0
	Define XPS_JOB_COMPLETED								For 1
	Define XPS_JOB_CANCELLED								For 2
	Define XPS_JOB_FAILED									For 3
End_Enum_List

// Define PrintDocumentPackageCompletion For Integer
Enum_List
	Define PrintDocumentPackageCompletion_InProgress		For 0
	Define PrintDocumentPackageCompletion_Completed			For 1
	Define PrintDocumentPackageCompletion_Canceled			For 2
	Define PrintDocumentPackageCompletion_Failed			For 3
End_Enum_List


Procedure DataFlex_Init
End_Procedure

