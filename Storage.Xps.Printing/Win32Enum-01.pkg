Use UI

// Define XPS_JOB_COMPLETION For Integer
Enum_List
	Define XPS_JOB_IN_PROGRESS								For |CI$00000000
	Define XPS_JOB_COMPLETED								For |CI$00000001
	Define XPS_JOB_CANCELLED								For |CI$00000002
	Define XPS_JOB_FAILED									For |CI$00000003
End_Enum_List

// Define PrintDocumentPackageCompletion For Integer
Enum_List
	Define PrintDocumentPackageCompletion_InProgress		For |CI$00000000
	Define PrintDocumentPackageCompletion_Completed			For |CI$00000001
	Define PrintDocumentPackageCompletion_Canceled			For |CI$00000002
	Define PrintDocumentPackageCompletion_Failed			For |CI$00000003
End_Enum_List


Procedure DataFlex_Init
End_Procedure

