Use UI

// https://learn.microsoft.com/windows/win32/api/documenttarget/ns-documenttarget-printdocumentpackagestatus
Struct PrintDocumentPackageStatus
	UInteger JobId
	Integer CurrentDocument
	Integer CurrentPage
	Integer CurrentPageTotal
	Integer Completion										// PrintDocumentPackageCompletion
	Integer PackageStatus									// HRESULT
End_Struct

// https://learn.microsoft.com/windows/win32/api/xpsprint/ns-xpsprint-xps_job_status
Struct XPS_JOB_STATUS
	UInteger jobId
	Integer currentDocument
	Integer currentPage
	Integer currentPageTotal
	Integer completion										// XPS_JOB_COMPLETION
	Integer jobStatus										// HRESULT
End_Struct


Procedure DataFlex_Init
End_Procedure
