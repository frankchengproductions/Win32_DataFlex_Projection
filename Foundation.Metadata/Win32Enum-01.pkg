Use UI

// Define Architecture For Integer
Enum_List
	Define Architecture_None								For |CI$00000000
	Define X86												For |CI$00000001
	Define X64												For |CI$00000002
	Define Arm64											For |CI$00000004
	Define All												For |CI$00000007
End_Enum_List


Procedure DataFlex_Init
End_Procedure

