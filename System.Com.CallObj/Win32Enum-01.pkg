Use UI

// Define CALLFRAME_COPY For Integer
Enum_List
	Define CALLFRAME_COPY_NESTED							For |CI$00000001
	Define CALLFRAME_COPY_INDEPENDENT						For |CI$00000002
End_Enum_List

// Define CALLFRAME_FREE For Integer
Enum_List
	Define CALLFRAME_FREE_NONE								For |CI$00000000
	Define CALLFRAME_FREE_IN								For |CI$00000001
	Define CALLFRAME_FREE_INOUT								For |CI$00000002
	Define CALLFRAME_FREE_OUT								For |CI$00000004
	Define CALLFRAME_FREE_TOP_INOUT							For |CI$00000008
	Define CALLFRAME_FREE_TOP_OUT							For |CI$00000010
	Define CALLFRAME_FREE_ALL								For |CI$0000001F
End_Enum_List

// Define CALLFRAME_NULL For Integer
Enum_List
	Define CALLFRAME_NULL_NONE								For |CI$00000000
	Define CALLFRAME_NULL_INOUT								For |CI$00000002
	Define CALLFRAME_NULL_OUT								For |CI$00000004
	Define CALLFRAME_NULL_ALL								For |CI$00000006
End_Enum_List

// Define CALLFRAME_WALK For Integer
Enum_List
	Define CALLFRAME_WALK_IN								For |CI$00000001
	Define CALLFRAME_WALK_INOUT								For |CI$00000002
	Define CALLFRAME_WALK_OUT								For |CI$00000004
End_Enum_List


Procedure DataFlex_Init
End_Procedure

