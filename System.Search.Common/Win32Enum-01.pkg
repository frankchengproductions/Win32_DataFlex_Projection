Use UI

// Define CONDITION_TYPE For Integer
Enum_List
	Define CT_AND_CONDITION									For |CI$00000000
	Define CT_OR_CONDITION									For |CI$00000001
	Define CT_NOT_CONDITION									For |CI$00000002
	Define CT_LEAF_CONDITION								For |CI$00000003
End_Enum_List

// Define CONDITION_OPERATION For Integer
Enum_List
	Define COP_IMPLICIT										For |CI$00000000
	Define COP_EQUAL										For |CI$00000001
	Define COP_NOTEQUAL										For |CI$00000002
	Define COP_LESSTHAN										For |CI$00000003
	Define COP_GREATERTHAN									For |CI$00000004
	Define COP_LESSTHANOREQUAL								For |CI$00000005
	Define COP_GREATERTHANOREQUAL							For |CI$00000006
	Define COP_VALUE_STARTSWITH								For |CI$00000007
	Define COP_VALUE_ENDSWITH								For |CI$00000008
	Define COP_VALUE_CONTAINS								For |CI$00000009
	Define COP_VALUE_NOTCONTAINS							For |CI$0000000A
	Define COP_DOSWILDCARDS									For |CI$0000000B
	Define COP_WORD_EQUAL									For |CI$0000000C
	Define COP_WORD_STARTSWITH								For |CI$0000000D
	Define COP_APPLICATION_SPECIFIC							For |CI$0000000E
End_Enum_List


Procedure DataFlex_Init
End_Procedure

