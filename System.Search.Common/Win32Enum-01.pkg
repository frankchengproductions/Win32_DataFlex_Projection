Use UI

// Define CONDITION_TYPE For Integer
Enum_List
	Define CT_AND_CONDITION									For 0
	Define CT_OR_CONDITION									For 1
	Define CT_NOT_CONDITION									For 2
	Define CT_LEAF_CONDITION								For 3
End_Enum_List

// Define CONDITION_OPERATION For Integer
Enum_List
	Define COP_IMPLICIT										For 0
	Define COP_EQUAL										For 1
	Define COP_NOTEQUAL										For 2
	Define COP_LESSTHAN										For 3
	Define COP_GREATERTHAN									For 4
	Define COP_LESSTHANOREQUAL								For 5
	Define COP_GREATERTHANOREQUAL							For 6
	Define COP_VALUE_STARTSWITH								For 7
	Define COP_VALUE_ENDSWITH								For 8
	Define COP_VALUE_CONTAINS								For 9
	Define COP_VALUE_NOTCONTAINS							For 10
	Define COP_DOSWILDCARDS									For 11
	Define COP_WORD_EQUAL									For 12
	Define COP_WORD_STARTSWITH								For 13
	Define COP_APPLICATION_SPECIFIC							For 14
End_Enum_List


Procedure DataFlex_Init
End_Procedure

