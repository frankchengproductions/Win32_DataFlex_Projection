	Define SCF_BUTTON_LEFT									For 5
	Define SCF_BUTTON_RIGHT									For 6
	Define SCF_BUTTON_PLAY									For 7
	Define SCF_BUTTON_PAUSE									For 8
	Define SCF_BUTTON_FASTFORWARD							For 9
