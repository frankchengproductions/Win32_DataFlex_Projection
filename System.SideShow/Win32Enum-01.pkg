// Define SCF_EVENT_IDS For Integer
Enum_List
	Define SCF_EVENT_NAVIGATION								For 1
	Define SCF_EVENT_MENUACTION								For 2
	Define SCF_EVENT_CONTEXTMENU							For 3
End_Enum_List

// Define SCF_BUTTON_IDS For Integer
