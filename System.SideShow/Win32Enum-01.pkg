Use UI

// Define SIDESHOW_SCREEN_TYPE For Integer
Enum_List
	Define SIDESHOW_SCREEN_TYPE_BITMAP						For |CI$00000000
	Define SIDESHOW_SCREEN_TYPE_TEXT						For |CI$00000001
End_Enum_List

// Define SIDESHOW_COLOR_TYPE For Integer
Enum_List
	Define SIDESHOW_COLOR_TYPE_COLOR						For |CI$00000000
	Define SIDESHOW_COLOR_TYPE_GREYSCALE					For |CI$00000001
	Define SIDESHOW_COLOR_TYPE_BLACK_AND_WHITE				For |CI$00000002
End_Enum_List

// Define SCF_EVENT_IDS For Integer
Enum_List
	Define SCF_EVENT_NAVIGATION								For |CI$00000001
	Define SCF_EVENT_MENUACTION								For |CI$00000002
	Define SCF_EVENT_CONTEXTMENU							For |CI$00000003
End_Enum_List

// Define SCF_BUTTON_IDS For Integer
Enum_List
	Define SCF_BUTTON_MENU									For |CI$00000001
	Define SCF_BUTTON_SELECT								For |CI$00000002
	Define SCF_BUTTON_UP									For |CI$00000003
	Define SCF_BUTTON_DOWN									For |CI$00000004
	Define SCF_BUTTON_LEFT									For |CI$00000005
	Define SCF_BUTTON_RIGHT									For |CI$00000006
	Define SCF_BUTTON_PLAY									For |CI$00000007
	Define SCF_BUTTON_PAUSE									For |CI$00000008
	Define SCF_BUTTON_FASTFORWARD							For |CI$00000009
	Define SCF_BUTTON_REWIND								For |CI$0000000A
	Define SCF_BUTTON_STOP									For |CI$0000000B
	Define SCF_BUTTON_BACK									For |CI$0000FF00
End_Enum_List


Procedure DataFlex_Init
End_Procedure

