Use UI

// Define FILTER_INFORMATION_CLASS For Integer
Enum_List
	Define FilterFullInformation							For 0
	Define FilterAggregateBasicInformation					For 1
	Define FilterAggregateStandardInformation				For 2
End_Enum_List

// Define FILTER_VOLUME_INFORMATION_CLASS For Integer
Enum_List
	Define FilterVolumeBasicInformation						For 0
	Define FilterVolumeStandardInformation					For 1
End_Enum_List

// Define INSTANCE_INFORMATION_CLASS For Integer
Enum_List
	Define InstanceBasicInformation							For 0
	Define InstancePartialInformation						For 1
	Define InstanceFullInformation							For 2
	Define InstanceAggregateStandardInformation				For 3
End_Enum_List

