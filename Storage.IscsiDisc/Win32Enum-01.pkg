Use UI

// Define TARGET_INFORMATION_CLASS For Integer
Enum_List
	Define ProtocolType										For 0
	Define TargetAlias										For 1
	Define DiscoveryMechanisms								For 2
	Define PortalGroups										For 3
	Define PersistentTargetMappings							For 4
	Define InitiatorName									For 5
	Define TargetFlags										For 6
	Define LoginOptions										For 7
End_Enum_List

// Define ISCSI_AUTH_TYPES For Integer
Enum_List
	Define ISCSI_NO_AUTH_TYPE								For 0
	Define ISCSI_CHAP_AUTH_TYPE								For 1
	Define ISCSI_MUTUAL_CHAP_AUTH_TYPE						For 2
End_Enum_List

// Define ISCSI_DIGEST_TYPES For Integer
Enum_List
	Define ISCSI_DIGEST_TYPE_NONE							For 0
	Define ISCSI_DIGEST_TYPE_CRC32C							For 1
End_Enum_List

// Define IKE_AUTHENTICATION_METHOD For Integer
Enum_List
	Define IKE_AUTHENTICATION_PRESHARED_KEY_METHOD			For 1
End_Enum_List

// Define NV_SEP_WRITE_CACHE_TYPE For Integer
Enum_List
	Define NVSEPWriteCacheTypeUnknown						For 0
	Define NVSEPWriteCacheTypeNone							For 1
	Define NVSEPWriteCacheTypeWriteBack						For 2
	Define NVSEPWriteCacheTypeWriteThrough					For 3
End_Enum_List

// Define MP_STORAGE_DIAGNOSTIC_LEVEL For Integer
Enum_List
	Define MpStorageDiagnosticLevelDefault					For 0
	Define MpStorageDiagnosticLevelMax						For 1
End_Enum_List

// Define MP_STORAGE_DIAGNOSTIC_TARGET_TYPE For Integer
Enum_List
	Define MpStorageDiagnosticTargetTypeUndefined			For 0
	Define MpStorageDiagnosticTargetTypeMiniport			For 2
	Define MpStorageDiagnosticTargetTypeHbaFirmware			For 3
	Define MpStorageDiagnosticTargetTypeMax					For 4
End_Enum_List

// Define NVCACHE_TYPE For Integer
Enum_List
	Define NvCacheTypeUnknown								For 0
	Define NvCacheTypeNone									For 1
	Define NvCacheTypeWriteBack								For 2
	Define NvCacheTypeWriteThrough							For 3
End_Enum_List

// Define NVCACHE_STATUS For Integer
Enum_List
	Define NvCacheStatusUnknown								For 0
	Define NvCacheStatusDisabling							For 1
	Define NvCacheStatusDisabled							For 2
	Define NvCacheStatusEnabled								For 3
End_Enum_List

// Define TARGETPROTOCOLTYPE For Integer
Enum_List
	Define ISCSI_TCP_PROTOCOL_TYPE							For 0
End_Enum_List


Procedure DataFlex_Init
End_Procedure

