Use UI

// Define TARGET_INFORMATION_CLASS For Integer
Enum_List
	Define ProtocolType										For |CI$00000000
	Define TargetAlias										For |CI$00000001
	Define DiscoveryMechanisms								For |CI$00000002
	Define PortalGroups										For |CI$00000003
	Define PersistentTargetMappings							For |CI$00000004
	Define InitiatorName									For |CI$00000005
	Define TargetFlags										For |CI$00000006
	Define LoginOptions										For |CI$00000007
End_Enum_List

// Define ISCSI_AUTH_TYPES For Integer
Enum_List
	Define ISCSI_NO_AUTH_TYPE								For |CI$00000000
	Define ISCSI_CHAP_AUTH_TYPE								For |CI$00000001
	Define ISCSI_MUTUAL_CHAP_AUTH_TYPE						For |CI$00000002
End_Enum_List

// Define ISCSI_DIGEST_TYPES For Integer
Enum_List
	Define ISCSI_DIGEST_TYPE_NONE							For |CI$00000000
	Define ISCSI_DIGEST_TYPE_CRC32C							For |CI$00000001
End_Enum_List

// Define IKE_AUTHENTICATION_METHOD For Integer
Enum_List
	Define IKE_AUTHENTICATION_PRESHARED_KEY_METHOD			For |CI$00000001
End_Enum_List

// Define NV_SEP_WRITE_CACHE_TYPE For Integer
Enum_List
	Define NVSEPWriteCacheTypeUnknown						For |CI$00000000
	Define NVSEPWriteCacheTypeNone							For |CI$00000001
	Define NVSEPWriteCacheTypeWriteBack						For |CI$00000002
	Define NVSEPWriteCacheTypeWriteThrough					For |CI$00000003
End_Enum_List

// Define MP_STORAGE_DIAGNOSTIC_LEVEL For Integer
Enum_List
	Define MpStorageDiagnosticLevelDefault					For |CI$00000000
	Define MpStorageDiagnosticLevelMax						For |CI$00000001
End_Enum_List

// Define MP_STORAGE_DIAGNOSTIC_TARGET_TYPE For Integer
Enum_List
	Define MpStorageDiagnosticTargetTypeUndefined			For |CI$00000000
	Define MpStorageDiagnosticTargetTypeMiniport			For |CI$00000002
	Define MpStorageDiagnosticTargetTypeHbaFirmware			For |CI$00000003
	Define MpStorageDiagnosticTargetTypeMax					For |CI$00000004
End_Enum_List

// Define NVCACHE_TYPE For Integer
Enum_List
	Define NvCacheTypeUnknown								For |CI$00000000
	Define NvCacheTypeNone									For |CI$00000001
	Define NvCacheTypeWriteBack								For |CI$00000002
	Define NvCacheTypeWriteThrough							For |CI$00000003
End_Enum_List

// Define NVCACHE_STATUS For Integer
Enum_List
	Define NvCacheStatusUnknown								For |CI$00000000
	Define NvCacheStatusDisabling							For |CI$00000001
	Define NvCacheStatusDisabled							For |CI$00000002
	Define NvCacheStatusEnabled								For |CI$00000003
End_Enum_List

// Define TARGETPROTOCOLTYPE For Integer
Enum_List
	Define ISCSI_TCP_PROTOCOL_TYPE							For |CI$00000000
End_Enum_List


Procedure DataFlex_Init
End_Procedure

