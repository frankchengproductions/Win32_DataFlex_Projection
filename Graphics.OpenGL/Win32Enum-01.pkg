Use UI

// Define PFD_PIXEL_TYPE For UChar
Enum_List
	Define PFD_TYPE_RGBA									For |CI$00
	Define PFD_TYPE_COLORINDEX								For |CI$01
End_Enum_List

// Define PFD_LAYER_TYPE For Char
Enum_List
	Define PFD_UNDERLAY_PLANE								For -1
	Define PFD_MAIN_PLANE									For |CI$00
	Define PFD_OVERLAY_PLANE								For |CI$01
End_Enum_List

// Define PFD_FLAGS For UInteger
Enum_List
	Define PFD_DOUBLEBUFFER									For |CI$00000001
	Define PFD_STEREO										For |CI$00000002
	Define PFD_DRAW_TO_WINDOW								For |CI$00000004
	Define PFD_DRAW_TO_BITMAP								For |CI$00000008
	Define PFD_SUPPORT_GDI									For |CI$00000010
	Define PFD_SUPPORT_OPENGL								For |CI$00000020
	Define PFD_GENERIC_FORMAT								For |CI$00000040
	Define PFD_NEED_PALETTE									For |CI$00000080
	Define PFD_NEED_SYSTEM_PALETTE							For |CI$00000100
	Define PFD_SWAP_EXCHANGE								For |CI$00000200
	Define PFD_SWAP_COPY									For |CI$00000400
	Define PFD_SWAP_LAYER_BUFFERS							For |CI$00000800
	Define PFD_GENERIC_ACCELERATED							For |CI$00001000
	Define PFD_SUPPORT_DIRECTDRAW							For |CI$00002000
	Define PFD_DIRECT3D_ACCELERATED							For |CI$00004000
	Define PFD_SUPPORT_COMPOSITION							For |CI$00008000
	Define PFD_DEPTH_DONTCARE								For |CI$20000000
	Define PFD_DOUBLEBUFFER_DONTCARE						For |CI$40000000
	Define PFD_STEREO_DONTCARE								For |CV$80000000
End_Enum_List


Procedure DataFlex_Init
End_Procedure

