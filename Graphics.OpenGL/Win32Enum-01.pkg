Use UI

// Define PFD_PIXEL_TYPE For UChar
Enum_List
	Define PFD_TYPE_RGBA									For 0
	Define PFD_TYPE_COLORINDEX								For 1
End_Enum_List

// Define PFD_LAYER_TYPE For Char
Enum_List
	Define PFD_UNDERLAY_PLANE								For -1
	Define PFD_MAIN_PLANE									For 0
	Define PFD_OVERLAY_PLANE								For 1
End_Enum_List

// Define PFD_FLAGS For UInteger
Enum_List
	Define PFD_DOUBLEBUFFER									For 1
	Define PFD_STEREO										For 2
	Define PFD_DRAW_TO_WINDOW								For 4
	Define PFD_DRAW_TO_BITMAP								For 8
	Define PFD_SUPPORT_GDI									For 16
	Define PFD_SUPPORT_OPENGL								For 32
	Define PFD_GENERIC_FORMAT								For 64
	Define PFD_NEED_PALETTE									For 128
	Define PFD_NEED_SYSTEM_PALETTE							For 256
	Define PFD_SWAP_EXCHANGE								For 512
	Define PFD_SWAP_COPY									For 1024
	Define PFD_SWAP_LAYER_BUFFERS							For 2048
	Define PFD_GENERIC_ACCELERATED							For 4096
	Define PFD_SUPPORT_DIRECTDRAW							For 8192
	Define PFD_DIRECT3D_ACCELERATED							For 16384
	Define PFD_SUPPORT_COMPOSITION							For 32768
	Define PFD_DEPTH_DONTCARE								For 536870912
	Define PFD_DOUBLEBUFFER_DONTCARE						For 1073741824
	Define PFD_STEREO_DONTCARE								For 2147483648
End_Enum_List


Procedure DataFlex_Init
End_Procedure

