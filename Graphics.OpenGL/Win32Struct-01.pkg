	UChar iPixelType
	UChar cColorBits
	UChar cRedBits
	UChar cRedShift
	UChar cGreenBits
	UChar cGreenShift
	UChar cBlueBits
	UChar cBlueShift
	UChar cAlphaBits
	UChar cAlphaShift
	UChar cAccumBits
