	UChar cAccumBlueBits
	UChar cAccumAlphaBits
	UChar cDepthBits
	UChar cStencilBits
	UChar cAuxBuffers
	UChar iLayerPlane
	UChar bReserved
	UInteger crTransparent									// COLORREF
End_Struct

