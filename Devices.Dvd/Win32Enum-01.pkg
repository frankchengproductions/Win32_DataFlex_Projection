Use UI

// Define DVD_KEY_TYPE For Integer
Enum_List
	Define DvdChallengeKey									For |CI$00000001
	Define DvdBusKey1										For |CI$00000002
	Define DvdBusKey2										For |CI$00000003
	Define DvdTitleKey										For |CI$00000004
	Define DvdAsf											For |CI$00000005
	Define DvdSetRpcKey										For |CI$00000006
	Define DvdGetRpcKey										For |CI$00000008
	Define DvdInvalidateAGID								For |CI$0000003F
	Define DvdDiskKey										For |CI$00000080
End_Enum_List

// Define DVD_STRUCTURE_FORMAT For Integer
Enum_List
	Define DvdPhysicalDescriptor							For |CI$00000000
	Define DvdCopyrightDescriptor							For |CI$00000001
	Define DvdDiskKeyDescriptor								For |CI$00000002
	Define DvdBCADescriptor									For |CI$00000003
	Define DvdManufacturerDescriptor						For |CI$00000004
	Define DvdMaxDescriptor									For |CI$00000005
End_Enum_List

// Define DISC_CONTROL_BLOCK_TYPE For Integer
Enum_List
	Define DiscControlBlockList								For -1
	Define FormattingDiscControlBlock						For |CI$46444300
	Define SessionInfoDiscControlBlock						For |CI$53444300
	Define WriteInhibitDiscControlBlock						For |CI$57444300
End_Enum_List


Procedure DataFlex_Init
End_Procedure

