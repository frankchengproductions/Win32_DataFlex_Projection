	Define DvdBusKey1										For 2
	Define DvdBusKey2										For 3
	Define DvdTitleKey										For 4
	Define DvdAsf											For 5
	Define DvdSetRpcKey										For 6
	Define DvdGetRpcKey										For 8
	Define DvdDiskKey										For 128
	Define DvdInvalidateAGID								For 63
End_Enum_List

// Define DVD_STRUCTURE_FORMAT For Integer
Enum_List
	Define DvdPhysicalDescriptor							For 0
	Define DvdCopyrightDescriptor							For 1
	Define DvdDiskKeyDescriptor								For 2
	Define DvdBCADescriptor									For 3
	Define DvdManufacturerDescriptor						For 4
	Define DvdMaxDescriptor									For 5
End_Enum_List

// Define DISC_CONTROL_BLOCK_TYPE For Integer
Enum_List
	Define FormattingDiscControlBlock						For 1178878720
	Define WriteInhibitDiscControlBlock						For 1464091392
	Define SessionInfoDiscControlBlock						For 1396982528
