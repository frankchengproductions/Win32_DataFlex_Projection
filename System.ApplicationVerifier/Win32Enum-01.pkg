Use UI

// Define VERIFIER_ENUM_RESOURCE_FLAGS For UInteger
Enum_List
	Define AVRF_ENUM_RESOURCES_FLAGS_DONT_RESOLVE_TRACES	For 2
	Define AVRF_ENUM_RESOURCES_FLAGS_SUSPEND				For 1
End_Enum_List

// Define eUserAllocationState For Integer
Enum_List
	Define AllocationStateUnknown							For 0
	Define AllocationStateBusy								For 1
	Define AllocationStateFree								For 2
End_Enum_List

// Define eHeapAllocationState For Integer
Enum_List
	Define HeapFullPageHeap									For 1073741824
	Define HeapMetadata										For -2147483648
	Define HeapStateMask									For -65536
End_Enum_List

// Define eHeapEnumerationLevel For Integer
Enum_List
	Define HeapEnumerationEverything						For 0
	Define HeapEnumerationStop								For -1
End_Enum_List

// Define eHANDLE_TRACE_OPERATIONS For Integer
Enum_List
	Define OperationDbUnused								For 0
	Define OperationDbOPEN									For 1
	Define OperationDbCLOSE									For 2
	Define OperationDbBADREF								For 3
End_Enum_List

// Define eAvrfResourceTypes For Integer
Enum_List
	Define AvrfResourceHeapAllocation						For 0
	Define AvrfResourceHandleTrace							For 1
	Define AvrfResourceMax									For 2
End_Enum_List


Procedure DataFlex_Init
End_Procedure

