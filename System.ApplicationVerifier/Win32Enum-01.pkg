Use UI

// Define VERIFIER_ENUM_RESOURCE_FLAGS For UInteger
Enum_List
	Define AVRF_ENUM_RESOURCES_FLAGS_SUSPEND				For |CI$00000001
	Define AVRF_ENUM_RESOURCES_FLAGS_DONT_RESOLVE_TRACES	For |CI$00000002
End_Enum_List

// Define eUserAllocationState For Integer
Enum_List
	Define AllocationStateUnknown							For |CI$00000000
	Define AllocationStateBusy								For |CI$00000001
	Define AllocationStateFree								For |CI$00000002
End_Enum_List

// Define eHeapAllocationState For Integer
Enum_List
	Define HeapMetadata										For -2147483648
	Define HeapStateMask									For -65536
	Define HeapFullPageHeap									For |CI$40000000
End_Enum_List

// Define eHeapEnumerationLevel For Integer
Enum_List
	Define HeapEnumerationStop								For -1
	Define HeapEnumerationEverything						For |CI$00000000
End_Enum_List

// Define eHANDLE_TRACE_OPERATIONS For Integer
Enum_List
	Define OperationDbUnused								For |CI$00000000
	Define OperationDbOPEN									For |CI$00000001
	Define OperationDbCLOSE									For |CI$00000002
	Define OperationDbBADREF								For |CI$00000003
End_Enum_List

// Define eAvrfResourceTypes For Integer
Enum_List
	Define AvrfResourceHeapAllocation						For |CI$00000000
	Define AvrfResourceHandleTrace							For |CI$00000001
	Define AvrfResourceMax									For |CI$00000002
End_Enum_List


Procedure DataFlex_Init
End_Procedure

