Use UI

// Define LOAD_LIBRARY_FLAGS For UInteger
Enum_List
	Define DONT_RESOLVE_DLL_REFERENCES						For |CI$00000001
	Define LOAD_LIBRARY_AS_DATAFILE							For |CI$00000002
	Define LOAD_WITH_ALTERED_SEARCH_PATH					For |CI$00000008
	Define LOAD_IGNORE_CODE_AUTHZ_LEVEL						For |CI$00000010
	Define LOAD_LIBRARY_AS_IMAGE_RESOURCE					For |CI$00000020
	Define LOAD_LIBRARY_AS_DATAFILE_EXCLUSIVE				For |CI$00000040
	Define LOAD_LIBRARY_REQUIRE_SIGNED_TARGET				For |CI$00000080
	Define LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR					For |CI$00000100
	Define LOAD_LIBRARY_SEARCH_APPLICATION_DIR				For |CI$00000200
	Define LOAD_LIBRARY_SEARCH_USER_DIRS					For |CI$00000400
	Define LOAD_LIBRARY_SEARCH_SYSTEM32						For |CI$00000800
	Define LOAD_LIBRARY_SEARCH_DEFAULT_DIRS					For |CI$00001000
	Define LOAD_LIBRARY_SAFE_CURRENT_DIRS					For |CI$00002000
	Define LOAD_LIBRARY_SEARCH_SYSTEM32_NO_FORWARDER		For |CI$00004000
End_Enum_List


Procedure DataFlex_Init
End_Procedure

