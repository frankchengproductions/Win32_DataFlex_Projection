Use UI

// Define CREATE_TOOLHELP_SNAPSHOT_FLAGS For UInteger
Enum_List
	Define TH32CS_SNAPHEAPLIST								For |CI$00000001
	Define TH32CS_SNAPPROCESS								For |CI$00000002
	Define TH32CS_SNAPTHREAD								For |CI$00000004
	Define TH32CS_SNAPMODULE								For |CI$00000008
	Define TH32CS_SNAPALL									For |CI$0000000F
	Define TH32CS_SNAPMODULE32								For |CI$00000010
	Define TH32CS_INHERIT									For |CV$80000000
End_Enum_List

// Define HEAPENTRY32_FLAGS For UInteger
Enum_List
	Define LF32_FIXED										For |CI$00000001
	Define LF32_FREE										For |CI$00000002
	Define LF32_MOVEABLE									For |CI$00000004
End_Enum_List


Procedure DataFlex_Init
End_Procedure

