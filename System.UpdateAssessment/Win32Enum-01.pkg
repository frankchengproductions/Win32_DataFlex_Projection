	Define UpdateImpactLevel_Medium							For 2
	Define UpdateImpactLevel_High							For 3
End_Enum_List

// Define UpdateAssessmentStatus For Integer
Enum_List
	Define UpdateAssessmentStatus_Latest					For 0
