Use UI

// Define UpdateImpactLevel For Integer
Enum_List
	Define UpdateImpactLevel_None							For |CI$00000000
	Define UpdateImpactLevel_Low							For |CI$00000001
	Define UpdateImpactLevel_Medium							For |CI$00000002
	Define UpdateImpactLevel_High							For |CI$00000003
End_Enum_List

// Define UpdateAssessmentStatus For Integer
Enum_List
	Define UpdateAssessmentStatus_Latest					For |CI$00000000
	Define UpdateAssessmentStatus_NotLatestSoftRestriction	For |CI$00000001
	Define UpdateAssessmentStatus_NotLatestHardRestriction	For |CI$00000002
	Define UpdateAssessmentStatus_NotLatestEndOfSupport		For |CI$00000003
	Define UpdateAssessmentStatus_NotLatestServicingTrain	For |CI$00000004
	Define UpdateAssessmentStatus_NotLatestDeferredFeature	For |CI$00000005
	Define UpdateAssessmentStatus_NotLatestDeferredQuality	For |CI$00000006
	Define UpdateAssessmentStatus_NotLatestPausedFeature	For |CI$00000007
	Define UpdateAssessmentStatus_NotLatestPausedQuality	For |CI$00000008
	Define UpdateAssessmentStatus_NotLatestManaged			For |CI$00000009
	Define UpdateAssessmentStatus_NotLatestUnknown			For |CI$0000000A
	Define UpdateAssessmentStatus_NotLatestTargetedVersion	For |CI$0000000B
End_Enum_List


Procedure DataFlex_Init
End_Procedure

